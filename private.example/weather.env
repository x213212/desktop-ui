# Copy to ~/.config/desktop-ui/weather.env and keep the real file private.
# Decimal degrees. When set, these coordinates are sent to Open-Meteo over
# HTTPS. Leave them unset to disable the independent lock-screen network fetch;
# GeoClue in the shell remains disabled until explicitly enabled in Settings.
UIOS_WEATHER_LATITUDE=
UIOS_WEATHER_LONGITUDE=
UIOS_WEATHER_CITY=

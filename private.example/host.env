# Copy to ~/.config/desktop-ui/host.env only when stable connector roles are
# needed. Find connector names with: hyprctl monitors -j
# Role 0 owns workspaces 1..10; role 1 owns 11..20 and enables safe two-output
# collapse/expand handling. If every role is empty, runtime monitor IDs are
# used. Once any role is configured, list every active connector: unknown
# connectors intentionally become read-only/fail-closed instead of borrowing
# another output's workspace group.
UIOS_MONITOR_ROLE_0=
UIOS_MONITOR_ROLE_1=
# Optional additional stable output roles. Role N owns workspaces
# N*10+1 through N*10+10. Automatic collapse/expand currently applies to the
# role 0/1 pair; other configured roles retain deterministic routing.
UIOS_MONITOR_ROLE_2=
UIOS_MONITOR_ROLE_3=
UIOS_MONITOR_ROLE_4=
UIOS_MONITOR_ROLE_5=
UIOS_MONITOR_ROLE_6=
UIOS_MONITOR_ROLE_7=
UIOS_MONITOR_ROLE_8=
UIOS_MONITOR_ROLE_9=

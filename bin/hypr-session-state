def eprint(message: str) -> None:
    print(message, file=sys.stderr)


def norm(value: Any) -> str:
    return re.sub(r"[^a-z0-9]", "", str(value or "").lower())


def mkdir_state() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        os.chmod(STATE_DIR, 0o700)
    except OSError:
        pass


class StateLock:
    def __enter__(self) -> "StateLock":
        mkdir_state()
        flags = os.O_RDWR | os.O_CREAT
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        self.fd = os.open(LOCK_FILE, flags, 0o600)
        os.fchmod(self.fd, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_: object) -> None:
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


def workspace_compaction_pending() -> bool:
    """Fail closed for every non-empty or untrusted Lua WAL path."""
    try:
        info = WORKSPACE_MOVE_PENDING_FILE.lstat()
    except FileNotFoundError:
        return False
    except OSError:
        return True
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
        return True
    # Hyprland currently creates this runtime file with its process umask
    # (commonly 0664). Mode must never turn a real, non-empty WAL into
    # "nothing pending"; the user-private runtime directory is the boundary.
    return info.st_size > 0


class HotplugWorkspaceMutationLease:
    """Cross-runtime exclusion shared with Hyprland's Lua compactor.

    The durable intent is published before compositor-side acquisition. Lua
    acquires the logical lock before creating its WAL and then checks this
    intent, closing both orderings of the snapshot/prepare race. StateLock
    makes any pre-existing Python intent stale before this context is entered.
    """

    def __init__(self) -> None:
        self.token = f"hotplug:{os.getpid()}:{uuid.uuid4().hex}"
        self.acquired = False
        self.ready = False
        self.reason = "workspace-mutation-lock-busy"

    def _lua_lock(self, action: str) -> bool:
        expression = (
            "hl.dispatch(end4_workspace_mutation_lock("
            f"{json.dumps(action)}, {json.dumps(self.token)}))"
        )
        return eval_lua(expression, quiet=True)

    def _remove_owned_intent(self) -> None:
        current = load_json(HOTPLUG_MUTATION_INTENT_FILE)
        if not isinstance(current, dict) or current.get("token") != self.token:
            return
        try:
            HOTPLUG_MUTATION_INTENT_FILE.unlink()
        except FileNotFoundError:
            pass

    def _acquire_owned_lock(self) -> bool:
        # Hyprland may commit an eval just before its reply is lost. Retrying
        # the same token makes acquisition observable and idempotent instead
        # of treating an ambiguous timeout as a definite failure.
        for _ in range(3):
            if self._lua_lock("acquire"):
                self.acquired = True
                return True
        return False

    def _release_owned_lock(self) -> bool:
        if not self.acquired:
            return True
        # Release is idempotent in Lua for an already-empty owner. A retry
        # therefore distinguishes a lost reply from a still-held lock.
        for _ in range(3):
            if self._lua_lock("release"):
                self.acquired = False
                return True
        self.reason = "workspace-mutation-release-failed"
        return False

    def __enter__(self) -> "HotplugWorkspaceMutationLease":
        atomic_json(
            HOTPLUG_MUTATION_INTENT_FILE,
            {
                "schema": 1,
                "token": self.token,
                "pid": os.getpid(),
                "started_at": time.time(),
            },
        )
        if not self._acquire_owned_lock():
            self._remove_owned_intent()
            return self

        # A config reload can reset the in-memory Lua owner while its durable
        # compaction WAL remains. Never snapshot numeric IDs in that window.
        if workspace_compaction_pending():
            self.reason = "workspace-compaction-active"
            if self._release_owned_lock():
                self._remove_owned_intent()
            self.ready = False
            return self
        self.ready = True
        return self

    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        _exc: BaseException | None,
        _traceback: object,
    ) -> None:
        # Never erase the durable intent unless compositor-side release was
        # confirmed. If Python is killed or IPC fails, the next StateLock
        # holder publishes its new token and safely takes over the stale
        # hotplug owner; Lua compaction remains fail-closed in the meantime.
        released = self._release_owned_lock()
        self.ready = False
        if released:
            self._remove_owned_intent()
            return
        # The daemon already retries route exceptions. Do not let a route
        # report success while its durable intent remains and would otherwise
        # block Lua compaction forever.
        if exc_type is None:
            raise RuntimeError("hotplug workspace mutation lock release failed")


def terminal_binding_dir() -> Path:
    runtime = Path(
        os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    )
    return runtime / "hypr-session"


def terminal_binding_path() -> Path:
    return terminal_binding_dir() / "terminal-bindings.json"


def mkdir_terminal_binding_dir() -> Path:
    directory = terminal_binding_dir()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    info = directory.stat(follow_symlinks=False)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise OSError("unsafe terminal binding runtime directory")
    os.chmod(directory, 0o700)
    return directory


class TerminalBindingLock:
    """A runtime-only lock which never participates in StateLock ordering."""

    def __enter__(self) -> "TerminalBindingLock":
        directory = mkdir_terminal_binding_dir()
        path = directory / ".terminal-bindings.lock"
        flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0)
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        self.fd = os.open(path, flags, 0o600)
        opened = os.fstat(self.fd)
        if not stat.S_ISREG(opened.st_mode) or opened.st_uid != os.getuid():
            os.close(self.fd)
            raise OSError("unsafe terminal binding lock")
        os.fchmod(self.fd, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *_: object) -> None:
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


def atomic_terminal_registry(value: dict[str, Any]) -> None:
    """Durably replace the private runtime registry without using StateLock."""
    directory = mkdir_terminal_binding_dir()
    path = terminal_binding_path()
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=directory)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(
            directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
        )
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def empty_terminal_registry(signature: str) -> dict[str, Any]:
    return {
        "schema": TERMINAL_BINDING_SCHEMA,
        "boot_id": boot_id(),
        "hyprland_signature": signature,
        "generation": 0,
        "pending": [],
        "bindings": [],
    }


def load_terminal_registry_file() -> dict[str, Any] | None:
    """Read only a same-user, private, bounded regular runtime file."""
    path = terminal_binding_path()
    try:
        info = path.lstat()
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or info.st_mode & 0o077
            or info.st_size > MAX_TERMINAL_BINDING_FILE_BYTES
        ):
            return None
        flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(path, flags)
        opened = os.fstat(fd)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != os.getuid()
            or opened.st_mode & 0o077
            or opened.st_size > MAX_TERMINAL_BINDING_FILE_BYTES
        ):
            os.close(fd)
            return None
        with os.fdopen(fd, "r", encoding="utf-8") as handle:
            value = json.load(handle)
        return value if isinstance(value, dict) else None
    except (FileNotFoundError, OSError, ValueError, json.JSONDecodeError):
        return None


def terminal_registry_context_valid(value: Any, signature: str) -> bool:
    return bool(
        isinstance(value, dict)
        and value.get("schema") == TERMINAL_BINDING_SCHEMA
        and value.get("boot_id") == boot_id()
        and value.get("hyprland_signature") == signature
        and isinstance(value.get("generation"), int)
        and int(value.get("generation", -1)) >= 0
        and isinstance(value.get("pending"), list)
        and isinstance(value.get("bindings"), list)
    )


def load_terminal_registry_locked(signature: str) -> dict[str, Any]:
    value = load_terminal_registry_file()
    if not terminal_registry_context_valid(value, signature):
        return empty_terminal_registry(signature)
    return copy.deepcopy(value)


def write_terminal_registry_locked(value: dict[str, Any]) -> None:
    value["generation"] = int(value.get("generation", 0)) + 1
    atomic_terminal_registry(value)


def atomic_json(path: Path, value: Any) -> None:
    mkdir_state()
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=STATE_DIR)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_fd = os.open(STATE_DIR, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def load_json(path: Path) -> dict[str, Any] | None:
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_size > 4 * 1024 * 1024:
            return None
        if info.st_mode & 0o022:
            return None
        flags = os.O_RDONLY | os.O_NONBLOCK | (os.O_NOFOLLOW if hasattr(os, "O_NOFOLLOW") else 0)
        fd = os.open(path, flags)
        opened = os.fstat(fd)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != os.getuid()
            or opened.st_mode & 0o022
            or opened.st_size > 4 * 1024 * 1024
        ):
            os.close(fd)
            return None
        with os.fdopen(fd, "r", encoding="utf-8") as handle:
            result = json.load(handle)
        return result if isinstance(result, dict) else None
    except (FileNotFoundError, OSError, ValueError, json.JSONDecodeError):
        return None


def discover_signature() -> str:
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    if signature and (runtime / "hypr" / signature / ".socket2.sock").exists():
        return signature
    candidates = list((runtime / "hypr").glob("*/.socket2.sock"))
    if not candidates:
        return signature
    newest = max(candidates, key=lambda item: item.stat().st_mtime)
    signature = newest.parent.name
    os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = signature
    return signature


def event_socket_path() -> Path | None:
    signature = discover_signature()
    if not signature:
        return None
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    return runtime / "hypr" / signature / ".socket2.sock"


def hypr_json(subject: str) -> Any:
    discover_signature()
    result = subprocess.run(
        ["hyprctl", "-j", subject],
        text=True,
        capture_output=True,
        timeout=4,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or f"hyprctl {subject} failed")
    return json.loads(result.stdout)


def dispatch(lua_expression: str, quiet: bool = False) -> bool:
    result = subprocess.run(
        ["hyprctl", "dispatch", lua_expression],
        text=True,
        capture_output=True,
        timeout=5,
        check=False,
    )
    response = f"{result.stdout}\n{result.stderr}".strip().lower()
    ok = result.returncode == 0 and not response.startswith("error") and "warning:" not in response
    if not ok and not quiet:
        eprint(f"session restore dispatch failed: {result.stderr.strip() or result.stdout.strip()}")
    return ok


def eval_lua(lua_code: str, quiet: bool = False) -> bool:
    """Evaluate one compositor-side transaction instead of exposing each step."""
    try:
        result = subprocess.run(
            ["hyprctl", "eval", lua_code],
            text=True,
            capture_output=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        if not quiet:
            eprint(f"session restore transaction failed: {error}")
        return False
    response = f"{result.stdout}\n{result.stderr}".strip().lower()
    ok = result.returncode == 0 and not response.startswith("error") and "warning:" not in response
    if not ok and not quiet:
        eprint(f"session restore transaction failed: {result.stderr.strip() or result.stdout.strip()}")
    return ok


def hypr_option_bool(name: str) -> bool | None:
    try:
        result = subprocess.run(
            ["hyprctl", "-j", "getoption", name],
            text=True,
            capture_output=True,
            timeout=3,
            check=False,
        )
        if result.returncode == 0:
            value = json.loads(result.stdout)
            if isinstance(value, dict) and isinstance(value.get("bool"), bool):
                return bool(value["bool"])
    except (OSError, subprocess.TimeoutExpired, ValueError, json.JSONDecodeError):
        pass
    return None


def notify_ui_restore(active: bool) -> bool:
    """Best-effort event gate; restore correctness never depends on the shell."""
    try:
        result = subprocess.run(
            [*SESSION_RESTORE_IPC, "start" if active else "finish"],
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.6,
            check=False,
        )
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def notify_ui_hotplug(active: bool) -> bool:
    """Own only the hotplug presentation gate; never release a restore owner."""
    try:
        result = subprocess.run(
            [*SESSION_RESTORE_IPC, "hotplugStart" if active else "hotplugFinish"],
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.6,
            check=False,
        )
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def notify_ui_hotplug_commit() -> bool:
    """Publish a completed route while its quiet-pass animation fence stays up."""
    try:
        result = subprocess.run(
            [*SESSION_RESTORE_IPC, "hotplugCommit"],
            text=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=0.6,
            check=False,
        )
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def publish_hotplug_route_result(result: Any) -> bool:
    """Commit only real successful mutations; no-op/retry passes stay silent."""
    if not isinstance(result, dict) or not bool(result.get("ok", False)):
        return False
    try:
        dispatches = int(result.get("dispatches", 0) or 0)
    except (TypeError, ValueError):
        return False
    return dispatches > 0 and notify_ui_hotplug_commit()


def best_effort_dispatch_body(expressions: list[str]) -> str:
    """Build Lua rollback operations which never skip later cleanup."""
    operations: list[str] = []
    for expression in expressions:
        operations.append(
            "do local call_ok, dispatch_result = pcall(function() return hl.dispatch("
            f"{expression}"
            ") end); if not call_ok or not dispatch_result or not dispatch_result.ok then "
            "rollback_ok = false end end"
        )
    return "; ".join(operations)


def deterministic_restore_fallback(
    state: dict[str, Any] | None, requested_workspace: Any
) -> str:
    """Choose one ordinary fallback which is stable across every cleanup path."""
    candidates: list[Any] = []
    if state:
        candidates.append(state.get("fallback_workspace"))
    candidates.append(requested_workspace)
    if state:
        candidates.extend(
            item.get("workspace")
            for item in state.get("monitors", [])
            if isinstance(item, dict) and item.get("focused", False)
        )
        candidates.extend(
            item.get("workspace")
            for item in state.get("monitors", [])
            if isinstance(item, dict)
        )
    candidates.append("1")
    for candidate in candidates:
        selector = str(candidate or "").strip()
        public_name = selector.removeprefix("name:")
        if valid_workspace_name(public_name):
            return selector
    return "1"


def restore_staging_clients(
    staging_token: str | None,
) -> list[dict[str, Any]]:
    """Return mapped clients on one guard token, or every orphan if tokenless."""
    clients = [
        client
        for client in hypr_json("clients")
        if isinstance(client, dict)
        and client.get("mapped", False)
        and restore_staging_workspace(client.get("workspace") or {}, staging_token)
    ]
    return sorted(
        clients,
        key=lambda client: (
            str((client.get("workspace") or {}).get("name", "")),
            stable_number(client.get("stableId")),
            str(client.get("address", "")),
        ),
    )


def drain_restore_staging_clients(
    staging_token: str | None,
    fallback_workspace: Any,
    quiet: bool = False,
) -> dict[str, Any]:
    """Move reserved staging clients without focus and prove none remain.

    ``staging_token=None`` is reserved for login recovery of abandoned guard
    workspaces.  Exact-token cleanup is used on every normal and exceptional
    guard exit.  Invalid compositor addresses are deliberately not ignored:
    they make the zero-client postcondition fail closed.
    """
    fallback = deterministic_restore_fallback(None, fallback_workspace)
    clients = restore_staging_clients(staging_token)
    movable = [
        client
        for client in clients
        if re.fullmatch(r"0x[0-9A-Fa-f]+", str(client.get("address", "")))
    ]
    expressions = [
        "hl.dsp.window.move({ "
        f"workspace = {lua_string(workspace_selector(fallback))}, follow = false, "
        f"window = {lua_string('address:' + str(client['address']))} }})"
        for client in movable
    ]
    moved = commit_background_transaction(expressions, quiet=quiet)
    remaining = restore_staging_clients(staging_token)
    return {
        "ok": not remaining and len(movable) == len(clients),
        "fallback": fallback,
        "found": len(clients),
        "moved": moved,
        "remaining": len(remaining),
    }


def begin_restore_compositor_guard(fallback_workspace: Any) -> dict[str, Any]:
    """Pin the visible desktop in place and prevent activation theft.

    The Lua watchdog is compositor-owned, so an interrupted Python process
    cannot leave animations, cursor warps, or activation focus disabled.
    Restore launches already target ``workspace silent`` and window moves use
    ``follow = false``.  Focusing an empty staging workspace here therefore
    added no isolation; it only made login visibly leave the user's desktop
    and return to it later.  The guard now changes compositor options only.
    """
    option_state: dict[str, bool | None] = {
        "animations": hypr_option_bool("animations:enabled"),
        "cursor_no_warps": hypr_option_bool("cursor:no_warps"),
        "focus_on_activate": hypr_option_bool("misc:focus_on_activate"),
    }
    if any(value is None for value in option_state.values()):
        raise RuntimeError("compositor restore options are unavailable")
    try:
        live_monitors = [
            item
            for item in hypr_json("monitors")
            if isinstance(item, dict) and not item.get("disabled", False)
        ]
        live_active_window = hypr_json("activewindow")
    except (RuntimeError, ValueError, json.JSONDecodeError) as error:
        raise RuntimeError(f"cannot capture compositor baseline: {error}") from error
    if not live_monitors:
        raise RuntimeError("no active monitor is available for restore staging")

    baseline_monitors: list[dict[str, Any]] = []
    for item in live_monitors:
        workspace = str((item.get("activeWorkspace") or {}).get("name", ""))
        if not valid_workspace_name(workspace):
            workspace = str(default_workspace_id(item.get("id", 0)))
        baseline_monitors.append(
            {
                "monitor": str(item.get("name", "")),
                "workspace": workspace,
                "focused": bool(item.get("focused", False)),
            }
        )
    focused_window = str((live_active_window or {}).get("address", ""))
    if re.fullmatch(r"0x[0-9A-Fa-f]+", focused_window) is None:
        focused_window = ""

    token = secrets.token_hex(4)
    animations = "true" if option_state["animations"] else "false"
    cursor_no_warps = "true" if option_state["cursor_no_warps"] else "false"
    focus_on_activate = "true" if option_state["focus_on_activate"] else "false"
    token_literal = lua_string(token)
    code = (
        f"local expected_animations = {animations}; "
        f"local expected_no_warps = {cursor_no_warps}; "
        f"local expected_focus_on_activate = {focus_on_activate}; "
        f"if _G.{RESTORE_GUARD_GLOBAL} ~= nil then error('restore guard already active') end; "
        "local current_animations, animations_error = hl.get_config('animations.enabled'); "
        "local current_no_warps, cursor_error = hl.get_config('cursor.no_warps'); "
        "local current_focus_on_activate, focus_error = hl.get_config('misc.focus_on_activate'); "
        "if type(current_animations) ~= 'boolean' or current_animations ~= expected_animations then "
        "error(animations_error or 'animation baseline changed') end; "
        "if type(current_no_warps) ~= 'boolean' or current_no_warps ~= expected_no_warps then "
        "error(cursor_error or 'cursor baseline changed') end; "
        "if type(current_focus_on_activate) ~= 'boolean' or current_focus_on_activate ~= expected_focus_on_activate then "
        "error(focus_error or 'activation baseline changed') end; "
        f"local guard = {{ revealed = false, token = {token_literal} }}; "
        f"_G.{RESTORE_GUARD_GLOBAL} = guard; "
        "guard.rollback = function() "
        "local rollback_ok = true; "
        "local cleanup_ok = pcall(function() "
        "hl.config({ animations = { enabled = expected_animations }, cursor = { no_warps = expected_no_warps }, "
        "misc = { focus_on_activate = expected_focus_on_activate } }); "
        "if hl.get_config('animations.enabled') ~= expected_animations then error('animation restore failed') end; "
        "if hl.get_config('cursor.no_warps') ~= expected_no_warps then error('cursor restore failed') end; "
        "if hl.get_config('misc.focus_on_activate') ~= expected_focus_on_activate then error('activation restore failed') end "
        "end); "
        f"if _G.{RESTORE_GUARD_GLOBAL} == guard then _G.{RESTORE_GUARD_GLOBAL} = nil end; "
        "return cleanup_ok and rollback_ok "
        "end; "
        "guard.timer = hl.timer(function() "
        f"if _G.{RESTORE_GUARD_GLOBAL} ~= guard then return end; "
        "guard.rollback() "
        "end, { timeout = 65000, type = 'oneshot' }); "
        "local ok, err = pcall(function() "
        "hl.config({ animations = { enabled = false }, cursor = { no_warps = true }, "
        "misc = { focus_on_activate = false } }); "
        "if hl.get_config('animations.enabled') ~= false then error('animation suppression failed') end; "
        "if hl.get_config('cursor.no_warps') ~= true then error('cursor warp suppression failed') end; "
        "if hl.get_config('misc.focus_on_activate') ~= false then error('activation suppression failed') end; "
        "end); "
        "if not ok then "
        "local rollback_complete = guard.rollback(); "
        "if not rollback_complete then error(tostring(err) .. '; restore guard rollback failed') end; "
        "error(err) end; "
        "return true"
    )
    if not eval_lua(code):
        try:
            drained = drain_restore_staging_clients(
                token, fallback_workspace, quiet=True
            )
        except (RuntimeError, OSError, ValueError, json.JSONDecodeError):
            drained = {"ok": False}
        detail = "" if drained.get("ok") else "; staging evacuation incomplete"
        raise RuntimeError(f"failed to enter compositor restore guard{detail}")
    return {
        "animations": bool(option_state["animations"]),
        "cursor_no_warps": bool(option_state["cursor_no_warps"]),
        "focus_on_activate": bool(option_state["focus_on_activate"]),
        "monitors": baseline_monitors,
        "focused_window": focused_window,
        "staging_token": token,
        "staging_workspaces": [],
        "preserve_visible": True,
        "fallback_workspace": str(fallback_workspace or "1"),
    }


def end_restore_compositor_guard(
    state: dict[str, Any] | None,
    fallback_workspace: Any,
    reveal_fallback: bool,
    quiet: bool = False,
) -> bool:
    """Disarm the watchdog token and restore every compositor option exactly.

    The one-shot timer remains armed only so Hyprland can naturally destroy
    it at expiry; its identity guard makes the callback a no-op after success.
    """
    if not state:
        return True
    fallback_workspace = deterministic_restore_fallback(state, fallback_workspace)
    staging_token = str(state.get("staging_token", ""))
    try:
        drain_result = drain_restore_staging_clients(
            staging_token, fallback_workspace, quiet=quiet
        )
    except (RuntimeError, OSError, ValueError, json.JSONDecodeError) as error:
        drain_result = {"ok": False, "remaining": -1}
        if not quiet:
            eprint(f"session restore staging evacuation failed: {error}")
    animations = "true" if state["animations"] else "false"
    cursor_no_warps = "true" if state["cursor_no_warps"] else "false"
    focus_on_activate = "true" if state["focus_on_activate"] else "false"
    failure_cleanup = bool(reveal_fallback)
    token = lua_string(staging_token)
    revealed_check = (
        "if guard.revealed ~= true then error('restore guard was never revealed') end; "
        if not failure_cleanup
        else ""
    )
    code = (
        f"local expected_token = {token}; "
        f"local guard = _G.{RESTORE_GUARD_GLOBAL}; "
        "if guard ~= nil then "
        "if type(guard) ~= 'table' or guard.token ~= expected_token then error('restore guard ownership changed') end; "
        "if type(guard.rollback) ~= 'function' then error('restore guard rollback unavailable') end; "
        f"{revealed_check}"
        "if not guard.rollback() then "
        "error('compositor baseline rollback incomplete') end "
        "else "
        "local rollback_ok = true; "
        f"hl.config({{ animations = {{ enabled = {animations} }}, cursor = {{ no_warps = {cursor_no_warps} }}, "
        f"misc = {{ focus_on_activate = {focus_on_activate} }} }}); "
        f"if hl.get_config('animations.enabled') ~= {animations} then error('animation restore failed') end; "
        f"if hl.get_config('cursor.no_warps') ~= {cursor_no_warps} then error('cursor restore failed') end; "
        f"if hl.get_config('misc.focus_on_activate') ~= {focus_on_activate} then error('activation restore failed') end; "
        "if not rollback_ok then error('compositor baseline rollback incomplete') end "
        "end; "
        "return true"
    )
    baseline_restored = eval_lua(code, quiet=quiet)
    try:
        staging_empty = bool(staging_token) and not restore_staging_clients(
            staging_token
        )
    except (RuntimeError, OSError, ValueError, json.JSONDecodeError) as error:
        staging_empty = False
        if not quiet:
            eprint(f"session restore staging verification failed: {error}")
    return baseline_restored and bool(drain_result.get("ok")) and staging_empty


def lua_string(value: Any) -> str:
    text = str(value)
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r") + '"'


def workspace_selector(value: Any) -> str:
    name = str(value or "1")
    if re.fullmatch(r"-?[0-9]+", name) or name.startswith(("name:", "special:")):
        return name
    return f"name:{name}"


def monitor_id(value: Any) -> int:
    """Return a bounded monitor ID suitable for a numeric workspace group."""
    try:
        result = int(value)
    except (TypeError, ValueError):
        return 0
    return result if 0 <= result < MAX_MONITOR_GROUPS else 0


def strict_monitor_id(value: Any) -> int | None:
    """Parse a real monitor ID without aliasing malformed values to group 0."""
    try:
        result = int(value)
    except (TypeError, ValueError):
        return None
    return result if 0 <= result < MAX_MONITOR_GROUPS else None


def monitor_role_id(value: Any, name: Any = "") -> int | None:
    """Resolve the stable workspace-group role for a live/saved monitor."""
    if isinstance(value, dict):
        item = value
        name = item.get("name", item.get("monitor", name))
        for key in ("id", "monitorID", "monitor_id"):
            if key in item:
                value = item.get(key)
                break
        else:
            value = None
    stable = STABLE_MONITOR_ROLES.get(str(name or ""))
    if stable is not None:
        return stable
    return None if MANAGED_MONITOR_ROLES else strict_monitor_id(value)


def live_monitor_role_map(monitors: list[dict[str, Any]]) -> dict[int, int]:
    """Map transient compositor monitor IDs to stable workspace roles."""
    result: dict[int, int] = {}
    for item in monitors:
        runtime_id = strict_monitor_id(item.get("id"))
        role_id = monitor_role_id(item)
        if runtime_id is not None and role_id is not None:
            result[runtime_id] = role_id
    return result


def active_unconfigured_monitor_connectors(
    monitors: list[dict[str, Any]],
) -> list[str]:
    """Return active connectors that cannot safely own a workspace group."""
    if not MANAGED_MONITOR_ROLES:
        return []
    return sorted(
        {
            str(item.get("name", "")) or "<unnamed>"
            for item in monitors
            if isinstance(item, dict)
            and not item.get("disabled", False)
            and monitor_role_id(item) is None
        }
    )


def monitor_topology_identity(
    monitors: list[dict[str, Any]],
) -> tuple[tuple[str, int | None, bool], ...]:
    """Identity used to reject snapshots spanning a physical hotplug."""
    return tuple(
        sorted(
            (
                str(item.get("name", "")),
                monitor_role_id(item),
                bool(item.get("disabled", False)),
            )
            for item in monitors
            if isinstance(item, dict)
        )
    )


def topology_key_from_names(names: list[str]) -> str:
    """Filename-safe identity for a set of connected outputs."""
    if not names:
        return "unknown"
    return re.sub(r"[^A-Za-z0-9+._-]", "_", "+".join(sorted(set(names))))


def snapshot_topology_key(value: dict[str, Any]) -> str:
    return topology_key_from_names(
        [
            str(item.get("monitor", ""))
            for item in (value.get("monitor_workspaces") or [])
            if isinstance(item, dict) and str(item.get("monitor", ""))
        ]
    )


def live_topology_key(monitors: list[dict[str, Any]]) -> str:
    return topology_key_from_names(
        [
            str(item.get("name", ""))
            for item in monitors
            if isinstance(item, dict)
            and not item.get("disabled", False)
            and str(item.get("name", ""))
        ]
    )


def topology_slot_file(key: str) -> Path:
    return SESSION_SLOT_DIR / f"{key}.json"


def default_workspace_id(value: Any) -> int:
    return monitor_id(value) * WORKSPACE_GROUP_SIZE + 1


def valid_workspace_name(value: Any, expected_monitor: Any | None = None) -> bool:
    """Accept ordinary named/numeric workspaces and reject special encodings.

    Hyprland exposes scratchpads through internal IDs. Some versions serialize
    those IDs as large positive integers. They must never enter a persistent
    session snapshot or become input to the numeric-workspace grouping logic.
    """
    name = str(value or "").strip()
    if (
        not name
        or name.startswith("special:")
        or name.startswith(RESTORE_WORKSPACE_PREFIX)
        or name == RESTORE_STAGING_WORKSPACE.removeprefix("name:")
        or len(name) > 128
    ):
        return False
    if any(ord(character) < 32 for character in name):
        return False
    if not re.fullmatch(r"-?[0-9]+", name):
        return True
    number = int(name)
    if not 1 <= number < SERIALIZED_SPECIAL_WORKSPACE_MIN:
        return False
    if expected_monitor is None:
        return True
    first = default_workspace_id(expected_monitor)
    return first <= number < first + WORKSPACE_GROUP_SIZE


def restore_staging_workspace(value: Any, staging_token: str | None = None) -> bool:
    """Recognize only workspaces reserved by the restore compositor guard.

    With a token, require the complete ``<token>_<monitor-index>`` suffix.
    This prevents a runtime restore capture from admitting clients belonging
    to an older, newer, or merely prefix-colliding guard.  Without a token the
    predicate is intentionally broader and is used only by boot-time orphan
    recovery; persistent snapshots never use this exception.
    """
    workspace = value if isinstance(value, dict) else {"name": value}
    name = str(workspace.get("name", "")).strip()
    if not name.startswith(RESTORE_WORKSPACE_PREFIX):
        return False
    if staging_token is None:
        return True
    token = str(staging_token)
    if not token or len(token) > 128:
        return False
    return re.fullmatch(
        re.escape(f"{RESTORE_WORKSPACE_PREFIX}{token}_") + r"[0-9]+",
        name,
    ) is not None


def valid_workspace(workspace: Any, expected_monitor: Any | None = None) -> bool:
    if not isinstance(workspace, dict):
        return False
    name = str(workspace.get("name", "")).strip()
    if not valid_workspace_name(name, expected_monitor):
        return False
    try:
        internal_id = int(workspace.get("id", 0) or 0)
    except (TypeError, ValueError):
        return False
    if internal_id == 0:
        return False
    # Numeric workspaces have matching public and internal IDs. Requiring that
    # equality catches unsigned representations of negative special IDs.
    return not re.fullmatch(r"-?[0-9]+", name) or internal_id == int(name)


def numeric_workspace_owner(value: Any) -> int | None:
    """Return the monitor group encoded by an ordinary numeric workspace."""
    name = str(value or "").strip()
    if re.fullmatch(r"[0-9]+", name) is None:
        return None
    number = int(name)
    owner = (number - 1) // WORKSPACE_GROUP_SIZE
    if number < 1 or not 0 <= owner < MAX_MONITOR_GROUPS:
        return None
    return owner


HOTPLUG_WORKSPACE_PHASES = {
    "prepare-merge",
    "merged",
    "prepare-expand",
    "blocked-no-slot",
}

HOTPLUG_WORKSPACE_STATE_KEYS = frozenset({"schema", "generation", "mappings"})
HOTPLUG_WORKSPACE_MAPPING_KEYS = frozenset(
    {
        "source",
        "temporary",
        "parking",
        "spillover",
        "activate_source",
        "activation_guard",
        "source_role",
        "source_connector",
        "host_role",
        "host_connector",
        "phase",
        "created_at",
    }
)


class HotplugWorkspaceWalError(RuntimeError):
    """The durable workspace-identity WAL cannot be trusted."""


def empty_hotplug_workspace_state() -> dict[str, Any]:
    return {
        "schema": HOTPLUG_WORKSPACE_SCHEMA,
        "generation": 0,
        "mappings": [],
    }


def normalize_hotplug_workspace_state(value: Any) -> dict[str, Any]:
    """Return one canonical WAL value or reject the entire value.

    ``None`` is reserved for a positively absent WAL. Once a WAL exists, every
    field and every identity mapping must validate: silently dropping one bad
    record could forget which HDMI workspace was renamed and permit a later
    snapshot or compositor mutation to commit the wrong identity.
    """
    if value is None:
        return empty_hotplug_workspace_state()
    if not isinstance(value, dict):
        raise HotplugWorkspaceWalError("hotplug workspace WAL root is not an object")
    if set(value) != HOTPLUG_WORKSPACE_STATE_KEYS:
        raise HotplugWorkspaceWalError("hotplug workspace WAL fields are invalid")
    if (
        type(value.get("schema")) is not int
        or value.get("schema") != HOTPLUG_WORKSPACE_SCHEMA
    ):
        raise HotplugWorkspaceWalError("hotplug workspace WAL schema is invalid")
    generation = value.get("generation")
    if type(generation) is not int or generation < 0:
        raise HotplugWorkspaceWalError("hotplug workspace WAL generation is invalid")
    raw_mappings = value.get("mappings")
    if not isinstance(raw_mappings, list):
        raise HotplugWorkspaceWalError("hotplug workspace WAL mappings are invalid")

    required_integer_fields = (
        "source",
        "temporary",
        "parking",
        "spillover",
        "activation_guard",
        "source_role",
        "host_role",
    )
    all_source_ids: set[int] = set()
    for raw in raw_mappings:
        if not isinstance(raw, dict) or set(raw) != HOTPLUG_WORKSPACE_MAPPING_KEYS:
            raise HotplugWorkspaceWalError("hotplug workspace WAL mapping fields are invalid")
        if any(type(raw.get(key)) is not int for key in required_integer_fields):
            raise HotplugWorkspaceWalError("hotplug workspace WAL mapping integer is invalid")
        if type(raw.get("activate_source")) is not bool:
            raise HotplugWorkspaceWalError("hotplug workspace WAL activation flag is invalid")
        if any(
            not isinstance(raw.get(key), str)
            for key in ("source_connector", "host_connector", "phase", "created_at")
        ):
            raise HotplugWorkspaceWalError("hotplug workspace WAL mapping text is invalid")
        source = raw["source"]
        if source in all_source_ids:
            raise HotplugWorkspaceWalError("hotplug workspace WAL source is duplicated")
        all_source_ids.add(source)

    seen_sources: set[int] = set()
    seen_temporaries: set[int] = set()
    seen_parkings: set[int] = set()
    seen_spillovers: set[int] = set()
    mappings: list[dict[str, Any]] = []
    for raw in raw_mappings:
        source = raw["source"]
        temporary = raw["temporary"]
        parking = raw["parking"]
        spillover = raw["spillover"]
        activation_guard = raw["activation_guard"]
        source_role = raw["source_role"]
        host_role = raw["host_role"]
        phase = raw["phase"]
        activate_source = raw["activate_source"]
        if (
            phase not in HOTPLUG_WORKSPACE_PHASES
            or numeric_workspace_owner(source) != source_role
            or not 0 <= source_role < MAX_MONITOR_GROUPS
            or not 0 <= host_role < MAX_MONITOR_GROUPS
            or source_role == host_role
            or source in seen_sources
            or (temporary and numeric_workspace_owner(temporary) != host_role)
            or (temporary and temporary in seen_temporaries)
            or (not temporary and phase != "blocked-no-slot")
            or (phase == "blocked-no-slot" and temporary != 0)
            or (parking and not 1001 <= parking <= 1100)
            or (parking and parking in seen_parkings)
            or (spillover and numeric_workspace_owner(spillover) != source_role)
            or spillover == source
            or (spillover and spillover in all_source_ids)
            or (spillover and spillover in seen_spillovers)
            or (spillover and parking)
            or (activate_source and numeric_workspace_owner(activation_guard) is None)
            or (not activate_source and activation_guard != 0)
            or not raw["source_connector"]
            or not raw["host_connector"]
            or raw["source_connector"] == raw["host_connector"]
        ):
            raise HotplugWorkspaceWalError("hotplug workspace WAL mapping is inconsistent")
        mapping = {
            "source": source,
            "temporary": temporary,
            "parking": parking,
            "spillover": spillover,
            "activate_source": activate_source,
            "activation_guard": activation_guard,
            "source_role": source_role,
            "source_connector": raw["source_connector"],
            "host_role": host_role,
            "host_connector": raw["host_connector"],
            "phase": phase,
            "created_at": raw["created_at"],
        }
        mappings.append(mapping)
        seen_sources.add(source)
        if temporary:
            seen_temporaries.add(temporary)
        if parking:
            seen_parkings.add(parking)
        if spillover:
            seen_spillovers.add(spillover)
    return {
        "schema": HOTPLUG_WORKSPACE_SCHEMA,
        "generation": generation,
        "mappings": sorted(mappings, key=lambda item: item["source"]),
    }


def _hotplug_json_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    """Reject duplicate JSON keys instead of accepting the final spelling."""
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise HotplugWorkspaceWalError(
                "hotplug workspace WAL contains a duplicate JSON key"
            )
        result[key] = value
    return result


def load_hotplug_workspace_state() -> dict[str, Any] | None:
    """Securely load the identity WAL; return ``None`` only when absent."""
    try:
        path_info = HOTPLUG_WORKSPACE_FILE.lstat()
    except FileNotFoundError:
        return None
    except OSError as error:
        raise HotplugWorkspaceWalError(
            f"cannot inspect hotplug workspace WAL: {error}"
        ) from error
    if (
        not stat.S_ISREG(path_info.st_mode)
        or path_info.st_uid != os.getuid()
        or path_info.st_mode & 0o022
        or path_info.st_size > MAX_HOTPLUG_WORKSPACE_FILE_BYTES
    ):
        raise HotplugWorkspaceWalError("hotplug workspace WAL path is unsafe")

    flags = os.O_RDONLY | os.O_NONBLOCK
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(HOTPLUG_WORKSPACE_FILE, flags)
    except OSError as error:
        raise HotplugWorkspaceWalError(
            f"cannot open hotplug workspace WAL: {error}"
        ) from error
    try:
        opened = os.fstat(fd)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != os.getuid()
            or opened.st_mode & 0o022
            or opened.st_size > MAX_HOTPLUG_WORKSPACE_FILE_BYTES
            or (opened.st_dev, opened.st_ino) != (path_info.st_dev, path_info.st_ino)
        ):
            raise HotplugWorkspaceWalError("hotplug workspace WAL changed or is unsafe")
        with os.fdopen(fd, "rb") as handle:
            fd = -1
            payload = handle.read(MAX_HOTPLUG_WORKSPACE_FILE_BYTES + 1)
        if len(payload) > MAX_HOTPLUG_WORKSPACE_FILE_BYTES:
            raise HotplugWorkspaceWalError("hotplug workspace WAL is too large")
        try:
            value = json.loads(
                payload.decode("utf-8"), object_pairs_hook=_hotplug_json_object
            )
        except HotplugWorkspaceWalError:
            raise
        except (UnicodeError, ValueError, json.JSONDecodeError) as error:
            raise HotplugWorkspaceWalError(
                f"hotplug workspace WAL JSON is invalid: {error}"
            ) from error
        return normalize_hotplug_workspace_state(value)
    finally:
        if fd >= 0:
            os.close(fd)


def hotplug_workspace_state_equal(left: Any, right: Any) -> bool:
    left_value = normalize_hotplug_workspace_state(left)
    right_value = normalize_hotplug_workspace_state(right)
    return left_value["mappings"] == right_value["mappings"]


def persist_hotplug_workspace_state_locked(value: dict[str, Any]) -> dict[str, Any]:
    """Durably advance the WAL generation; caller owns StateLock."""
    current_raw = load_hotplug_workspace_state()
    current = normalize_hotplug_workspace_state(current_raw)
    target = normalize_hotplug_workspace_state(value)
    if current["mappings"] == target["mappings"] and current_raw is not None:
        return current
    target["generation"] = max(
        int(current.get("generation", 0)), int(target.get("generation", 0))
    ) + 1
    atomic_json(HOTPLUG_WORKSPACE_FILE, target)
    return target


def persist_hotplug_workspace_state_if_needed_locked(
    value: dict[str, Any]
) -> dict[str, Any]:
    """Persist even the idle record so other runtimes can verify the fence."""
    normalized = normalize_hotplug_workspace_state(value)
    return persist_hotplug_workspace_state_locked(normalized)


def workspace_window_count(workspace: dict[str, Any]) -> int:
    try:
        return max(0, int(workspace.get("windows", 0) or 0))
    except (TypeError, ValueError):
        return 0


def workspace_role(
    workspace: dict[str, Any], monitors: list[dict[str, Any]]
) -> int | None:
    by_name = {
        str(item.get("name", "")): monitor_role_id(item)
        for item in monitors
        if isinstance(item, dict) and not item.get("disabled", False)
    }
    name = str(workspace.get("monitor", ""))
    if name in by_name:
        return by_name[name]
    return monitor_role_id(workspace.get("monitorID"), name)


def plan_dynamic_hotplug_workspaces(
    monitors: list[dict[str, Any]],
    workspaces: list[dict[str, Any]],
    state: dict[str, Any] | None,
    *,
    created_at: str | None = None,
) -> dict[str, Any]:
    """Plan lossless HDMI collapse/expansion by renaming whole workspaces.

    No client is moved.  Every source workspace gets one vacant host identity,
    and every mapping remains in the WAL until its original identity is again
    observable on its owner connector.
    """
    value = normalize_hotplug_workspace_state(state)
    unknown_connectors = active_unconfigured_monitor_connectors(monitors)
    if unknown_connectors:
        return {
            "mode": "unconfigured-monitor",
            "state": value,
            "operations": [],
            "deferred": [],
            "collisions": [],
            "blocked": [
                {
                    "reason": "unconfigured-monitor",
                    "connectors": unknown_connectors,
                }
            ],
            "pending": True,
            "unconfigured_connectors": unknown_connectors,
        }
    timestamp = created_at or time.strftime("%Y-%m-%dT%H:%M:%S%z")
    if (
        not HOST_CONNECTOR
        or not SOURCE_CONNECTOR
        or HOST_CONNECTOR == SOURCE_CONNECTOR
        or STABLE_MONITOR_ROLES.get(HOST_CONNECTOR) != 0
        or STABLE_MONITOR_ROLES.get(SOURCE_CONNECTOR) != 1
    ):
        return {
            "mode": "disabled",
            "state": value,
            "operations": [],
            "deferred": [],
            "collisions": [],
            "blocked": [],
            "pending": False,
        }
    live_monitors = [
        item
        for item in monitors
        if isinstance(item, dict) and not item.get("disabled", False)
    ]
    connector_by_role = {
        role: str(item.get("name", ""))
        for item in live_monitors
        for role in [monitor_role_id(item)]
        if role is not None and str(item.get("name", ""))
    }
    present_roles = set(connector_by_role)
    workspace_by_number: dict[int, dict[str, Any]] = {}
    for item in workspaces:
        if not isinstance(item, dict):
            continue
        name = str(item.get("name", ""))
        if re.fullmatch(r"[0-9]+", name):
            workspace_by_number[int(name)] = item
    active_numbers = {
        int(name)
        for item in live_monitors
        for name in [str((item.get("activeWorkspace") or {}).get("name", ""))]
        if re.fullmatch(r"[0-9]+", name)
    }

    mappings = [copy.deepcopy(item) for item in value["mappings"]]
    operations: list[dict[str, Any]] = []
    deferred: list[dict[str, Any]] = []
    collisions: list[dict[str, Any]] = []
    blocked: list[dict[str, Any]] = []

    # This implementation intentionally handles the configured role pair.
    # Other numeric groups keep the ordinary owner-routing policy.
    source_role = STABLE_MONITOR_ROLES[SOURCE_CONNECTOR]
    host_role = STABLE_MONITOR_ROLES[HOST_CONNECTOR]
    source_present = source_role in present_roles
    host_connector = connector_by_role.get(host_role, HOST_CONNECTOR)
    source_connector = connector_by_role.get(source_role, SOURCE_CONNECTOR)
    source_active_name = next(
        (
            str((item.get("activeWorkspace") or {}).get("name", ""))
            for item in live_monitors
            if monitor_role_id(item) == source_role
        ),
        "",
    )
    source_active_number = (
        int(source_active_name)
        if re.fullmatch(r"[0-9]+", source_active_name)
        else 0
    )
    source_active_valid = numeric_workspace_owner(source_active_number) == source_role
    # Only user-facing 1..100 identities can be journaled as durable
    # activation guards. A timed-out expand may leave its empty 1001..1100
    # parking workspace active; that workspace is transaction scratch state,
    # not a user choice to preserve in the WAL.
    source_activation_guard_valid = (
        numeric_workspace_owner(source_active_number) is not None
    )
    source_active_workspace = workspace_by_number.get(source_active_number)
    source_active_is_empty = bool(
        source_active_number
        and (
            source_active_workspace is None
            or (
                workspace_window_count(source_active_workspace) == 0
                and not bool(source_active_workspace.get("ispersistent", False))
            )
        )
    )

    def verified_active_focus_target(
        preferred_role: int, excluded: set[int]
    ) -> tuple[str, int] | None:
        ordered = sorted(
            live_monitors,
            key=lambda item: monitor_role_id(item) != preferred_role,
        )
        for item in ordered:
            name = str((item.get("activeWorkspace") or {}).get("name", ""))
            if re.fullmatch(r"[0-9]+", name) is None:
                continue
            number = int(name)
            if number in excluded or numeric_workspace_owner(number) is None:
                continue
            if number not in workspace_by_number:
                continue
            return str(item.get("name", "")), number
        return None

    def mapping_record(source: int, temporary: int, phase: str) -> dict[str, Any]:
        return {
            "source": source,
            "temporary": temporary,
            "parking": 0,
            "spillover": 0,
            "activate_source": False,
            "activation_guard": 0,
            "source_role": source_role,
            "source_connector": source_connector or SOURCE_CONNECTOR,
            "host_role": host_role,
            "host_connector": host_connector or HOST_CONNECTOR,
            "phase": phase,
            "created_at": timestamp,
        }

    if not source_present:
        if host_role not in present_roles:
            return {
                "mode": "unavailable",
                "state": value,
                "operations": [],
                "deferred": [],
                "collisions": [],
                "blocked": [],
                "pending": False,
            }

        retained: list[dict[str, Any]] = []
        awaiting_slot: list[dict[str, Any]] = []
        mapped_sources: set[int] = set()
        for mapping in sorted(mappings, key=lambda item: int(item["source"])):
            source = int(mapping["source"])
            temporary = int(mapping["temporary"])
            source_workspace = workspace_by_number.get(source)
            temporary_workspace = workspace_by_number.get(temporary) if temporary else None
            parking = int(mapping.get("parking", 0) or 0)
            parking_workspace = workspace_by_number.get(parking) if parking else None
            if parking and parking_workspace is None:
                mapping["parking"] = 0
                parking = 0
            elif parking_workspace is not None:
                mapping["phase"] = "merged"
                retained.append(mapping)
                mapped_sources.add(source)
                if workspace_window_count(parking_workspace) > 0:
                    collisions.append({**mapping, "reason": "parking-occupied"})
                elif temporary_workspace is not None:
                    operations.append(
                        {
                            "kind": "cleanup-parking",
                            **mapping,
                            "focus_connector": host_connector,
                            "focus_target": temporary,
                        }
                    )
                elif source_workspace is not None:
                    operations.append(
                        {
                            "kind": "cleanup-parking",
                            **mapping,
                            "focus_connector": host_connector,
                            "focus_target": source,
                        }
                    )
                else:
                    fallback_target = verified_active_focus_target(
                        host_role, {parking}
                    )
                    if fallback_target is None:
                        blocked.append({**mapping, "reason": "parking-cleanup-no-target"})
                    else:
                        operations.append(
                            {
                                "kind": "cleanup-parking",
                                **mapping,
                                "focus_connector": fallback_target[0],
                                "focus_target": fallback_target[1],
                            }
                        )
                continue
            source_exists = source_workspace is not None
            temporary_exists = temporary_workspace is not None
            if source_exists and temporary_exists:
                if (
                    workspace_window_count(source_workspace) == 0
                    and not bool(source_workspace.get("ispersistent", False))
                    and workspace_window_count(temporary_workspace) > 0
                ):
                    mapping["phase"] = "merged"
                else:
                    collisions.append({**mapping, "reason": "both-identities-exist"})
                retained.append(mapping)
            elif temporary_exists:
                mapping["phase"] = "merged"
                retained.append(mapping)
            elif not source_exists or workspace_window_count(source_workspace) == 0:
                # Neither identity exists: the workspace was closed while the
                # compositor/daemon was down (or its last window closed), so
                # the journal entry is done.
                pass
            else:
                awaiting_slot.append(mapping)
            mapped_sources.add(source)

        first_source = source_role * WORKSPACE_GROUP_SIZE + 1
        for source in range(first_source, first_source + WORKSPACE_GROUP_SIZE):
            if source in mapped_sources:
                continue
            item = workspace_by_number.get(source)
            if item is not None and workspace_window_count(item) > 0:
                awaiting_slot.append(mapping_record(source, 0, "blocked-no-slot"))

        first_host = host_role * WORKSPACE_GROUP_SIZE + 1
        available_slots = []
        for temporary in range(first_host, first_host + WORKSPACE_GROUP_SIZE):
            item = workspace_by_number.get(temporary)
            if temporary in active_numbers or item is not None:
                continue
            available_slots.append(temporary)

        # A prepare record owns its chosen vacant target. Recover those first;
        # newly discovered/previously blocked sources cannot steal that slot.
        for mapping in sorted(
            awaiting_slot,
            key=lambda item: (
                int(item.get("temporary", 0) or 0) <= 0,
                int(item["source"]),
            ),
        ):
            old_temporary = int(mapping.get("temporary", 0) or 0)
            temporary = 0
            if old_temporary in available_slots:
                temporary = old_temporary
                available_slots.remove(old_temporary)
            elif available_slots:
                temporary = available_slots.pop(0)
            if not temporary:
                mapping["temporary"] = 0
                mapping["phase"] = "blocked-no-slot"
                blocked.append({**mapping, "reason": "no-empty-host-slot"})
                retained.append(mapping)
                continue
            mapping["temporary"] = temporary
            mapping["phase"] = "prepare-merge"
            mapping["host_connector"] = host_connector
            mapping["source_connector"] = mapping.get("source_connector") or SOURCE_CONNECTOR
            operations.append({"kind": "merge", **mapping})
            retained.append(mapping)

        planned_state = {
            "schema": HOTPLUG_WORKSPACE_SCHEMA,
            "generation": value["generation"],
            "mappings": sorted(retained, key=lambda item: int(item["source"])),
        }
        return {
            "mode": "merge",
            "state": planned_state,
            "operations": operations,
            "deferred": deferred,
            "collisions": collisions,
            "blocked": blocked,
            # A real two-identity collision is stable and lossless: retain the
            # mapping and allow a snapshot containing both workspaces. Close/
            # destroy events retry later. A persisted no-slot record is also
            # stable/lossless (source 11..20 is unchanged), while transitional
            # parking states remain fenced until they are resolved.
            "pending": bool(operations)
            or any(
                item.get("reason") != "no-empty-host-slot" for item in blocked
            )
            or any(item.get("reason") == "parking-occupied" for item in collisions),
        }

    # The owner connector returned. Reverse each durable identity mapping,
    # then route the restored source workspace as one compositor object.
    retained = []
    # Parking IDs are deliberately outside all user-facing 1..100 groups.
    # They exist only within one Lua transaction and are rejected by the
    # persistent snapshot validator if a compositor fault ever strands one.
    parking_candidates = [
        candidate
        for candidate in range(1001, 1101)
        if candidate not in workspace_by_number
        and candidate not in active_numbers
        and all(
            candidate not in {int(item["source"]), int(item["temporary"])}
            for item in mappings
        )
    ]
    first_source = source_role * WORKSPACE_GROUP_SIZE + 1
    spillover_candidates = [
        candidate
        for candidate in range(first_source, first_source + WORKSPACE_GROUP_SIZE)
        if candidate not in workspace_by_number
        and candidate not in active_numbers
        and all(
            candidate
            not in {
                int(item["source"]),
                int(item["temporary"]),
                int(item.get("spillover", 0) or 0),
            }
            for item in mappings
        )
    ]
    activation_claimed = False
    for mapping in sorted(mappings, key=lambda item: int(item["source"])):
        source = int(mapping["source"])
        temporary = int(mapping["temporary"])
        if int(mapping.get("source_role", -1)) not in present_roles:
            retained.append(mapping)
            continue
        if temporary <= 0:
            # A blocked merge never changed identity. Ordinary owner routing
            # below will return the untouched source workspace.
            continue
        source_workspace = workspace_by_number.get(source)
        temporary_workspace = workspace_by_number.get(temporary)
        if source_active_number == source:
            mapping["activate_source"] = False
            mapping["activation_guard"] = 0
        elif (
            source_activation_guard_valid
            and not source_active_valid
            and source_active_is_empty
            and (
                bool(mapping.get("activate_source", False))
                or not activation_claimed
            )
        ):
            mapping["activate_source"] = True
            mapping["activation_guard"] = source_active_number
            activation_claimed = True
        elif bool(mapping.get("activate_source", False)):
            # A real workspace became visible after the hotplug event. Treat
            # that as a user choice and never steal it during recovery.
            mapping["activate_source"] = False
            mapping["activation_guard"] = 0
        spillover = int(mapping.get("spillover", 0) or 0)
        spillover_workspace = workspace_by_number.get(spillover) if spillover else None
        parking = int(mapping.get("parking", 0) or 0)
        parking_workspace = workspace_by_number.get(parking) if parking else None
        if parking and parking_workspace is None:
            mapping["parking"] = 0
            parking = 0
        elif parking_workspace is not None:
            mapping["phase"] = "prepare-expand"
            retained.append(mapping)
            if workspace_window_count(parking_workspace) > 0:
                collisions.append({**mapping, "reason": "parking-occupied"})
            elif temporary_workspace is not None and source_workspace is None:
                operations.append(
                    {
                        "kind": "expand",
                        **mapping,
                        "parking_preexisting": True,
                        "placeholder_active": True,
                    }
                )
            elif source_workspace is not None and temporary_workspace is None:
                operations.append({"kind": "finish-expand", **mapping})
            elif source_workspace is not None and temporary_workspace is not None:
                # Remove only our proven-empty parking identity. Both user
                # workspaces remain untouched and are captured independently.
                operations.append(
                    {
                        "kind": "cleanup-parking",
                        **mapping,
                        "focus_connector": source_connector,
                        "focus_target": source,
                    }
                )
            else:
                fallback_target = verified_active_focus_target(
                    int(mapping["source_role"]), {parking}
                )
                if fallback_target is None:
                    blocked.append({**mapping, "reason": "parking-cleanup-no-target"})
                else:
                    operations.append(
                        {
                            "kind": "cleanup-parking",
                            **mapping,
                            "focus_connector": fallback_target[0],
                            "focus_target": fallback_target[1],
                        }
                    )
            continue
        if source_workspace is None and temporary_workspace is None:
            continue
        if source_workspace is not None and temporary_workspace is None:
            current_role = workspace_role(source_workspace, live_monitors)
            if current_role == int(mapping["source_role"]):
                if bool(mapping.get("activate_source", False)):
                    mapping["phase"] = "prepare-expand"
                    retained.append(mapping)
                    operations.append({"kind": "activate-source", **mapping})
                continue
            mapping["phase"] = "prepare-expand"
            retained.append(mapping)
            operation = {"kind": "route-source", **mapping}
            if source in active_numbers:
                deferred.append({**operation, "reason": "source-active"})
            else:
                operations.append(operation)
            continue
        if temporary_workspace is not None and temporary in active_numbers:
            mapping["phase"] = "prepare-expand"
            retained.append(mapping)
            deferred.append({"kind": "expand", **mapping, "reason": "temporary-active"})
            continue
        if spillover:
            mapping["phase"] = "prepare-expand"
            if source_workspace is not None and spillover_workspace is not None:
                retained.append(mapping)
                collisions.append({**mapping, "reason": "spillover-target-occupied"})
                continue
            if source_workspace is None and temporary_workspace is not None:
                if spillover_workspace is not None:
                    retained.append(mapping)
                    operations.append(
                        {
                            "kind": "spill-expand",
                            **mapping,
                            "spillover_preexisting": True,
                        }
                    )
                    continue
                # The prepared collision vanished before the rename. The
                # ordinary expansion path can now reclaim the vacant source.
                mapping["spillover"] = 0
                spillover = 0
            elif source_workspace is not None and temporary_workspace is not None:
                retained.append(mapping)
                operations.append({"kind": "spill-expand", **mapping})
                continue
        if source_workspace is not None:
            if workspace_window_count(source_workspace) > 0:
                mapping["phase"] = "prepare-expand"
                retained.append(mapping)
                if not spillover_candidates:
                    collisions.append({**mapping, "reason": "no-empty-source-slot"})
                    continue
                mapping["spillover"] = spillover_candidates.pop(0)
                operations.append({"kind": "spill-expand", **mapping})
                continue
            if bool(source_workspace.get("ispersistent", False)):
                mapping["phase"] = "prepare-expand"
                retained.append(mapping)
                collisions.append({**mapping, "reason": "source-persistent"})
                continue
            if not parking_candidates:
                mapping["phase"] = "prepare-expand"
                retained.append(mapping)
                collisions.append({**mapping, "reason": "no-safe-parking-id"})
                continue
            parking = parking_candidates.pop(0)
        else:
            parking = 0
        mapping["phase"] = "prepare-expand"
        mapping["source_connector"] = source_connector
        mapping["parking"] = parking
        retained.append(mapping)
        operations.append(
            {
                "kind": "expand",
                **mapping,
                "parking": parking,
                "placeholder_active": source in active_numbers,
            }
        )

    # Claim final HDMI activation only for an operation that can actually
    # commit it. An earlier blocked mapping (persistent/collided/no-slot) must
    # not consume the claim and leave a later expandable source behind an
    # empty foreign placeholder such as workspace 5.
    if (
        source_activation_guard_valid
        and not source_active_valid
        and source_active_is_empty
    ):
        activation_kinds = {
            "expand",
            "spill-expand",
            "route-source",
            "activate-source",
        }
        activation_candidates = [
            item for item in operations if item.get("kind") in activation_kinds
        ]
        if activation_candidates:
            selected = next(
                (
                    item
                    for item in activation_candidates
                    if bool(item.get("activate_source", False))
                ),
                activation_candidates[0],
            )
            selected_source = int(selected.get("source", 0) or 0)
            for item in activation_candidates:
                claimed = item is selected
                item["activate_source"] = claimed
                item["activation_guard"] = source_active_number if claimed else 0
            for item in retained:
                claimed = int(item.get("source", 0) or 0) == selected_source
                item["activate_source"] = claimed
                item["activation_guard"] = source_active_number if claimed else 0

    if (
        not source_active_valid
        and source_active_is_empty
        and not retained
        and not any(bool(item.get("activate_source", False)) for item in operations)
    ):
        operations.append(
            {
                "kind": "activate-monitor-workspace",
                "source": first_source,
                "temporary": 0,
                "parking": 0,
                "spillover": 0,
                "source_role": source_role,
                "source_connector": source_connector,
                "host_role": host_role,
                "host_connector": host_connector,
                "phase": "prepare-expand",
                "created_at": timestamp,
                "activate_source": True,
                "activation_guard": source_active_number,
            }
        )

    planned_state = {
        "schema": HOTPLUG_WORKSPACE_SCHEMA,
        "generation": value["generation"],
        "mappings": sorted(retained, key=lambda item: int(item["source"])),
    }
    return {
        "mode": "expand",
        "state": planned_state,
        "operations": operations,
        "deferred": deferred,
        "collisions": collisions,
        "blocked": blocked,
        "pending": bool(operations or deferred or blocked)
        or any(item.get("reason") == "parking-occupied" for item in collisions),
    }


def valid_workspace_name_in_topology(
    value: Any,
    current_monitor: Any,
    available_monitor_ids: set[int],
) -> bool:
    """Allow a numeric group to stay intact while its owner output is absent."""
    name = str(value or "").strip()
    if re.fullmatch(r"-?[0-9]+", name) is None:
        return valid_workspace_name(name)
    current = strict_monitor_id(current_monitor)
    if current is None:
        return False
    if valid_workspace_name(name, current):
        return True
    owner = numeric_workspace_owner(name)
    return bool(
        owner is not None
        and owner != current
        and owner not in available_monitor_ids
        and valid_workspace_name(name)
    )


def valid_workspace_in_topology(
    workspace: Any,
    current_monitor: Any,
    available_monitor_ids: set[int],
) -> bool:
    if not valid_workspace(workspace):
        return False
    return valid_workspace_name_in_topology(
        workspace.get("name", ""), current_monitor, available_monitor_ids
    )


def journal_note(message: str) -> None:
    """Best-effort line into the journal; never fatal, never blocks."""
    try:
        subprocess.run(
            ["/usr/bin/logger", "-t", "hypr-session-state", message],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1.0,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def proc_stat(pid: int) -> dict[str, int] | None:
    try:
        raw = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        rest = raw[raw.rfind(")") + 2 :].split()
        return {
            "ppid": int(rest[1]),
            "pgrp": int(rest[2]),
            "session": int(rest[3]),
            "tty": int(rest[4]),
            "tpgid": int(rest[5]),
            "start": int(rest[19]),
        }
    except (OSError, ValueError, IndexError):
        return None


class RestoreBusy(RuntimeError):
    """Another live restore/repair process owns compositor mutation."""


class RestoreLeaseLost(RuntimeError):
    """The on-disk lease no longer belongs to this process."""


def boot_id() -> str:
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text(encoding="ascii").strip()
    except OSError:
        return ""


def durable_unlink(path: Path) -> None:
    """Remove a state file and durably commit its directory entry."""
    try:
        path.unlink()
    except FileNotFoundError:
        return
    directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def lease_owner_alive(value: Any) -> bool:
    if not isinstance(value, dict) or value.get("lease_schema") != RESTORE_LEASE_SCHEMA:
        return False
    if str(value.get("boot_id", "")) != boot_id():
        return False
    try:
        pid = int(value.get("pid", 0))
        expected_start = int(value.get("pid_start_ticks", -1))
    except (TypeError, ValueError):
        return False
    identity = proc_stat(pid)
    return bool(identity and int(identity.get("start", -2)) == expected_start)


def restore_record_alive(value: Any) -> bool:
    """Return whether a token lease or a short-lived legacy flag has an owner."""
    if not isinstance(value, dict):
        return False
    if value.get("lease_schema") == RESTORE_LEASE_SCHEMA:
        # A live token owner is authoritative regardless of file mtime. Long
        # launches must never be mistaken for an abandoned restore.
        if lease_owner_alive(value):
            return True
        # After compositor mutation begins, its Lua watchdog remains the only
        # safe writer even if Python dies. Do not let autosave or a second
        # restore release the UI gate before that watchdog has rolled back.
        try:
            watchdog_deadline = float(value.get("watchdog_deadline_at", 0) or 0)
        except (TypeError, ValueError):
            watchdog_deadline = 0
        return bool(value.get("mutation_started") and time.time() < watchdog_deadline)
    try:
        pid = int(value.get("pid", 0))
        started = float(value.get("started", RESTORE_FLAG.stat().st_mtime))
    except (FileNotFoundError, OSError, TypeError, ValueError):
        return False
    return bool(pid > 0 and proc_stat(pid) and time.time() - started < 180)


def abandon_restore_record_locked(value: dict[str, Any]) -> None:
    """Fence a dead owner and protect the last snapshot after any mutation."""
    token = str(value.get("token", ""))
    terminal = load_json(MARKER_FILE)
    terminal_matches = bool(
        token
        and terminal
        and terminal.get("attempt_id") == token
        and terminal.get("state") in {"complete", "failed", "abandoned", "rolled_back"}
    )
    if bool(value.get("mutation_started")) and not terminal_matches:
        atomic_json(
            MARKER_FILE,
            {
                "schema": SCHEMA_VERSION,
                "state": "abandoned",
                "complete": False,
                "operation": value.get("operation", "restore"),
                "signature": value.get("signature"),
                "content_hash": value.get("content_hash"),
                "attempt_id": token,
                "attempt": value.get("attempt", 1),
                "protect_snapshot": True,
                "unresolved": -1,
                "restore_error": "previous restore owner exited during compositor mutation",
                "restored_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            },
        )
    durable_unlink(RESTORE_FLAG)
    # StateLock serializes this with acquisition, so an old cleanup cannot
    # release a newer owner's shell gate.
    notify_ui_restore(False)


class RestoreLease:
    """Single token owner for every compositor-mutating session operation.

    Callers already hold StateLock while a restore runs.  Token comparisons
    still protect stale finally blocks, PID reuse, and crash recovery across
    future refactors which shorten that lock scope.
    """

    def __init__(self, value: dict[str, Any]):
        self.value = value
        self.token = str(value["token"])
        self.released = False

    @classmethod
    def acquire_locked(
        cls,
        *,
        operation: str,
        signature: str,
        content_hash: str,
        phase: str,
        attempt: int,
    ) -> "RestoreLease":
        existing = load_json(RESTORE_FLAG)
        if existing and restore_record_alive(existing):
            raise RestoreBusy(
                f"{existing.get('operation', 'restore')} is active in phase {existing.get('phase', 'unknown')}"
            )
        if existing:
            abandon_restore_record_locked(existing)

        identity = proc_stat(os.getpid())
        if identity is None:
            raise RuntimeError("cannot identify restore process")
        now = time.time()
        value = {
            "lease_schema": RESTORE_LEASE_SCHEMA,
            "state": "in_progress",
            "token": secrets.token_hex(16),
            "operation": operation,
            "pid": os.getpid(),
            "pid_start_ticks": int(identity["start"]),
            "boot_id": boot_id(),
            "signature": signature,
            "content_hash": content_hash,
            "phase": phase,
            "attempt": max(1, int(attempt)),
            "mutation_started": False,
            "started_at": now,
            "updated_at": now,
        }
        atomic_json(RESTORE_FLAG, value)
        lease = cls(value)
        notify_ui_restore(True)
        return lease

    def assert_owned_locked(self) -> dict[str, Any]:
        current = load_json(RESTORE_FLAG)
        if not current or current.get("token") != self.token or not lease_owner_alive(current):
            raise RestoreLeaseLost("restore lease ownership changed")
        return current

    def renew_locked(
        self,
        phase: str,
        *,
        mutation_started: bool | None = None,
        watchdog_deadline_at: float | None = None,
    ) -> None:
        current = self.assert_owned_locked()
        current["phase"] = phase
        current["updated_at"] = time.time()
        if mutation_started is not None:
            current["mutation_started"] = bool(mutation_started)
        if watchdog_deadline_at is not None:
            current["watchdog_deadline_at"] = float(watchdog_deadline_at)
        atomic_json(RESTORE_FLAG, current)
        self.value = current

    def ensure_ui_active_locked(self) -> bool:
        self.assert_owned_locked()
        return notify_ui_restore(True)

    def write_terminal_locked(
        self,
        outcome: dict[str, Any],
        *,
        complete: bool,
        protect_snapshot: bool,
    ) -> dict[str, Any]:
        """Commit an outcome only while this token still owns the lifecycle."""
        current = self.assert_owned_locked()
        marker = dict(outcome)
        marker.update(
            {
                "schema": SCHEMA_VERSION,
                "state": "complete" if complete else "failed",
                "complete": bool(complete),
                "operation": current.get("operation", "restore"),
                "signature": current.get("signature"),
                "content_hash": current.get("content_hash"),
                "attempt_id": self.token,
                "attempt": current.get("attempt", 1),
                "protect_snapshot": bool(protect_snapshot),
            }
        )
        marker.setdefault("restored_at", time.strftime("%Y-%m-%dT%H:%M:%S%z"))
        atomic_json(MARKER_FILE, marker)
        return marker

    def release_locked(self) -> bool:
        if self.released:
            return True
        current = load_json(RESTORE_FLAG)
        if not current or current.get("token") != self.token:
            return False
        durable_unlink(RESTORE_FLAG)
        self.released = True
        notify_ui_restore(False)
        return True


def proc_cmdline(pid: int) -> list[str]:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        return [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]
    except OSError:
        return []


def proc_cwd(pid: int) -> Path | None:
    try:
        value = Path(os.readlink(f"/proc/{pid}/cwd"))
        return value if value.is_dir() else None
    except OSError:
        return None


def proc_start_wall(pid: int) -> float | None:
    """Wall-clock start time of a process, or None if it cannot be read."""
    details = proc_stat(pid)
    if details is None:
        return None
    try:
        ticks = os.sysconf("SC_CLK_TCK")
        for line in Path("/proc/stat").read_text(encoding="ascii").splitlines():
            if line.startswith("btime "):
                return int(line.split()[1]) + details["start"] / ticks
    except (OSError, ValueError, IndexError, KeyError):
        return None
    return None


def configured_restore_programs() -> frozenset[str]:
    """Extra programs the user has explicitly allowed to be restored.

    One bare program name per line; blank lines and # comments ignored. Names
    are validated so a config file can never smuggle arguments or a path.
    """
    try:
        raw = RESTORE_PROGRAMS_CONFIG.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return frozenset()
    names = set()
    for line in raw.splitlines()[:256]:
        name = line.split("#", 1)[0].strip().lower()
        if name and re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", name):
            names.add(name)
    return frozenset(names)


def restorable_tuis() -> frozenset[str]:
    return frozenset(SAFE_TUIS) | configured_restore_programs()


def canonical_claude_session_id(value: Any) -> str | None:
    text = str(value or "").strip().lower()
    if re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", text):
        return text
    return None


def claude_project_dir(cwd: Path | None) -> Path | None:
    """Claude Code stores one directory per project, keyed by the encoded cwd."""
    if cwd is None:
        return None
    encoded = re.sub(r"[^A-Za-z0-9]", "-", str(cwd))
    candidate = CLAUDE_PROJECTS_DIR / encoded
    return candidate if candidate.is_dir() else None


def claude_session_identity(pid: int, cwd: Path | None) -> tuple[str | None, bool]:
    """Resolve which conversation this process owns, or refuse to guess.

    Claude Code does not export its session id and does not keep the transcript
    open, so the only available link is "the transcript for this cwd that has
    been written since the process started". When that leaves more than one
    candidate the pairing is genuinely ambiguous, and returning nothing is
    correct: a fresh session is a small annoyance, resuming somebody else's
    conversation is not.
    """
    directory = claude_project_dir(cwd)
    if directory is None:
        return None, False
    started = proc_start_wall(pid)
    if started is None:
        return None, False
    candidates: list[str] = []
    try:
        for index, entry in enumerate(sorted(directory.glob("*.jsonl"))):
            if index >= MAX_CLAUDE_SESSION_CANDIDATES:
                return None, False
            session_id = canonical_claude_session_id(entry.stem)
            if session_id is None:
                continue
            try:
                if entry.stat().st_mtime >= started:
                    candidates.append(session_id)
            except OSError:
                continue
    except OSError:
        return None, False
    if len(candidates) != 1:
        return None, False
    return candidates[0], True


def canonical_codex_session_id(value: Any) -> str | None:
    """Return one canonical UUID, never a session-name or fuzzy identifier."""
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = uuid.UUID(value)
    except (ValueError, AttributeError):
        return None
    canonical = str(parsed)
    return canonical if value.lower() == canonical else None


def proc_selected_environ(pid: int) -> tuple[dict[str, str], bool]:
    """Read only allow-listed identity fields from a stable same-user process.

    ``/proc/<pid>/environ`` can race PID exit/reuse.  Process start ticks are
    checked on both sides of the read, and an oversized or conflicting record
    is treated as unavailable rather than partially trusted.
    """
    before = proc_stat(pid)
    if before is None:
        return {}, False
    proc_dir = f"/proc/{pid}"
    try:
        if os.stat(proc_dir, follow_symlinks=False).st_uid != os.getuid():
            return {}, False
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(f"{proc_dir}/environ", flags)
        try:
            chunks: list[bytes] = []
            remaining = MAX_PROC_ENVIRON_BYTES + 1
            while remaining > 0:
                chunk = os.read(fd, min(65536, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
        finally:
            os.close(fd)
    except OSError:
        return {}, False
    raw = b"".join(chunks)
    after = proc_stat(pid)
    if (
        len(raw) > MAX_PROC_ENVIRON_BYTES
        or after is None
        or int(before.get("start", -1)) != int(after.get("start", -2))
    ):
        return {}, False

    selected: dict[str, str] = {}
    for entry in raw.split(b"\0"):
        key_bytes, separator, value_bytes = entry.partition(b"=")
        if not separator:
            continue
        try:
            key = key_bytes.decode("ascii")
        except UnicodeDecodeError:
            continue
        if key not in TERMINAL_IDENTITY_ENV:
            continue
        try:
            value = value_bytes.decode("utf-8")
        except UnicodeDecodeError:
            return {}, False
        if key in selected and selected[key] != value:
            return {}, False
        selected[key] = value
    return selected, True


def read_codex_session_meta(path: Path, thread_id: str) -> str | None:
    """Resolve an exact rollout file without following links or reading history."""
    try:
        sessions_root = CODEX_SESSIONS_DIR.resolve(strict=True)
        path_stat = path.lstat()
        if (
            not stat.S_ISREG(path_stat.st_mode)
            or path_stat.st_uid != os.getuid()
        ):
            return None
        resolved = path.resolve(strict=True)
        if resolved != sessions_root and sessions_root not in resolved.parents:
            return None
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(resolved, flags)
        try:
            opened = os.fstat(fd)
            if (
                opened.st_dev != path_stat.st_dev
                or opened.st_ino != path_stat.st_ino
                or opened.st_uid != os.getuid()
                or not stat.S_ISREG(opened.st_mode)
            ):
                return None
            # Rollout files can be hundreds of megabytes; only their bounded
            # first session_meta line is identity evidence.  pread() leaves a
            # live Codex writer's file offset untouched.
            raw = os.pread(fd, MAX_CODEX_SESSION_META_BYTES + 1, 0)
        finally:
            os.close(fd)
    except OSError:
        return None
    first_line = raw.split(b"\n", 1)[0]
    if len(first_line) > MAX_CODEX_SESSION_META_BYTES:
        return None
    try:
        record = json.loads(first_line.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    payload = record.get("payload") if isinstance(record, dict) else None
    if (
        not isinstance(record, dict)
        or record.get("type") != "session_meta"
        or not isinstance(payload, dict)
        or canonical_codex_session_id(payload.get("id")) != thread_id
        or payload.get("originator") != "codex-tui"
    ):
        return None
    return canonical_codex_session_id(payload.get("session_id"))


def codex_session_id_from_open_rollouts(pid: int) -> tuple[str | None, bool]:
    """Resolve one root session from every rollout held open by a stable PID.

    A normal Codex launch does not export its generated session/thread UUIDs.
    Its open rollout files are usable identity evidence only when every observed
    file is a same-user regular file below the private sessions root, its
    filename thread UUID agrees with its validated session_meta record, and all
    records converge on one root session UUID.  Any race or ambiguity fails
    closed.
    """
    before = proc_stat(pid)
    if before is None:
        return None, False
    proc_dir = Path(f"/proc/{pid}")
    fd_dir = proc_dir / "fd"
    try:
        if proc_dir.stat(follow_symlinks=False).st_uid != os.getuid():
            return None, False
        sessions_root = CODEX_SESSIONS_DIR.resolve(strict=True)
        root_info = sessions_root.stat(follow_symlinks=False)
        if not stat.S_ISDIR(root_info.st_mode) or root_info.st_uid != os.getuid():
            return None, False
        fd_names = os.listdir(fd_dir)
        if len(fd_names) > MAX_CODEX_OPEN_FDS:
            return None, False

        root_sessions: set[str] = set()
        rollout_name = re.compile(
            r"rollout-.+-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
            r"[0-9a-f]{4}-[0-9a-f]{12})\.jsonl"
        )
        for fd_name in fd_names:
            if not fd_name.isdecimal():
                continue
            fd_path = fd_dir / fd_name
            try:
                target = Path(os.readlink(fd_path))
            except FileNotFoundError:
                # The descriptor set changed while it was being inspected.
                return None, False
            if not target.is_absolute():
                continue
            try:
                resolved = target.resolve(strict=True)
            except OSError:
                if target.name.startswith("rollout-") and sessions_root in target.parents:
                    return None, False
                continue
            if sessions_root not in resolved.parents:
                continue
            if not resolved.name.startswith("rollout-"):
                continue
            match = rollout_name.fullmatch(resolved.name)
            if match is None:
                return None, False
            thread_id = canonical_codex_session_id(match.group(1))
            if thread_id is None:
                return None, False

            path_info = resolved.stat(follow_symlinks=False)
            opened_fd = os.open(fd_path, os.O_RDONLY | getattr(os, "O_CLOEXEC", 0))
            try:
                opened = os.fstat(opened_fd)
            finally:
                os.close(opened_fd)
            if (
                not stat.S_ISREG(path_info.st_mode)
                or not stat.S_ISREG(opened.st_mode)
                or path_info.st_uid != os.getuid()
                or opened.st_uid != os.getuid()
                or opened.st_dev != path_info.st_dev
                or opened.st_ino != path_info.st_ino
            ):
                return None, False
            session_id = read_codex_session_meta(resolved, thread_id)
            if session_id is None:
                return None, False
            root_sessions.add(session_id)
            if len(root_sessions) != 1:
                return None, False
    except OSError:
        return None, False

    after = proc_stat(pid)
    if (
        after is None
        or int(before.get("start", -1)) != int(after.get("start", -2))
        or len(root_sessions) != 1
    ):
        return None, False
    return next(iter(root_sessions)), True


def codex_session_id_from_thread(thread_id: Any) -> str | None:
    """Map an exact Codex thread UUID to its root resumable session UUID."""
    canonical_thread = canonical_codex_session_id(thread_id)
    if canonical_thread is None or not CODEX_SESSIONS_DIR.is_dir():
        return None
    try:
        candidates = list(
            CODEX_SESSIONS_DIR.rglob(f"rollout-*-{canonical_thread}.jsonl")
        )
    except OSError:
        return None
    if len(candidates) != 1:
        return None
    return read_codex_session_meta(candidates[0], canonical_thread)


def explicit_codex_resume_session(argv: list[str]) -> str | None:
    """Recognize only the exact resume argv emitted by this restore service."""
    if len(argv) < 3 or Path(argv[0]).name.lower() != "codex" or argv[1] != "resume":
        return None
    return canonical_codex_session_id(argv[2])


def codex_session_identity(pid: int, argv: list[str]) -> tuple[str | None, bool]:
    """Resolve one Codex session from stable, mutually consistent evidence."""
    environment, inspected = proc_selected_environ(pid)
    if not inspected:
        return None, False

    session_raw = environment.get("CODEX_SESSION_ID")
    thread_raw = environment.get("CODEX_THREAD_ID")
    session_id = canonical_codex_session_id(session_raw)
    thread_id = canonical_codex_session_id(thread_raw)
    if (session_raw is not None and session_id is None) or (
        thread_raw is not None and thread_id is None
    ):
        return None, False

    argv_session = explicit_codex_resume_session(argv)
    if session_id is not None:
        # CODEX_SESSION_ID is already the root resumable identity.  Do not scan
        # the rollout tree on every title/autosave capture merely to translate
        # a subordinate thread ID; exact restore argv is the only independent
        # evidence which must agree when it is present.
        if argv_session is not None and argv_session != session_id:
            return None, False
        return session_id, True

    thread_session = codex_session_id_from_thread(thread_id) if thread_id else None
    evidence = [value for value in (thread_session, argv_session) if value]
    if evidence:
        if len(set(evidence)) != 1:
            return None, False
        return evidence[0], True

    fd_session, fd_inspected = codex_session_id_from_open_rollouts(pid)
    if not fd_inspected or fd_session is None:
        return None, False
    return fd_session, True


def direct_children_with_status(pid: int) -> tuple[list[int], bool]:
    try:
        text = Path(f"/proc/{pid}/task/{pid}/children").read_text(encoding="ascii")
        return [int(value) for value in text.split()], True
    except (OSError, ValueError):
        return [], False


def safe_terminal_program(argv: list[str]) -> str | None:
    """Return a restorable foreground TUI name, excluding helper processes."""
    if not argv:
        return None
    name = Path(argv[0]).name.lower()
    if name in {"nvim", "vim"}:
        # Neovim providers and GUI frontends commonly create an embedded child.
        # That child is not the user's editor process and must never win over
        # the nearest interactive nvim ancestor.
        if any(arg == "--embed" or arg.startswith("--embed=") or arg == "--headless" for arg in argv[1:]):
            return None
        return "nvim"
    # Be exact here: codex-code-mode-host and similar descendants are helpers,
    # while the interactive CLI process has argv[0] basename exactly "codex".
    if name == "codex":
        return "codex"
    # Same exactness as codex: only the interactive CLI, never a helper child.
    if name == "claude":
        return "claude"
    if name in restorable_tuis():
        return name
    return None


def active_safe_descendant(shell_pid: int, foreground_pgrp: int) -> tuple[int | None, bool]:
    """Find one nearest safe TUI sharing the shell's foreground process group.

    Restored commands launched through ``fish -C`` can stay in Fish's process
    group, leaving the tty tpgid equal to the shell PID.  Walk only that active
    process group, stop below a safe candidate, and reject ambiguous peers.  A
    false second return value means the scan was incomplete or ambiguous, so a
    caller must preserve the previous trusted terminal metadata.
    """
    first, complete = direct_children_with_status(shell_pid)
    queue: list[tuple[int, int]] = [(pid, 1) for pid in first]
    seen = {shell_pid}
    candidates: list[tuple[int, int, int]] = []
    visited = 0
    active_group_members = 0
    shell_details = proc_stat(shell_pid)
    while queue and visited < MAX_TERMINAL_DESCENDANTS:
        pid, depth = queue.pop(0)
        if pid in seen:
            continue
        seen.add(pid)
        visited += 1
        details = proc_stat(pid)
        if details is None:
            complete = False
            continue
        # Ignore background jobs and processes detached from this terminal.
        if not details.get("tty") or (foreground_pgrp > 0 and details.get("pgrp") != foreground_pgrp):
            continue
        if shell_details and (
            details.get("tty") != shell_details.get("tty")
            or details.get("session") != shell_details.get("session")
        ):
            continue
        active_group_members += 1
        program = safe_terminal_program(proc_cmdline(pid))
        if program:
            candidates.append((depth, int(details.get("start", 0)), pid))
            # Do not inspect providers/helpers below an interactive TUI.
            continue
        children, readable = direct_children_with_status(pid)
        complete = complete and readable
        queue.extend((child, depth + 1) for child in children)
    if queue:
        complete = False
    if not candidates:
        # A readable, child-free shell is positively idle.  A same-foreground-
        # group child running an unknown/unsafe command is not: retain the old
        # safe restore tuple instead of silently downgrading it to a shell.
        return None, complete and active_group_members == 0
    nearest_depth = min(item[0] for item in candidates)
    nearest = [item for item in candidates if item[0] == nearest_depth]
    if len(nearest) != 1:
        return None, False
    return nearest[0][2], True


def terminal_program(shell_pid: int, foreground_pid: int, cwd: Path | None) -> dict[str, Any]:
    target_pid = foreground_pid if foreground_pid > 0 else shell_pid
    # tpgid is a process-group ID.  It normally equals the group leader PID,
    # but validate the live process before treating that number as executable
    # identity; a stale/racing lookup must remain unverified.
    target_valid = True
    if target_pid != shell_pid:
        shell_details = proc_stat(shell_pid)
        target_details = proc_stat(target_pid)
        target_valid = bool(
            target_details
            and target_details.get("pgrp") == foreground_pid
            and target_details.get("tty")
            and (
                not shell_details
                or (
                    target_details.get("tty") == shell_details.get("tty")
                    and target_details.get("session") == shell_details.get("session")
                )
            )
        )
    argv = proc_cmdline(target_pid) if target_valid else []
    name = Path(argv[0]).name.lower() if argv else ""
    program = safe_terminal_program(argv)
    program_verified = program is not None

    if target_pid == shell_pid and name in SHELL_NAMES:
        descendant_pid, scan_definitive = active_safe_descendant(shell_pid, foreground_pid)
        if descendant_pid is not None:
            target_pid = descendant_pid
            argv = proc_cmdline(target_pid)
            name = Path(argv[0]).name.lower() if argv else ""
            program = safe_terminal_program(argv)
            program_verified = program is not None
        else:
            # No active safe child and a complete scan positively identifies
            # an idle shell.  An unreadable/ambiguous scan stays unverified.
            program_verified = scan_definitive
    elif name in SHELL_NAMES:
        program_verified = True

    # ``cwd`` is only a shell fallback supplied by terminal_sessions().  It is
    # not proof that the foreground TUI itself was inspected successfully.
    # Keep that distinction so a transient /proc race cannot overwrite a
    # trusted project cwd with the shell's older directory.
    detected_cwd = proc_cwd(target_pid) if target_valid else None
    cwd_verified = detected_cwd is not None
    if detected_cwd is not None:
        cwd = detected_cwd
    result: dict[str, Any] = {
        "kind": "terminal",
        "cwd": str(cwd) if cwd is not None else None,
        "program": "shell",
        "args": [],
        "_cwd_verified": cwd_verified,
        "_mapping_verified": False,
        "_program_verified": program_verified,
        "_session_verified": False,
    }

    if program == "nvim":
        # Reopen only plain paths.  If any executable option was used, do not
        # preserve arguments: flags such as -S/-u/-c can execute arbitrary code.
        raw_args = argv[1:]
        safe_args: list[str] = []
        if not any(arg.startswith(("-", "+")) for arg in raw_args):
            safe_args = [arg for arg in raw_args[:32] if len(arg) <= 2048 and "\0" not in arg]
        if not safe_args:
            safe_args = ["."]
        result.update(program="nvim", args=safe_args)
    elif program == "codex":
        session_id, session_verified = codex_session_identity(target_pid, argv)
        result.update(
            program="codex",
            args=[],
            _session_verified=session_verified,
        )
        if session_id is not None:
            result["session_id"] = session_id
    elif program == "claude":
        session_id, session_verified = claude_session_identity(
            target_pid, Path(cwd) if cwd is not None else None
        )
        result.update(
            program="claude",
            args=[],
            _session_verified=session_verified,
        )
        if session_id is not None:
            result["session_id"] = session_id
    elif program in restorable_tuis():
        result.update(program=program, args=[])
    return result


def valid_terminal_screen(value: Any) -> bool:
    return bool(
        isinstance(value, str)
        and re.fullmatch(r"/org/gnome/Terminal/screen/[A-Za-z0-9_]+", value)
    )


def valid_terminal_service(value: Any) -> bool:
    return bool(isinstance(value, str) and re.fullmatch(r":[0-9]+\.[0-9]+", value))


def terminal_sessions(server_pid: int) -> list[dict[str, Any]]:
    sessions: list[dict[str, Any]] = []
    server_details = proc_stat(server_pid)
    if server_details is None:
        return sessions
    server_children, _ = direct_children_with_status(server_pid)
    for child in server_children:
        details = proc_stat(child)
        argv = proc_cmdline(child)
        shell_name = Path(argv[0]).name.lower() if argv else ""
        if not details or not details["tty"] or shell_name not in SHELL_NAMES:
            continue
        foreground = details["tpgid"]
        # Pass only the shell cwd as a fallback.  terminal_program() separately
        # verifies the selected foreground process cwd.
        launch = terminal_program(child, foreground, proc_cwd(child))
        environment, environment_verified = proc_selected_environ(child)
        confirmed = proc_stat(child)
        screen = environment.get("GNOME_TERMINAL_SCREEN", "")
        service = environment.get("GNOME_TERMINAL_SERVICE", "")
        identity_verified = bool(
            environment_verified
            and confirmed is not None
            and int(confirmed.get("start", -1)) == int(details["start"])
            and int(confirmed.get("tty", 0)) == int(details["tty"])
            and int(confirmed.get("ppid", 0)) == server_pid
            and valid_terminal_screen(screen)
            and valid_terminal_service(service)
        )
        if identity_verified:
            launch["_terminal_screen"] = screen
            launch["_terminal_service"] = service
        sessions.append(
            {
                "server_pid": server_pid,
                "server_start": int(server_details["start"]),
                "shell_pid": child,
                "shell_start": int(details["start"]),
                "tty": int(details["tty"]),
                "screen": screen if identity_verified else "",
                "service": service if identity_verified else "",
                "identity_verified": identity_verified,
                "start": int(details["start"]),
                "launch": launch,
            }
        )
    server_confirmed = proc_stat(server_pid)
    if (
        server_confirmed is None
        or int(server_confirmed.get("start", -1))
        != int(server_details.get("start", -2))
    ):
        return []
    return sorted(sessions, key=lambda item: (item["start"], item["shell_pid"]))


def desktop_entries() -> list[dict[str, str]]:
    global _desktop_cache
    if _desktop_cache is not None:
        return _desktop_cache
    found: dict[str, dict[str, str]] = {}
    for base in DESKTOP_DIRS:
        if not base.is_dir():
            continue
        try:
            paths = sorted(base.rglob("*.desktop"))
        except OSError:
            continue
        for path in paths:
            try:
                relative = path.relative_to(base)
                desktop_id = str(relative).replace("/", "-")[:-8]
                values: dict[str, str] = {}
                in_entry = False
                for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
                    if line.startswith("["):
                        in_entry = line.strip() == "[Desktop Entry]"
                        continue
                    if in_entry and "=" in line:
                        key, value = line.split("=", 1)
                        if "[" not in key:
                            values[key.strip()] = value.strip()
                if (
                    values.get("Type", "Application") != "Application"
                    or values.get("Hidden", "false").lower() == "true"
                    or values.get("NoDisplay", "false").lower() == "true"
                ):
                    continue
                command = shlex.split(values.get("Exec", ""))
                executable = ""
                for token in command:
                    if token == "env" or "=" in token and not token.startswith("/"):
                        continue
                    executable = Path(token).name
                    break
                found.setdefault(
                    desktop_id,
                    {
                        "id": desktop_id,
                        "stem": path.stem,
                        "startup": values.get("StartupWMClass", ""),
                        "executable": executable,
                        "name": values.get("Name", ""),
                    },
                )
            except (OSError, ValueError):
                continue
    _desktop_cache = list(found.values())
    return _desktop_cache


def desktop_launch(window_class: str, initial_class: str) -> dict[str, str] | None:
    wanted = {norm(window_class), norm(initial_class)} - {""}
    wanted |= {value[:-2] for value in list(wanted) if value.endswith("py") and len(value) > 4}
    best: tuple[int, str] = (0, "")
    for entry in desktop_entries():
        fields = {
            "startup": norm(entry["startup"]),
            "stem": norm(entry["stem"]),
            "id": norm(entry["id"]),
            "executable": norm(entry["executable"]),
        }
        score = 0
        for value in wanted:
            if value and value == fields["startup"]:
                score = max(score, 140)
            if value and value in {fields["stem"], fields["id"]}:
                score = max(score, 120)
            if value and value == fields["executable"]:
                score = max(score, 100)
        if score > best[0] or score == best[0] and entry["id"] < best[1]:
            best = (score, entry["id"])
    if best[0] >= 100 and re.fullmatch(r"[A-Za-z0-9_.+\-]+", best[1]):
        return {"kind": "desktop", "id": best[1]}
    return None


def fallback_launch(pid: int) -> dict[str, str] | None:
    try:
        executable = Path(os.readlink(f"/proc/{pid}/exe")).resolve()
    except OSError:
        return None
    if executable.name.lower() in {"python", "python3", "bash", "fish", "sh", "env", "flatpak"}:
        return None
    allowed = (Path("/usr/bin"), Path("/usr/local/bin"), Path("/opt"), HOME / ".local/bin", Path("/app/bin"))
    if not any(executable == root or root in executable.parents for root in allowed):
        return None
    return {"kind": "executable", "path": str(executable)}


def excluded_client(
    client: dict[str, Any],
    available_monitor_ids: set[int] | None = None,
    runtime_roles: dict[int, int] | None = None,
    staging_token: str | None = None,
) -> bool:
    if not client.get("mapped", False):
        return True
    workspace = client.get("workspace") or {}
    runtime_monitor = strict_monitor_id(client.get("monitor"))
    if runtime_monitor is None:
        return True
    current_monitor = (
        runtime_roles.get(runtime_monitor)
        if runtime_roles is not None
        else runtime_monitor
    )
    if current_monitor is None:
        return True
    workspace_valid = (
        valid_workspace(workspace, current_monitor)
        if available_monitor_ids is None
        else valid_workspace_in_topology(
            workspace, current_monitor, available_monitor_ids
        )
    )
    if not workspace_valid and not (
        staging_token is not None
        and restore_staging_workspace(workspace, staging_token)
    ):
        return True
    combined = f"{client.get('class', '')} {client.get('initialClass', '')}".lower()
    return not norm(client.get("class")) or any(part in combined for part in EXCLUDED_CLASS_PARTS)


def stable_number(value: Any) -> int:
    try:
        return int(str(value), 16)
    except ValueError:
        return 0


def valid_terminal_address(value: Any) -> bool:
    return bool(isinstance(value, str) and re.fullmatch(r"0x[0-9A-Fa-f]+", value))


def valid_terminal_stable_id(value: Any) -> bool:
    return bool(value is not None and re.fullmatch(r"[0-9A-Fa-f]+", str(value)))


def terminal_token_digest(token: str) -> str:
    return "sha256:" + hashlib.sha256(token.encode("ascii")).hexdigest()


def valid_terminal_token(token: Any) -> bool:
    return bool(isinstance(token, str) and re.fullmatch(r"[0-9a-f]{64}", token))


def valid_terminal_token_digest(value: Any) -> bool:
    return bool(
        isinstance(value, str) and re.fullmatch(r"sha256:[0-9a-f]{64}", value)
    )


def valid_terminal_pending(value: Any, now: float) -> bool:
    if not isinstance(value, dict):
        return False
    try:
        created = float(value.get("created_at"))
        expires = float(value.get("expires_at"))
    except (TypeError, ValueError):
        return False
    preexisting = value.get("preexisting_addresses")
    sentinel = str(value.get("sentinel_title", ""))
    return bool(
        valid_terminal_token_digest(value.get("token_hash"))
        and 0 < expires - created <= TERMINAL_BINDING_TTL_SECONDS + 1.0
        and created <= now <= expires
        and isinstance(value.get("saved_window_id"), str)
        and value.get("saved_window_id")
        and isinstance(value.get("launch"), dict)
        and value["launch"].get("kind") == "terminal"
        and re.fullmatch(
            re.escape(TERMINAL_BIND_TITLE_PREFIX) + r"[0-9a-f]{64}__",
            sentinel,
        )
        and isinstance(preexisting, list)
        and len(preexisting) == len(set(preexisting))
        and all(valid_terminal_address(address) for address in preexisting)
    )


def live_terminal_clients(
    raw_clients: list[dict[str, Any]],
) -> dict[str, dict[str, Any]]:
    result: dict[str, dict[str, Any]] = {}
    duplicates: set[str] = set()
    for client in raw_clients:
        if (
            not isinstance(client, dict)
            or not client.get("mapped", False)
            or norm(client.get("class")) not in TERMINAL_CLASSES
        ):
            continue
        address = str(client.get("address", ""))
        if not valid_terminal_address(address) or not valid_terminal_stable_id(
            client.get("stableId")
        ):
            continue
        if address in result:
            duplicates.add(address)
        else:
            result[address] = client
    for address in duplicates:
        result.pop(address, None)
    return result


def terminal_session_identity_index(
    terminal_by_pid: dict[int, list[dict[str, Any]]],
) -> dict[str, dict[str, Any]]:
    candidates: list[dict[str, Any]] = []
    screen_counts: dict[str, int] = {}
    shell_counts: dict[tuple[int, int], int] = {}
    for server_pid, sessions in terminal_by_pid.items():
        for session in sessions:
            if not isinstance(session, dict) or session.get("identity_verified") is not True:
                continue
            try:
                if int(session.get("server_pid", 0) or 0) != int(server_pid):
                    continue
            except (TypeError, ValueError):
                continue
            screen = str(session.get("screen", ""))
            service = str(session.get("service", ""))
            try:
                shell_key = (
                    int(session.get("shell_pid", 0)),
                    int(session.get("shell_start", 0)),
                )
                valid_numbers = all(
                    int(session.get(key, 0)) > 0
                    for key in (
                        "server_pid",
                        "server_start",
                        "shell_pid",
                        "shell_start",
                        "tty",
                    )
                )
            except (TypeError, ValueError):
                continue
            if not valid_numbers or not valid_terminal_screen(screen) or not valid_terminal_service(service):
                continue
            candidates.append(session)
            screen_counts[screen] = screen_counts.get(screen, 0) + 1
            shell_counts[shell_key] = shell_counts.get(shell_key, 0) + 1
    return {
        str(session["screen"]): session
        for session in candidates
        if screen_counts[str(session["screen"])] == 1
        and shell_counts[(int(session["shell_pid"]), int(session["shell_start"]))] == 1
    }


def binding_matches_live_identity(
    binding: Any,
    clients_by_address: dict[str, dict[str, Any]],
    sessions_by_screen: dict[str, dict[str, Any]],
) -> bool:
    if not isinstance(binding, dict) or not valid_terminal_token_digest(
        binding.get("token_hash")
    ):
        return False
    screen = str(binding.get("screen", ""))
    service = str(binding.get("service", ""))
    address = str(binding.get("address", ""))
    stable_id = str(binding.get("stable_id", ""))
    if (
        not valid_terminal_screen(screen)
        or not valid_terminal_service(service)
        or not valid_terminal_address(address)
        or not valid_terminal_stable_id(stable_id)
    ):
        return False
    session = sessions_by_screen.get(screen)
    client = clients_by_address.get(address)
    if session is None or client is None:
        return False
    try:
        exact_numbers = all(
            int(binding.get(key, 0)) == int(session.get(key, -1))
            and int(binding.get(key, 0)) > 0
            for key in (
                "server_pid",
                "server_start",
                "shell_pid",
                "shell_start",
                "tty",
            )
        )
        client_pid = int(client.get("pid", 0) or 0)
    except (TypeError, ValueError):
        return False
    return bool(
        exact_numbers
        and service == session.get("service")
        and client_pid == int(binding["server_pid"])
        and stable_id == str(client.get("stableId", ""))
    )


def _validated_terminal_bindings(
    raw_clients: list[dict[str, Any]],
    terminal_by_pid: dict[int, list[dict[str, Any]]],
    signature: str | None = None,
    now: float | None = None,
) -> dict[str, dict[str, Any]]:
    """Return only exact live screen bindings and lazily prune stale records."""
    current_signature = signature if signature is not None else discover_signature()
    current_time = time.time() if now is None else now
    clients_by_address = live_terminal_clients(raw_clients)
    sessions_by_screen = terminal_session_identity_index(terminal_by_pid)
    with TerminalBindingLock():
        raw = load_terminal_registry_file()
        context_valid = terminal_registry_context_valid(raw, current_signature)
        registry = (
            copy.deepcopy(raw)
            if context_valid and isinstance(raw, dict)
            else empty_terminal_registry(current_signature)
        )
        old_pending = list(registry.get("pending", []))
        pending = [
            item for item in old_pending if valid_terminal_pending(item, current_time)
        ]

        candidates = []
        for item in registry.get("bindings", []):
            if binding_matches_live_identity(
                item, clients_by_address, sessions_by_screen
            ):
                candidates.append(item)
            elif isinstance(item, dict):
                # Dropping a binding silently costs the terminal its identity
                # for the rest of the session, and by shutdown the snapshot has
                # degraded to a bare shell. Say which field stopped matching.
                screen = str(item.get("screen", ""))
                session = sessions_by_screen.get(screen)
                client = clients_by_address.get(str(item.get("address", "")))
                if session is None:
                    why = f"no live session for screen …{screen[-12:]}"
                elif client is None:
                    why = f"no live client at {item.get('address')}"
                else:
                    diffs = [
                        f"{key}={item.get(key)}!={session.get(key)}"
                        for key in ("server_pid", "server_start", "shell_pid", "shell_start", "tty")
                        if int(item.get(key, 0) or 0) != int(session.get(key, -1) or -1)
                    ]
                    if str(item.get("stable_id", "")) != str(client.get("stableId", "")):
                        diffs.append(
                            f"stable_id={item.get('stable_id')}!={client.get('stableId')}"
                        )
                    why = ", ".join(diffs) or "service/pid mismatch"
                journal_note(f"terminal binding dropped: {why}")
        field_counts: dict[tuple[str, Any], int] = {}
        for item in candidates:
            for field in ("screen", "address", "stable_id", "token_hash"):
                key = (field, item.get(field))
                field_counts[key] = field_counts.get(key, 0) + 1
            shell_key = (
                "shell",
                (item.get("shell_pid"), item.get("shell_start")),
            )
            field_counts[shell_key] = field_counts.get(shell_key, 0) + 1
        bindings = [
            item
            for item in candidates
            if all(
                field_counts[(field, item.get(field))] == 1
                for field in ("screen", "address", "stable_id", "token_hash")
            )
            and field_counts[
                ("shell", (item.get("shell_pid"), item.get("shell_start")))
            ]
            == 1
        ]
        changed = bool(
            raw is not None
            and (
                not context_valid
                or pending != old_pending
                or bindings != registry.get("bindings", [])
            )
        )
        registry["pending"] = pending
        registry["bindings"] = bindings
        if changed:
            write_terminal_registry_locked(registry)
    return {str(item["screen"]): copy.deepcopy(item) for item in bindings}


def validated_terminal_bindings(
    raw_clients: list[dict[str, Any]],
    terminal_by_pid: dict[int, list[dict[str, Any]]],
    signature: str | None = None,
    now: float | None = None,
) -> dict[str, dict[str, Any]]:
    # A missing/unwritable runtime directory must disable identity reuse, not
    # abort snapshot capture.  Sentinel clients still bypass the single-window
    # shortcut below, so this fallback remains fail closed.
    try:
        return _validated_terminal_bindings(
            raw_clients, terminal_by_pid, signature=signature, now=now
        )
    except OSError:
        return {}


def capture_snapshot(
    runtime: bool = False, staging_token: str | None = None
) -> dict[str, Any]:
    """Capture compositor state for persistence or in-flight matching.

    A persistent capture always excludes reserved restore workspaces.  An
    in-flight restore may opt in only the staging clients owned by its exact
    guard token, so they can be matched and placed instead of disappearing
    from the restore algorithm.
    """
    allowed_staging_token = staging_token if runtime else None
    raw_monitors = list(hypr_json("monitors"))
    unknown_connectors = active_unconfigured_monitor_connectors(raw_monitors)
    if unknown_connectors:
        raise RuntimeError(
            "unconfigured monitor connector(s): "
            + ", ".join(sorted(set(unknown_connectors)))
        )
    initial_topology = monitor_topology_identity(raw_monitors)
    runtime_roles = live_monitor_role_map(raw_monitors)
    available_monitor_ids = {
        item_id
        for item in raw_monitors
        if isinstance(item, dict) and not item.get("disabled", False)
        for item_id in [monitor_role_id(item)]
        if item_id is not None
    }
    raw_clients = list(hypr_json("clients"))
    clients = [
        client
        for client in raw_clients
        if not excluded_client(
            client,
            available_monitor_ids,
            runtime_roles,
            allowed_staging_token,
        )
    ]

    terminal_by_pid: dict[int, list[dict[str, Any]]] = {}
    for client in raw_clients:
        if client.get("mapped", False) and norm(client.get("class")) in TERMINAL_CLASSES:
            pid = int(client.get("pid", 0) or 0)
            if pid not in terminal_by_pid:
                terminal_by_pid[pid] = terminal_sessions(pid)
    binding_by_screen = validated_terminal_bindings(
        raw_clients, terminal_by_pid, signature=discover_signature()
    )
    for pid, sessions in terminal_by_pid.items():
        raw_terminal_windows = [
            client
            for client in raw_clients
            if client.get("mapped", False)
            and norm(client.get("class")) in TERMINAL_CLASSES
            and int(client.get("pid", 0) or 0) == pid
        ]
        # One outer window is intrinsically unique and may own many tabs.  With
        # multiple Wayland clients, only a runtime ACK binding may attach a
        # GNOME screen to an address; order/title/cwd are never fallbacks.
        single_client = bool(
            len(raw_terminal_windows) == 1
            and not str(raw_terminal_windows[0].get("initialTitle", "")).startswith(
                TERMINAL_BIND_TITLE_PREFIX
            )
        )
        for client in raw_terminal_windows:
            client["_terminal_mapping_verified"] = False
        if single_client:
            for session in sessions:
                session["launch"]["_mapping_verified"] = True
            raw_terminal_windows[0]["_terminal_mapping_verified"] = True
        if single_client and sessions:
            raw_terminal_windows[0]["_terminal_launch"] = sessions[0]["launch"]
        elif raw_terminal_windows:
            windows_by_address = {
                str(client.get("address", "")): client
                for client in raw_terminal_windows
                if valid_terminal_address(str(client.get("address", "")))
            }
            claimed_addresses: set[str] = set()
            for session in sessions:
                screen = str(session.get("screen", ""))
                binding = binding_by_screen.get(screen)
                address = str((binding or {}).get("address", ""))
                client = windows_by_address.get(address)
                if (
                    binding is None
                    or client is None
                    or address in claimed_addresses
                    or int(client.get("pid", 0) or 0) != pid
                ):
                    session["launch"]["_mapping_verified"] = False
                    continue
                claimed_addresses.add(address)
                session["launch"]["_mapping_verified"] = True
                restored_for = str((binding or {}).get("saved_window_id", ""))
                if restored_for:
                    session["launch"]["_restore_window_id"] = restored_for
                client["_terminal_mapping_verified"] = True
                client["_terminal_launch"] = session["launch"]

            # A restored ACK can identify one side of a two-window terminal
            # set while a manually opened window has no registry entry.  Once
            # exact bindings have been applied, a single remaining session and
            # a single remaining Wayland client form a mathematical bijection;
            # accepting that last pair does not rely on title, process order,
            # cwd, or timing.  Any larger/ambiguous remainder stays fail-closed.
            unmatched_sessions = [
                session
                for session in sessions
                if session["launch"].get("_mapping_verified") is not True
            ]
            unmatched_clients = [
                client
                for address, client in windows_by_address.items()
                if address not in claimed_addresses
            ]
            if len(unmatched_sessions) == 1 and len(unmatched_clients) == 1:
                session = unmatched_sessions[0]
                client = unmatched_clients[0]
                session["launch"]["_mapping_verified"] = True
                client["_terminal_mapping_verified"] = True
                client["_terminal_launch"] = session["launch"]
        terminal_windows = [
            client
            for client in raw_terminal_windows
            if not excluded_client(
                client,
                available_monitor_ids,
                runtime_roles,
                allowed_staging_token,
            )
        ]
        # With one compositor client every surplus shell is unambiguously a tab
        # of that client.  Preserve it as a synthetic entry; restore may reopen
        # it as a separate window rather than silently losing terminal state.
        if (
            single_client
            and terminal_windows
            and len(raw_terminal_windows) == len(terminal_windows)
            and len(sessions) > len(raw_terminal_windows)
        ):
            template = terminal_windows[-1]
            for extra_index, session in enumerate(sessions[len(raw_terminal_windows) :], 1):
                synthetic = copy.deepcopy(template)
                synthetic["address"] = ""
                synthetic["stableId"] = f"{stable_number(template.get('stableId')) + extra_index:x}"
                synthetic["focusHistoryID"] = -1
                synthetic["title"] = "Restored terminal tab"
                synthetic["_terminal_launch"] = session["launch"]
                synthetic["_synthetic_tab"] = True
                clients.append(synthetic)

    clients.sort(
        key=lambda client: (
            int((client.get("workspace") or {}).get("id", 0) or 0),
            int((client.get("at") or [0, 0])[1]),
            int((client.get("at") or [0, 0])[0]),
            norm(client.get("class")),
            stable_number(client.get("stableId")),
        )
    )

    windows: list[dict[str, Any]] = []
    launch_groups: dict[tuple[str, int], str] = {}
    for index, client in enumerate(clients, 1):
        cls = str(client.get("class", ""))
        initial = str(client.get("initialClass", ""))
        pid = int(client.get("pid", 0) or 0)
        if norm(cls) in TERMINAL_CLASSES:
            launch = client.get("_terminal_launch") or {
                "kind": "terminal",
                "cwd": None,
                "program": "shell",
                "args": [],
                "_cwd_verified": False,
                "_mapping_verified": bool(
                    client.get("_terminal_mapping_verified", False)
                ),
                "_program_verified": False,
                "_session_verified": False,
            }
        else:
            launch = desktop_launch(cls, initial) or fallback_launch(pid)
        class_key = norm(cls) or norm(initial)
        if class_key in TERMINAL_CLASSES:
            launch_group = f"terminal-{index:04d}"
        else:
            group_key = (class_key, 0 if class_key in SINGLE_INSTANCE_CLASSES else pid)
            if group_key not in launch_groups:
                launch_groups[group_key] = f"app-{len(launch_groups) + 1:04d}"
            launch_group = launch_groups[group_key]
        workspace = client.get("workspace") or {}
        at = client.get("at") or [0, 0]
        size = client.get("size") or [800, 600]
        window: dict[str, Any] = {
            "id": f"w{index:04d}",
            "workspace": {"id": int(workspace.get("id", 1)), "name": str(workspace.get("name", "1"))},
            "class": cls,
            "initial_class": initial,
            "title": str(client.get("title", ""))[:1024],
            "initial_title": str(client.get("initialTitle", ""))[:1024],
            "monitor": runtime_roles[strict_monitor_id(client.get("monitor"))],
            "floating": bool(client.get("floating", False)),
            "pinned": bool(client.get("pinned", False)),
            "fullscreen": int(client.get("fullscreen", 0) or 0),
            "fullscreen_client": int(client.get("fullscreenClient", 0) or 0),
            "at": [int(at[0]), int(at[1])],
            "size": [max(1, int(size[0])), max(1, int(size[1]))],
            "launch": launch,
            "launch_group": launch_group,
            "synthetic_terminal_tab": bool(client.get("_synthetic_tab", False)),
        }
        if runtime:
            window["address"] = str(client.get("address", ""))
            window["pid"] = pid
        windows.append(window)

    focused = next((window for window, client in zip(windows, clients) if int(client.get("focusHistoryID", -1)) == 0), None)
    focused_monitor = next((item for item in raw_monitors if item.get("focused", False)), None)
    active_workspace = (focused_monitor or {}).get("activeWorkspace") or {}
    focused_monitor_id = monitor_role_id(focused_monitor or {})
    if focused_monitor_id is None:
        focused_monitor_id = 0
    active_workspace_name = (
        str(active_workspace.get("name", ""))
        if valid_workspace_in_topology(
            active_workspace, focused_monitor_id, available_monitor_ids
        )
        else ""
    )
    focused_is_on_active_workspace = bool(
        focused and (not active_workspace_name or focused.get("workspace", {}).get("name") == active_workspace_name)
    )
    raw_workspaces = hypr_json("workspaces")
    workspaces = sorted(
        (
            {
                "id": int(item.get("id", 0) or 0),
                "name": str(item.get("name", "")),
                "monitor": str(item.get("monitor", "")),
                "monitor_id": monitor_role_id(
                    item.get("monitorID"), item.get("monitor", "")
                )
                or 0,
                "persistent": bool(item.get("ispersistent", False)),
                "tiled_layout": str(item.get("tiledLayout", "")),
            }
            for item in raw_workspaces
            if valid_workspace_in_topology(
                item,
                monitor_role_id(item.get("monitorID"), item.get("monitor", "")),
                available_monitor_ids,
            )
        ),
        key=lambda item: item["id"],
    )
    monitor_workspaces = []
    for item in raw_monitors:
        item_monitor_id = monitor_role_id(item)
        if item_monitor_id is None:
            continue
        item_workspace = item.get("activeWorkspace") or {}
        item_workspace_name = (
            str(item_workspace.get("name", ""))
            if valid_workspace_in_topology(
                item_workspace, item_monitor_id, available_monitor_ids
            )
            else str(default_workspace_id(item_monitor_id))
        )
        monitor_workspaces.append(
            {
                "monitor": str(item.get("name", "")),
                "monitor_id": item_monitor_id,
                "focused": bool(item.get("focused", False)),
                "workspace": item_workspace_name,
            }
        )
    snapshot: dict[str, Any] = {
        "schema": SCHEMA_VERSION,
        "captured_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "workspaces": workspaces,
        "windows": windows,
        "focus": {
            "window_id": focused["id"] if focused_is_on_active_workspace else None,
            "workspace": active_workspace_name
            or (focused["workspace"]["name"] if focused else str(default_workspace_id(focused_monitor_id))),
        },
        "monitor_workspaces": monitor_workspaces,
    }
    if not runtime:
        snapshot["content_hash"] = snapshot_hash(snapshot)
    final_monitors = list(hypr_json("monitors"))
    if monitor_topology_identity(final_monitors) != initial_topology:
        raise RuntimeError("monitor topology changed during snapshot capture")
    return snapshot


def snapshot_window_monitor_role_remap(
    monitor_workspaces: list[dict[str, Any]],
) -> dict[int, int]:
    """Resolve legacy window monitor IDs through their saved connectors.

    Older snapshots stored Hyprland's transient monitor ID on each window,
    while monitor rows also retained the connector name.  A transient ID can
    numerically collide with an unrelated configured role (for example old ID
    5 on the role-2 connector), so the integer alone is never authoritative in
    managed mode.  Only unambiguous one-to-one row relationships are returned.
    """
    roles_by_runtime: dict[int, set[int]] = {}
    runtimes_by_role: dict[int, set[int]] = {}
    for item in monitor_workspaces:
        if not isinstance(item, dict) or "monitor_id" not in item:
            continue
        runtime_id = strict_monitor_id(item.get("monitor_id"))
        role_id = monitor_role_id(item.get("monitor_id"), item.get("monitor", ""))
        if runtime_id is None or role_id is None:
            continue
        roles_by_runtime.setdefault(runtime_id, set()).add(role_id)
        runtimes_by_role.setdefault(role_id, set()).add(runtime_id)

    result: dict[int, int] = {}
    for runtime_id, role_ids in roles_by_runtime.items():
        if len(role_ids) != 1:
            continue
        role_id = next(iter(role_ids))
        if len(runtimes_by_role.get(role_id, set())) == 1:
            result[runtime_id] = role_id
    return result


def normalize_snapshot_workspaces(snapshot: dict[str, Any]) -> dict[str, Any]:
    """Migrate polluted workspace IDs without dropping restorable windows."""
    value = copy.deepcopy(snapshot)
    original_workspaces = [item for item in value.get("workspaces", []) if isinstance(item, dict)]
    original_monitor_workspaces = [
        item for item in value.get("monitor_workspaces", []) if isinstance(item, dict)
    ]
    window_monitor_roles = snapshot_window_monitor_role_remap(
        original_monitor_workspaces
    )

    monitor_ids: dict[str, int] = {}
    monitor_names: dict[int, str] = {}
    explicit_monitor_names: set[str] = set()
    for item in original_workspaces:
        name = str(item.get("monitor", ""))
        if name and "monitor_id" in item:
            item_monitor_id = monitor_role_id(item.get("monitor_id"), name)
            if item_monitor_id is None:
                continue
            monitor_ids.setdefault(name, item_monitor_id)
            monitor_names.setdefault(item_monitor_id, name)
            explicit_monitor_names.add(name)
    for index, item in enumerate(original_monitor_workspaces):
        name = str(item.get("monitor", ""))
        if name and "monitor_id" in item:
            explicit_monitor_names.add(name)
        if name and name not in monitor_ids:
            item_monitor_id = monitor_role_id(item.get("monitor_id", index), name)
            if item_monitor_id is None:
                continue
            if item_monitor_id in monitor_names and monitor_names[item_monitor_id] != name:
                item_monitor_id = next(
                    (candidate for candidate in range(MAX_MONITOR_GROUPS) if candidate not in monitor_names),
                    0,
                )
            monitor_ids[name] = item_monitor_id
            monitor_names.setdefault(item_monitor_id, name)
    available_monitor_ids = {
        monitor_ids.get(
            str(item.get("monitor", "")),
            monitor_role_id(
                item.get("monitor_id", index), str(item.get("monitor", ""))
            ),
        )
        for index, item in enumerate(original_monitor_workspaces)
        if monitor_ids.get(
            str(item.get("monitor", "")),
            monitor_role_id(
                item.get("monitor_id", index), str(item.get("monitor", ""))
            ),
        )
        is not None
    }

    normalized_workspaces: list[dict[str, Any]] = []
    seen_workspace_names: set[str] = set()
    for item in original_workspaces:
        monitor_name = str(item.get("monitor", ""))
        item_monitor_id = monitor_ids.get(
            monitor_name,
            monitor_role_id(item.get("monitor_id", 0), monitor_name),
        )
        if item_monitor_id is None:
            continue
        if not valid_workspace_in_topology(
            item, item_monitor_id, available_monitor_ids
        ):
            continue
        name = str(item.get("name", ""))
        if name in seen_workspace_names:
            continue
        normalized = copy.deepcopy(item)
        if re.fullmatch(r"[0-9]+", name):
            normalized["id"] = int(name)
        if "monitor_id" in item or monitor_name in explicit_monitor_names:
            normalized["monitor_id"] = item_monitor_id
        else:
            # Key absence is meaningful: foreground planning must retain the
            # saved-active behavior for legacy snapshots instead of treating
            # an invented monitor ID 0 as authoritative metadata.
            normalized.pop("monitor_id", None)
        normalized_workspaces.append(normalized)
        seen_workspace_names.add(name)

    referenced: dict[str, int] = {}
    normalized_windows: list[dict[str, Any]] = []
    for window in value.get("windows", []):
        if not isinstance(window, dict):
            continue
        normalized = copy.deepcopy(window)
        workspace = normalized.get("workspace") or {}
        raw_monitor_id = strict_monitor_id(normalized.get("monitor"))
        if MANAGED_MONITOR_ROLES:
            item_monitor_id = (
                window_monitor_roles.get(raw_monitor_id)
                if raw_monitor_id is not None
                else None
            )
        else:
            item_monitor_id = raw_monitor_id if raw_monitor_id is not None else 0
        if item_monitor_id is None:
            # Without a connector-backed remap, guessing from the integer can
            # turn role-2 workspace 21 into role-5 workspace 51.  The window
            # row is incompatible with this managed topology; omit it instead
            # of manufacturing or restoring an ownerless placement.
            continue
        normalized["monitor"] = item_monitor_id
        if valid_workspace_in_topology(
            workspace, item_monitor_id, available_monitor_ids
        ):
            name = str(workspace.get("name", ""))
            internal_id = int(workspace.get("id", 0) or 0)
        else:
            internal_id = default_workspace_id(item_monitor_id)
            name = str(internal_id)
        normalized["workspace"] = {"id": internal_id, "name": name}
        referenced[name] = item_monitor_id
        normalized_windows.append(normalized)
    value["windows"] = normalized_windows

    normalized_monitor_workspaces: list[dict[str, Any]] = []
    for index, item in enumerate(original_monitor_workspaces):
        normalized = copy.deepcopy(item)
        name = str(normalized.get("monitor", ""))
        item_monitor_id = monitor_ids.get(name, monitor_role_id(index, name))
        if item_monitor_id is None:
            if MANAGED_MONITOR_ROLES:
                continue
            item_monitor_id = 0
        if "monitor_id" in item or name in explicit_monitor_names:
            normalized["monitor_id"] = item_monitor_id
        else:
            normalized.pop("monitor_id", None)
        workspace_name = str(normalized.get("workspace", ""))
        if not valid_workspace_name_in_topology(
            workspace_name, item_monitor_id, available_monitor_ids
        ):
            workspace_name = str(default_workspace_id(item_monitor_id))
        normalized["workspace"] = workspace_name
        referenced[workspace_name] = item_monitor_id
        normalized_monitor_workspaces.append(normalized)
    value["monitor_workspaces"] = normalized_monitor_workspaces

    for name, item_monitor_id in referenced.items():
        if name in seen_workspace_names or not re.fullmatch(r"[0-9]+", name):
            continue
        monitor_name = monitor_names.get(item_monitor_id, "")
        generated = {
            "id": int(name),
            "name": name,
            "monitor": monitor_name,
            "persistent": False,
            "tiled_layout": "dwindle",
        }
        if monitor_name in explicit_monitor_names:
            generated["monitor_id"] = item_monitor_id
        normalized_workspaces.append(generated)
        seen_workspace_names.add(name)
    value["workspaces"] = sorted(
        normalized_workspaces,
        key=lambda item: (
            int(item["name"])
            if re.fullmatch(r"[0-9]+", item["name"])
            else SERIALIZED_SPECIAL_WORKSPACE_MIN,
            item["name"],
        ),
    )

    focus = value.get("focus") if isinstance(value.get("focus"), dict) else {}
    focused_monitor = next(
        (item for item in normalized_monitor_workspaces if item.get("focused", False)),
        normalized_monitor_workspaces[0] if normalized_monitor_workspaces else None,
    )
    fallback = str((focused_monitor or {}).get("workspace") or default_workspace_id(0))
    focus_workspace = str(focus.get("workspace", ""))
    focused_monitor_id = monitor_ids.get(str((focused_monitor or {}).get("monitor", "")), 0)
    focus_owner = numeric_workspace_owner(focus_workspace)
    if (
        MANAGED_MONITOR_ROLES
        and focus_owner is not None
        and focus_owner not in STABLE_MONITOR_ROLES.values()
    ) or not valid_workspace_name_in_topology(
        focus_workspace, focused_monitor_id, available_monitor_ids
    ):
        focus_workspace = fallback
    focus["workspace"] = focus_workspace
    if focus.get("window_id") not in {str(window.get("id")) for window in normalized_windows}:
        focus["window_id"] = None
    value["focus"] = focus
    value["content_hash"] = snapshot_hash(value)
    return value


def polluted_numeric_workspace(
    workspace: Any,
    expected_monitor: Any,
    available_monitor_ids: set[int] | None = None,
) -> bool:
    """Identify generated numeric garbage without touching real scratchpads."""
    if not isinstance(workspace, dict):
        return False
    name = str(workspace.get("name", "")).strip()
    if re.fullmatch(r"-?[0-9]+", name) is None:
        return False
    if available_monitor_ids is None:
        return not valid_workspace(workspace, expected_monitor)
    # A valid 1..100 numeric ID owns a stable group. If it is physically on
    # another output, route the whole workspace instead of renaming clients.
    # Per-client migration is reserved for malformed/special/out-of-range IDs.
    return not valid_workspace(workspace) or numeric_workspace_owner(name) is None


def compositor_monitor_topology_guard(
    monitors: list[dict[str, Any]],
) -> str | None:
    """Build an exact connector/stable-role guard for one Lua transaction."""
    expected: dict[str, int] = {}
    expected_roles: set[int] = set()
    for item in monitors:
        if not isinstance(item, dict):
            return None
        if item.get("disabled", False):
            continue
        connector = str(item.get("name", item.get("monitor", "")))
        role = monitor_role_id(item)
        if (
            not connector
            or role is None
            or connector in expected
            or role in expected_roles
        ):
            return None
        expected[connector] = role
        expected_roles.add(role)
    if not expected:
        return None

    assignments = "; ".join(
        f"expected_monitor_roles[{lua_string(connector)}] = {role}"
        for connector, role in sorted(expected.items())
    )
    return (
        f"local expected_monitor_roles = {{}}; {assignments}; "
        f"local expected_monitor_count = {len(expected)}; "
        "if type(desktop_ui_monitor_role) ~= 'function' then "
        "error('stable monitor role resolver unavailable') end; "
        "local topology_monitors = hl.get_monitors(); "
        "if type(topology_monitors) ~= 'table' then "
        "error('monitor topology unavailable') end; "
        "local topology_seen = {}; local topology_count = 0; "
        "for _, topology_monitor in ipairs(topology_monitors) do "
        "local topology_connector = tostring(topology_monitor and topology_monitor.name or ''); "
        "if topology_connector == '' or topology_seen[topology_connector] then "
        "error('monitor topology contains an invalid connector') end; "
        "local expected_role = expected_monitor_roles[topology_connector]; "
        "if expected_role == nil then error('monitor topology contains an unexpected connector') end; "
        "local topology_role = desktop_ui_monitor_role(topology_connector, topology_monitor.id); "
        "if math.floor(tonumber(topology_role) or -1) ~= expected_role then "
        "error('monitor stable role changed') end; "
        "topology_seen[topology_connector] = true; topology_count = topology_count + 1; "
        "end; "
        "if topology_count ~= expected_monitor_count then error('monitor topology count changed') end; "
        "for expected_connector, _ in pairs(expected_monitor_roles) do "
        "if not topology_seen[expected_connector] then error('expected monitor disappeared') end; "
        "end"
    )


def commit_dynamic_hotplug_workspace_transaction(
    operations: list[dict[str, Any]],
    monitors: list[dict[str, Any]],
    active_window: dict[str, Any] | None,
    *,
    quiet: bool,
) -> int:
    """Commit WAL-prepared identity changes in one compositor Lua frame.

    Every destructive precondition is repeated compositor-side immediately
    before ``workspace.change_id``. A collision therefore fails closed instead
    of overwriting either workspace. A partially completed call is recovered
    from the prepare record on the next event/boot.
    """
    if not operations:
        return 0
    topology_guard = compositor_monitor_topology_guard(monitors)
    if topology_guard is None:
        if not quiet:
            eprint("hotplug workspace transaction refused: unsafe monitor topology")
        return 0
    animations_were_enabled = hypr_option_bool("animations:enabled")
    cursor_no_warps = hypr_option_bool("cursor:no_warps")
    if animations_were_enabled is None or cursor_no_warps is None:
        if not quiet:
            eprint("hotplug workspace transaction refused: compositor options unavailable")
        return 0
    statements: list[str] = []
    refocus_needed = any(
        bool(item.get("placeholder_active"))
        or bool(item.get("activate_source"))
        or item.get("kind") in {"finish-expand", "cleanup-parking"}
        or bool(item.get("parking_preexisting"))
        for item in operations
    )
    semantic_replacements: dict[str, str] = {}
    for item in operations:
        parking_identity = int(item.get("parking", 0) or 0)
        if parking_identity > 0:
            semantic_replacements[str(parking_identity)] = str(
                int(
                    item.get("focus_target")
                    or item.get("source")
                    or item.get("temporary")
                    or 1
                )
            )
        spillover_identity = int(item.get("spillover", 0) or 0)
        if item.get("kind") == "spill-expand" and spillover_identity > 0:
            # If another operation in this batch needs an explicit focus
            # restore, the active colliding source now has this new identity.
            semantic_replacements[str(int(item.get("source", 0) or 0))] = str(
                spillover_identity
            )
        if bool(item.get("activate_source")):
            activation_guard = int(item.get("activation_guard", 0) or 0)
            if activation_guard > 0:
                semantic_replacements[str(activation_guard)] = str(
                    int(item.get("source", 0) or 0)
                )

    def dispatch(expression: str, label: str) -> None:
        variable = f"hotplug_result_{len(statements)}"
        statements.append(f"local {variable} = hl.dispatch({expression})")
        statements.append(
            f"if not ({variable} and {variable}.ok) then "
            f"error(({variable} and {variable}.error) or {lua_string(label)}) end"
        )

    def focus_workspace(connector: Any, workspace: int, label: str) -> None:
        if connector:
            dispatch(
                f"hl.dsp.focus({{ monitor = {lua_string(connector)} }})",
                f"{label} monitor focus failed",
            )
        dispatch(
            "hl.dsp.focus({ "
            f"workspace = {lua_string(workspace_selector(workspace))}, on_current_monitor = true "
            "})",
            f"{label} workspace focus failed",
        )

    for index, operation in enumerate(operations):
        kind = str(operation.get("kind", ""))
        source = int(operation.get("source", 0) or 0)
        temporary = int(operation.get("temporary", 0) or 0)
        parking = int(operation.get("parking", 0) or 0)
        spillover = int(operation.get("spillover", 0) or 0)
        activate_source = bool(operation.get("activate_source", False))
        activation_guard = int(operation.get("activation_guard", 0) or 0)
        source_selector = lua_string(workspace_selector(source))
        temporary_selector = lua_string(workspace_selector(temporary))
        parking_selector = lua_string(workspace_selector(parking)) if parking else ""
        spillover_selector = lua_string(workspace_selector(spillover)) if spillover else ""
        activation_guard_selector = (
            lua_string(workspace_selector(activation_guard)) if activation_guard else ""
        )
        source_variable = f"hotplug_source_{index}"
        temporary_variable = f"hotplug_temporary_{index}"
        parking_variable = f"hotplug_parking_{index}"
        spillover_variable = f"hotplug_spillover_{index}"
        if activate_source:
            guard_variable = f"hotplug_activation_guard_{index}"
            statements.extend(
                [
                    f"local {guard_variable} = hl.get_workspace({activation_guard_selector})",
                    f"if not {guard_variable} then error('activation guard disappeared') end",
                    f"if not {guard_variable}.active then error('activation guard is no longer active') end",
                    f"local hotplug_guard_windows_{index} = hl.get_workspace_windows({activation_guard_selector})",
                    f"if type(hotplug_guard_windows_{index}) ~= 'table' then error('activation guard clients unavailable') end",
                    f"if next(hotplug_guard_windows_{index}) ~= nil then error('activation guard became occupied') end",
                ]
            )
        if kind == "merge":
            statements.extend(
                [
                    f"local {source_variable} = hl.get_workspace({source_selector})",
                    f"local {temporary_variable} = hl.get_workspace({temporary_selector})",
                    f"if not {source_variable} then error('merge source disappeared') end",
                    f"if {temporary_variable} then error('merge target became occupied') end",
                ]
            )
            dispatch(
                "hl.dsp.workspace.change_id({ "
                f"workspace = {source_selector}, id = {temporary} "
                "})",
                "workspace merge rename failed",
            )
            statements.extend(
                [
                    f"if hl.get_workspace({source_selector}) then error('merge source identity survived') end",
                    f"if not hl.get_workspace({temporary_selector}) then error('merge target identity missing') end",
                ]
            )
        elif kind == "spill-expand":
            statements.extend(
                [
                    f"local {temporary_variable} = hl.get_workspace({temporary_selector})",
                    f"local {source_variable} = hl.get_workspace({source_selector})",
                    f"local {spillover_variable} = hl.get_workspace({spillover_selector})",
                    f"if not {temporary_variable} then error('spill expand temporary identity disappeared') end",
                    f"if {temporary_variable}.active then error('spill expand temporary became active') end",
                ]
            )
            if operation.get("spillover_preexisting"):
                statements.extend(
                    [
                        f"if {source_variable} then error('spill expand source became occupied') end",
                        f"if not {spillover_variable} then error('journaled spillover identity disappeared') end",
                    ]
                )
            else:
                statements.extend(
                    [
                        f"if not {source_variable} then error('spill expand source disappeared') end",
                        f"if {spillover_variable} then error('spillover target became occupied') end",
                        f"local hotplug_source_windows_{index} = hl.get_workspace_windows({source_selector})",
                        f"if type(hotplug_source_windows_{index}) ~= 'table' then error('spill source clients unavailable') end",
                        f"if next(hotplug_source_windows_{index}) == nil then error('spill source became empty') end",
                    ]
                )
                dispatch(
                    "hl.dsp.workspace.change_id({ "
                    f"workspace = {source_selector}, id = {spillover} "
                    "})",
                    "occupied source spillover rename failed",
                )
                statements.extend(
                    [
                        f"if hl.get_workspace({source_selector}) then error('spill source identity survived') end",
                        f"if not hl.get_workspace({spillover_selector}) then error('spillover identity missing') end",
                    ]
                )
            dispatch(
                "hl.dsp.workspace.change_id({ "
                f"workspace = {temporary_selector}, id = {source} "
                "})",
                "workspace spill expansion rename failed",
            )
            statements.extend(
                [
                    f"if hl.get_workspace({temporary_selector}) then error('spill temporary identity survived') end",
                    f"if not hl.get_workspace({source_selector}) then error('spill expanded source missing') end",
                ]
            )
            dispatch(
                "hl.dsp.workspace.move({ "
                f"workspace = {source_selector}, monitor = {lua_string(operation.get('source_connector', ''))} "
                "})",
                "spill expanded workspace routing failed",
            )
            if activate_source:
                focus_workspace(operation.get("source_connector", ""), source, "source activation")
                statements.append(
                    f"if not hl.get_workspace({source_selector}).active then error('source activation failed') end"
                )
        elif kind == "expand":
            statements.extend(
                [
                    f"local {temporary_variable} = hl.get_workspace({temporary_selector})",
                    f"local {source_variable} = hl.get_workspace({source_selector})",
                    f"if not {temporary_variable} then error('expand temporary identity disappeared') end",
                    f"if {temporary_variable}.active then error('expand temporary became active') end",
                ]
            )
            if parking and operation.get("parking_preexisting"):
                statements.extend(
                    [
                        f"local {parking_variable} = hl.get_workspace({parking_selector})",
                        f"if {source_variable} then error('expand source became occupied') end",
                        f"if not {parking_variable} then error('journaled parking identity disappeared') end",
                        f"local hotplug_parking_windows_{index} = hl.get_workspace_windows({parking_selector})",
                        f"if type(hotplug_parking_windows_{index}) ~= 'table' then error('journaled parking clients unavailable') end",
                        f"if next(hotplug_parking_windows_{index}) ~= nil then error('journaled parking became occupied') end",
                    ]
                )
            elif parking:
                statements.extend(
                    [
                        f"if not {source_variable} then error('expand placeholder disappeared') end",
                        f"local hotplug_source_windows_{index} = hl.get_workspace_windows({source_selector})",
                        f"if type(hotplug_source_windows_{index}) ~= 'table' then error('expand source clients unavailable') end",
                        f"if next(hotplug_source_windows_{index}) ~= nil then error('expand source became occupied') end",
                        f"if hl.get_workspace({parking_selector}) then error('expand parking id became occupied') end",
                    ]
                )
                dispatch(
                    "hl.dsp.workspace.change_id({ "
                    f"workspace = {source_selector}, id = {parking} "
                    "})",
                    "workspace placeholder parking failed",
                )
                statements.extend(
                    [
                        f"if hl.get_workspace({source_selector}) then error('source placeholder survived parking') end",
                        f"if not hl.get_workspace({parking_selector}) then error('parked placeholder missing') end",
                    ]
                )
            else:
                statements.append(
                    f"if {source_variable} then error('expand source became occupied') end"
                )
            dispatch(
                "hl.dsp.workspace.change_id({ "
                f"workspace = {temporary_selector}, id = {source} "
                "})",
                "workspace expansion rename failed",
            )
            statements.extend(
                [
                    f"if hl.get_workspace({temporary_selector}) then error('temporary identity survived expansion') end",
                    f"if not hl.get_workspace({source_selector}) then error('expanded source identity missing') end",
                ]
            )
            dispatch(
                "hl.dsp.workspace.move({ "
                f"workspace = {source_selector}, monitor = {lua_string(operation.get('source_connector', ''))} "
                "})",
                "expanded workspace routing failed",
            )
            if parking or operation.get("placeholder_active"):
                focus_workspace(operation.get("source_connector", ""), source, "source")
            elif activate_source:
                focus_workspace(operation.get("source_connector", ""), source, "source activation")
                statements.append(
                    f"if not hl.get_workspace({source_selector}).active then error('source activation failed') end"
                )
            if parking:
                statements.append(
                    f"if hl.get_workspace({parking_selector}) then error('parking cleanup incomplete') end"
                )
        elif kind == "finish-expand":
            statements.extend(
                [
                    f"local {source_variable} = hl.get_workspace({source_selector})",
                    f"local {parking_variable} = hl.get_workspace({parking_selector})",
                    f"if not {source_variable} then error('finished source disappeared') end",
                    f"if not {parking_variable} then error('finished parking disappeared') end",
                    f"local hotplug_parking_windows_{index} = hl.get_workspace_windows({parking_selector})",
                    f"if type(hotplug_parking_windows_{index}) ~= 'table' then error('finished parking clients unavailable') end",
                    f"if next(hotplug_parking_windows_{index}) ~= nil then error('finished parking became occupied') end",
                ]
            )
            dispatch(
                "hl.dsp.workspace.move({ "
                f"workspace = {source_selector}, monitor = {lua_string(operation.get('source_connector', ''))} "
                "})",
                "finished source routing failed",
            )
            focus_workspace(operation.get("source_connector", ""), parking, "parking cleanup")
            focus_workspace(operation.get("source_connector", ""), source, "finished source")
            statements.append(
                f"if hl.get_workspace({parking_selector}) then error('finished parking cleanup incomplete') end"
            )
        elif kind == "cleanup-parking":
            target = int(operation.get("focus_target", 0) or 0)
            target_selector = lua_string(workspace_selector(target))
            statements.extend(
                [
                    f"local {parking_variable} = hl.get_workspace({parking_selector})",
                    f"if not {parking_variable} then error('cleanup parking disappeared') end",
                    f"local hotplug_parking_windows_{index} = hl.get_workspace_windows({parking_selector})",
                    f"if type(hotplug_parking_windows_{index}) ~= 'table' then error('cleanup parking clients unavailable') end",
                    f"if next(hotplug_parking_windows_{index}) ~= nil then error('cleanup parking became occupied') end",
                    f"if not hl.get_workspace({target_selector}) then error('cleanup focus target disappeared') end",
                ]
            )
            focus_workspace(operation.get("focus_connector", ""), parking, "parking cleanup")
            focus_workspace(operation.get("focus_connector", ""), target, "parking cleanup target")
            statements.append(
                f"if hl.get_workspace({parking_selector}) then error('parking cleanup incomplete') end"
            )
        elif kind == "route-source":
            statements.extend(
                [
                    f"local {source_variable} = hl.get_workspace({source_selector})",
                    f"if not {source_variable} then error('routed source disappeared') end",
                    f"if {source_variable}.active then error('routed source became active') end",
                ]
            )
            dispatch(
                "hl.dsp.workspace.move({ "
                f"workspace = {source_selector}, monitor = {lua_string(operation.get('source_connector', ''))} "
                "})",
                "source workspace routing failed",
            )
            if activate_source:
                focus_workspace(operation.get("source_connector", ""), source, "source activation")
                statements.append(
                    f"if not hl.get_workspace({source_selector}).active then error('source activation failed') end"
                )
        elif kind == "activate-source":
            statements.append(f"local {source_variable} = hl.get_workspace({source_selector})")
            statements.append(
                f"if not {source_variable} then error('activation source disappeared') end"
            )
            focus_workspace(operation.get("source_connector", ""), source, "source activation")
            statements.append(
                f"if not hl.get_workspace({source_selector}).active then error('source activation failed') end"
            )
        elif kind == "activate-monitor-workspace":
            focus_workspace(operation.get("source_connector", ""), source, "monitor activation")
            statements.extend(
                [
                    f"if not hl.get_workspace({source_selector}) then error('monitor activation target missing') end",
                    f"if not hl.get_workspace({source_selector}).active then error('monitor activation failed') end",
                    f"if hl.get_workspace({activation_guard_selector}) then error('empty invalid workspace survived activation') end",
                ]
            )
        else:
            return 0

    recovery_focus_expressions: list[str] = []
    if refocus_needed:
        original_monitor = next(
            (item for item in monitors if isinstance(item, dict) and item.get("focused", False)),
            None,
        )
        original_monitor_name = str((original_monitor or {}).get("name", ""))
        original_workspace = str(
            (((original_monitor or {}).get("activeWorkspace") or {}).get("name", ""))
        )
        original_workspace = semantic_replacements.get(original_workspace, original_workspace)
        if original_monitor_name:
            monitor_expression = (
                f"hl.dsp.focus({{ monitor = {lua_string(original_monitor_name)} }})"
            )
            recovery_focus_expressions.append(monitor_expression)
            dispatch(
                monitor_expression,
                "original monitor focus restore failed",
            )
        if valid_workspace_name(original_workspace):
            workspace_expression = (
                "hl.dsp.focus({ "
                f"workspace = {lua_string(workspace_selector(original_workspace))}, on_current_monitor = true "
                "})"
            )
            recovery_focus_expressions.append(workspace_expression)
            dispatch(
                workspace_expression,
                "original workspace focus restore failed",
            )
        active_address = str((active_window or {}).get("address", ""))
        if re.fullmatch(r"0x[0-9A-Fa-f]+", active_address):
            window_expression = (
                f"hl.dsp.focus({{ window = {lua_string('address:' + active_address)} }})"
            )
            recovery_focus_expressions.append(window_expression)
            dispatch(
                window_expression,
                "original window focus restore failed",
            )

    animations_literal = "true" if animations_were_enabled else "false"
    no_warps_literal = "true" if cursor_no_warps else "false"
    body = "; ".join(statements)
    code = (
        f"local expected_animations = {animations_literal}; "
        f"local expected_no_warps = {no_warps_literal}; "
        "local current_animations, animations_error = hl.get_config('animations.enabled'); "
        "local current_no_warps, cursor_error = hl.get_config('cursor.no_warps'); "
        "if type(current_animations) ~= 'boolean' or current_animations ~= expected_animations then "
        "error(animations_error or 'animation state unavailable or changed') end; "
        "if type(current_no_warps) ~= 'boolean' or current_no_warps ~= expected_no_warps then "
        "error(cursor_error or 'cursor state unavailable or changed') end; "
        "local ok, err = pcall(function() "
        f"{topology_guard}; "
        "hl.config({ animations = { enabled = false }, cursor = { no_warps = true } }); "
        "if hl.get_config('animations.enabled') ~= false then error('animation suppression failed') end; "
        "if hl.get_config('cursor.no_warps') ~= true then error('cursor suppression failed') end; "
        f"{body} end); "
        "hl.config({ animations = { enabled = expected_animations }, cursor = { no_warps = expected_no_warps } }); "
        "if hl.get_config('animations.enabled') ~= expected_animations then error('animation restore failed') end; "
        "if hl.get_config('cursor.no_warps') ~= expected_no_warps then error('cursor restore failed') end; "
        "if not ok then error(err) end; return true"
    )
    ok = eval_lua(code, quiet=quiet)
    if ok:
        return len(operations)
    # A timed-out IPC may have applied the mutation. Restore lifecycle options
    # independently; the WAL/post-state verifier determines operation success.
    recovery_focus_body = best_effort_dispatch_body(recovery_focus_expressions)
    recovery = (
        "local rollback_ok = true; local focus_ok = pcall(function() "
        f"{topology_guard}; "
        "hl.config({ animations = { enabled = false }, cursor = { no_warps = true } }); "
        f"{recovery_focus_body} end); if not focus_ok then rollback_ok = false end; "
        f"hl.config({{ animations = {{ enabled = {animations_literal} }}, "
        f"cursor = {{ no_warps = {no_warps_literal} }} }}); "
        f"if hl.get_config('animations.enabled') ~= {animations_literal} then error('animation recovery failed') end; "
        f"if hl.get_config('cursor.no_warps') ~= {no_warps_literal} then error('cursor recovery failed') end; "
        "if not rollback_ok then error('focus recovery failed') end; "
        "return true"
    )
    eval_lua(recovery, quiet=True)
    return 0


def translate_saved_hotplug_workspaces(
    saved_state: dict[str, Any],
    hotplug_state: dict[str, Any] | None,
    live_monitors: list[dict[str, Any]],
) -> dict[str, Any]:
    """Translate a single-monitor snapshot before a returned-HDMI restore.

    Applications are launched directly into their durable 11..20 identities;
    there is no visible boot-time launch into 1..10 followed by a second move.
    """
    value = copy.deepcopy(saved_state)
    journal = normalize_hotplug_workspace_state(hotplug_state)
    connector_by_role = {
        role: str(item.get("name", ""))
        for item in live_monitors
        if isinstance(item, dict) and not item.get("disabled", False)
        for role in [monitor_role_id(item)]
        if role is not None and str(item.get("name", ""))
    }
    windows = [item for item in value.get("windows", []) if isinstance(item, dict)]
    workspace_rows = [item for item in value.get("workspaces", []) if isinstance(item, dict)]
    monitor_rows = [
        item for item in value.get("monitor_workspaces", []) if isinstance(item, dict)
    ]

    for mapping in journal["mappings"]:
        source_role = int(mapping["source_role"])
        if source_role not in connector_by_role:
            continue
        source = str(mapping["source"])
        temporary = str(mapping["temporary"])
        if temporary == "0":
            continue
        temporary_windows = [
            item
            for item in windows
            if str((item.get("workspace") or {}).get("name", "")) == temporary
        ]
        source_windows = [
            item
            for item in windows
            if str((item.get("workspace") or {}).get("name", "")) == source
        ]
        source_row = next(
            (item for item in workspace_rows if str(item.get("name", "")) == source),
            None,
        )
        temporary_row = next(
            (item for item in workspace_rows if str(item.get("name", "")) == temporary),
            None,
        )
        if (
            not temporary_windows
            or source_windows
            or (source_row is not None and bool(source_row.get("persistent", False)))
        ):
            # Both identities containing windows is an ambiguous collision.
            continue
        source_connector = connector_by_role[source_role]
        host_role = int(mapping["host_role"])
        host_connector = connector_by_role.get(
            host_role, str(mapping.get("host_connector", ""))
        )
        for window in temporary_windows:
            window["workspace"] = {"id": int(source), "name": source}
            window["monitor"] = source_role

        workspace_rows = [
            item
            for item in workspace_rows
            if str(item.get("name", "")) not in {source, temporary}
        ]
        translated_row = copy.deepcopy(temporary_row or source_row or {})
        translated_row.update(
            {
                "id": int(source),
                "name": source,
                "monitor": source_connector,
                "monitor_id": source_role,
            }
        )
        workspace_rows.append(translated_row)

        host_active = next(
            (
                item
                for item in monitor_rows
                if str(item.get("monitor", "")) == host_connector
                and str(item.get("workspace", "")) == temporary
            ),
            None,
        )
        source_active = next(
            (
                item
                for item in monitor_rows
                if str(item.get("monitor", "")) == source_connector
            ),
            None,
        )
        was_focused = bool((host_active or {}).get("focused", False))
        if host_active is not None:
            host_candidates = sorted(
                {
                    int(str(item.get("name", "")))
                    for item in workspace_rows
                    if re.fullmatch(r"[0-9]+", str(item.get("name", "")))
                    and numeric_workspace_owner(item.get("name")) == host_role
                    and str(item.get("name", "")) != temporary
                }
            )
            host_active["workspace"] = str(
                host_candidates[0] if host_candidates else default_workspace_id(host_role)
            )
            host_active["focused"] = False
        if source_active is None:
            source_active = {
                "monitor": source_connector,
                "monitor_id": source_role,
                "workspace": source,
                "focused": was_focused,
            }
            monitor_rows.append(source_active)
        else:
            source_active["workspace"] = source
            source_active["monitor_id"] = source_role
            source_active["focused"] = was_focused or bool(source_active.get("focused", False))
        focus = value.get("focus") if isinstance(value.get("focus"), dict) else {}
        if str(focus.get("workspace", "")) == temporary:
            focus["workspace"] = source
        value["focus"] = focus

    value["windows"] = windows
    value["workspaces"] = sorted(
        workspace_rows,
        key=lambda item: (
            int(item.get("name", 0))
            if re.fullmatch(r"[0-9]+", str(item.get("name", "")))
            else SERIALIZED_SPECIAL_WORKSPACE_MIN,
            str(item.get("name", "")),
        ),
    )
    value["monitor_workspaces"] = monitor_rows
    value["content_hash"] = snapshot_hash(value)
    return value


def plan_workspace_group_routes(
    monitors: list[dict[str, Any]], workspaces: list[dict[str, Any]]
) -> dict[str, Any]:
    """Plan silent owner-output routing without touching an active workspace."""
    unknown_connectors = active_unconfigured_monitor_connectors(monitors)
    if unknown_connectors:
        return {
            "routes": [],
            "deferred": [],
            "unconfigured_connectors": unknown_connectors,
        }
    monitor_by_id = {
        item_id: str(item.get("name", ""))
        for item in monitors
        if isinstance(item, dict) and not item.get("disabled", False)
        for item_id in [monitor_role_id(item)]
        if item_id is not None and str(item.get("name", ""))
    }
    active_names = {
        str((item.get("activeWorkspace") or {}).get("name", ""))
        for item in monitors
        if isinstance(item, dict) and not item.get("disabled", False)
    }
    routes: list[dict[str, Any]] = []
    deferred: list[dict[str, Any]] = []
    for workspace in workspaces:
        if not isinstance(workspace, dict) or not valid_workspace(workspace):
            continue
        name = str(workspace.get("name", ""))
        owner = numeric_workspace_owner(name)
        current = monitor_role_id(workspace.get("monitorID"), workspace.get("monitor", ""))
        target_monitor = monitor_by_id.get(owner) if owner is not None else None
        if target_monitor is None or current == owner:
            continue
        route = {
            "workspace": name,
            "from_monitor": str(workspace.get("monitor", "")),
            "to_monitor": target_monitor,
            "owner_id": owner,
        }
        (deferred if name in active_names else routes).append(route)
    key = lambda item: (
        int(item["workspace"]),
        str(item["to_monitor"]),
    )
    return {"routes": sorted(routes, key=key), "deferred": sorted(deferred, key=key)}


def snapshot_hotplug_fence() -> dict[str, Any]:
    """Return a fail-closed routing fence for any snapshot writer.

    The daemon's pending bit is only an optimization. Manual saves and other
    processes must independently prove that no workspace is waiting to return
    to its owner output before capture and again immediately before commit.
    """
    monitors_before = [
        item for item in hypr_json("monitors") if isinstance(item, dict)
    ]
    workspaces = [
        item for item in hypr_json("workspaces") if isinstance(item, dict)
    ]
    monitors_after = [
        item for item in hypr_json("monitors") if isinstance(item, dict)
    ]
    topology_stable = (
        monitor_topology_identity(monitors_before)
        == monitor_topology_identity(monitors_after)
    )
    unknown_connectors = active_unconfigured_monitor_connectors(monitors_after)
    if unknown_connectors:
        return {
            "routes": [],
            "deferred": [],
            "dynamic_operations": [],
            "dynamic_deferred": [],
            "dynamic_collisions": [],
            "dynamic_blocked": [],
            "hotplug_pending": True,
            "topology_stable": topology_stable,
            "settling": True,
            "reason": "unconfigured-monitor",
            "unconfigured_connectors": unknown_connectors,
        }
    plan = plan_workspace_group_routes(monitors_after, workspaces)
    hotplug_state = load_hotplug_workspace_state()
    dynamic_plan = plan_dynamic_hotplug_workspaces(
        monitors_after,
        workspaces,
        hotplug_state,
    )
    dynamic_pending = bool(dynamic_plan.get("pending", False)) or not hotplug_workspace_state_equal(
        dynamic_plan.get("state"), hotplug_state
    )
    return {
        **plan,
        "dynamic_operations": list(dynamic_plan.get("operations", [])),
        "dynamic_deferred": list(dynamic_plan.get("deferred", [])),
        "dynamic_collisions": list(dynamic_plan.get("collisions", [])),
        "dynamic_blocked": list(dynamic_plan.get("blocked", [])),
        "hotplug_pending": dynamic_pending,
        "topology_stable": topology_stable,
        "settling": not topology_stable
        or bool(plan["routes"] or plan["deferred"])
        or dynamic_pending,
    }


def hotplug_settling_save_outcome(
    fence: dict[str, Any], stage: str
) -> dict[str, Any]:
    return {
        "ok": True,
        "saved": False,
        "reason": "hotplug-settling",
        "stage": stage,
        "retry_after": 2,
        "routes": len(fence.get("routes", [])),
        "deferred": len(fence.get("deferred", [])),
        "hotplug_pending": bool(fence.get("hotplug_pending", False)),
        "topology_stable": bool(fence.get("topology_stable", False)),
    }


def hotplug_route_event_action(event_name: str, pending: bool) -> str:
    """Pure event policy used by the daemon's one-shot hotplug reconciler."""
    if event_name in {"monitoradded", "monitoraddedv2"}:
        return "schedule"
    if event_name in {"monitorremoved", "monitorremovedv2"}:
        return "schedule"
    if event_name in {
        "closewindow",
        "destroyworkspace",
        "destroyworkspacev2",
        "changeworkspaceid",
        "changeworkspaceidv2",
    }:
        # A closed collision or newly freed host slot may unblock a durable
        # mapping even when the previous attempt was safely non-pending.
        return "schedule"
    if pending and event_name in HOTPLUG_FOLLOWUP_EVENTS:
        # Workspace/focus events only advance an existing hotplug transaction.
        # Scheduling them while idle would gate every normal workspace switch;
        # monitoradded and daemon startup already discover foreign placeholders.
        return "schedule"
    return "none"


def hotplug_event_signature(
    event_name: str, event_data: str
) -> tuple[str, str] | None:
    """Collapse Hyprland's v1/v2 physical event pair to one connector key."""
    if event_name not in HOTPLUG_MONITOR_EVENTS:
        return None
    fields = [field.strip() for field in str(event_data).split(",")]
    connector = fields[1] if event_name.endswith("v2") and len(fields) > 1 else fields[0]
    kind = "added" if event_name.startswith("monitoradded") else "removed"
    return (kind, connector) if connector else None


def schedule_hotplug_deadline(
    current: float | None, event_time: float, *, immediate: bool
) -> float:
    """Schedule early and never let a later event postpone an existing pass."""
    candidate = event_time if immediate else event_time + HOTPLUG_SETTLE_SECONDS
    return candidate if current is None else min(current, candidate)


def duplicate_hotplug_event(
    signature: tuple[str, str] | None,
    previous: tuple[str, str] | None,
    event_time: float,
    previous_time: float,
    pending: bool,
) -> bool:
    """Coalesce the v1/v2 pair without hiding a later real cable event."""
    return bool(
        pending
        and signature is not None
        and signature == previous
        and event_time - previous_time <= HOTPLUG_EVENT_COALESCE_SECONDS
    )


def hotplug_topology_ready(
    signature: tuple[str, str] | None,
    monitors: list[dict[str, Any]],
) -> bool:
    """Fence a speculative mutation until the event is visible in topology."""
    if signature is None or not signature[1]:
        return False
    active = {
        str(item.get("name", ""))
        for item in monitors
        if isinstance(item, dict) and not item.get("disabled", False)
    }
    kind, connector = signature
    return connector in active if kind == "added" else connector not in active


def retain_hotplug_probe(
    signature: tuple[str, str] | None, result: dict[str, Any]
) -> tuple[str, str] | None:
    """Keep the physical fence until the compositor confirms that topology."""
    if signature is not None and bool(result.get("expected_hotplug_ready", False)):
        return None
    return signature


def set_hotplug_ui_gate(current: bool, requested: bool) -> bool:
    """Edge-trigger the shell presentation gate for one hotplug lifecycle.

    Treat an IPC attempt as the state transition even when its acknowledgement
    is lost: retrying ``start`` can create a nested shell generation, while the
    shell's safety timer already covers a genuinely lost ``finish``.
    """
    target = bool(requested)
    if bool(current) == target:
        return target
    notify_ui_hotplug(target)
    return target


def hotplug_retry_delay(attempt: int, hint: Any = 1) -> float:
    """Bounded retry: a live restore can delay routing but never strand it."""
    try:
        base = max(0.25, float(hint))
    except (TypeError, ValueError):
        base = 1.0
    return min(HOTPLUG_MAX_RETRY_SECONDS, base * (2 ** min(max(attempt - 1, 0), 5)))


def hotplug_route_followup(
    result: dict[str, Any], retries: int = 0, *, speculative: bool = False
) -> dict[str, Any]:
    """Plan the next daemon pass without releasing presentation too early.

    A successful compositor mutation can enqueue ``changeworkspaceid`` and
    ``workspace`` events after the synchronous IPC reply. Keep the existing
    UI gate for one short, non-mutating quiet pass so those events cannot
    create a visible finish/start pair. Logical deferrals and failures retain
    their existing bounded retry policy.
    """
    ok = bool(result.get("ok", False))
    logical_pending = bool(
        result.get("deferred") or result.get("hotplug_pending", False)
    )
    try:
        dispatches = max(0, int(result.get("dispatches", 0) or 0))
    except (TypeError, ValueError):
        dispatches = 0

    if result.get("reason") == "topology-not-ready":
        next_retries = max(0, int(retries)) + 1
        fast = next_retries <= HOTPLUG_TOPOLOGY_FAST_RETRIES
        return {
            "pending": True,
            "quiet_pass": False,
            "topology_verify": True,
            "logical_pending": True,
            "retries": next_retries,
            "delay": HOTPLUG_SETTLE_SECONDS
            if fast
            else hotplug_retry_delay(
                next_retries - HOTPLUG_TOPOLOGY_FAST_RETRIES,
                result.get("retry_after", 1),
            ),
        }

    # A physical monitor event is attempted in the same event-loop turn. The
    # compositor may publish it just before its workspace bookkeeping becomes
    # queryable, so every first attempt gets exactly one fixed 50 ms verify:
    # a mutation drains its queued events; a no-op/error retries the topology.
    if speculative:
        return {
            "pending": True,
            "quiet_pass": ok and not logical_pending and dispatches > 0,
            "topology_verify": not (ok and not logical_pending and dispatches > 0),
            "logical_pending": logical_pending,
            "retries": 0,
            "delay": HOTPLUG_SETTLE_SECONDS,
        }

    if ok and not logical_pending and dispatches > 0:
        return {
            "pending": True,
            "quiet_pass": True,
            "logical_pending": False,
            "retries": 0,
            "delay": HOTPLUG_SETTLE_SECONDS,
        }
    if ok and not logical_pending:
        return {
            "pending": False,
            "quiet_pass": False,
            "logical_pending": False,
            "retries": 0,
            "delay": None,
        }

    next_retries = max(0, int(retries)) + 1
    return {
        "pending": True,
        "quiet_pass": False,
        "logical_pending": logical_pending,
        "retries": next_retries,
        "delay": hotplug_retry_delay(
            next_retries, result.get("retry_after", 1)
        ),
    }


def daemon_wait_targets(
    next_safety: float,
    due: float | None,
    hotplug_due: float | None,
    hotplug_pending: bool,
    last_save: float,
    current_interval: float,
    next_reconcile_allowed: float,
) -> list[float]:
    """Pure deadline selection; pending routing parks an expired save due."""
    targets = [next_safety]
    if due is not None and not hotplug_pending:
        targets.append(max(due, last_save + current_interval, next_reconcile_allowed))
    if hotplug_due is not None:
        targets.append(hotplug_due)
    return targets


def compositor_focus_signature(
    monitors: list[dict[str, Any]], active_window: dict[str, Any] | None
) -> tuple[tuple[tuple[str, str, bool], ...], str]:
    visible = tuple(
        sorted(
            (
                str(item.get("name", "")),
                str((item.get("activeWorkspace") or {}).get("name", "")),
                bool(item.get("focused", False)),
            )
            for item in monitors
            if isinstance(item, dict) and not item.get("disabled", False)
        )
    )
    return visible, str((active_window or {}).get("address", ""))


def focused_pointer_signature(
    monitors: list[dict[str, Any]], active_window: dict[str, Any] | None
) -> tuple[str, str, str]:
    """Capture global monitor, its visible workspace, and focused client."""
    focused = next(
        (
            item
            for item in monitors
            if isinstance(item, dict) and item.get("focused", False)
        ),
        {},
    )
    return (
        str(focused.get("name", "")),
        str((focused.get("activeWorkspace") or {}).get("name", "")),
        str((active_window or {}).get("address", "")),
    )


def repair_topology_signature(
    monitors: list[dict[str, Any]],
    workspaces: list[dict[str, Any]],
    clients: list[dict[str, Any]],
    active_window: dict[str, Any] | None,
) -> tuple[Any, ...]:
    """Fence a resume-repair plan against a concurrent hotplug reroute."""
    monitor_state = tuple(
        sorted(
            (
                monitor_role_id(item)
                if monitor_role_id(item) is not None else -1,
                str(item.get("name", "")),
                str((item.get("activeWorkspace") or {}).get("name", "")),
                bool(item.get("focused", False)),
            )
            for item in monitors
            if isinstance(item, dict) and not item.get("disabled", False)
        )
    )
    client_state = tuple(
        sorted(
            (
                str(item.get("address", "")),
                strict_monitor_id(item.get("monitor"))
                if strict_monitor_id(item.get("monitor")) is not None else -1,
                str((item.get("workspace") or {}).get("name", "")),
                bool(item.get("mapped", False)),
            )
            for item in clients
            if isinstance(item, dict) and item.get("mapped", False)
        )
    )
    workspace_state = tuple(
        sorted(
            (
                str(item.get("name", "")),
                str(item.get("monitor", "")),
                monitor_role_id(item.get("monitorID"), item.get("monitor", ""))
                if monitor_role_id(
                    item.get("monitorID"), item.get("monitor", "")
                ) is not None else -1,
            )
            for item in workspaces
            if isinstance(item, dict) and valid_workspace(item)
        )
    )
    return (
        monitor_state,
        workspace_state,
        client_state,
        str((active_window or {}).get("address", "")),
    )


def reconcile_hotplug_restore_marker_locked() -> bool | None:
    """Complete a missing-monitor restore after silent owner routing verifies.

    This never launches, focuses, or moves anything. It only removes snapshot
    protection after the returned topology and all saved placements are now
    independently observable.
    """
    marker = load_json(MARKER_FILE)
    if (
        not marker
        or marker.get("complete") is True
        or marker.get("protect_snapshot") is not True
        or not marker.get("missing_live_monitors")
        or marker.get("restore_error")
        or marker.get("repair_error")
    ):
        return None
    raw_saved = load_json(STATE_FILE) or load_json(BACKUP_FILE)
    if not raw_saved:
        return None
    saved = normalize_snapshot_workspaces(raw_saved)
    if (
        marker.get("signature") != discover_signature()
        or marker.get("content_hash") != saved.get("content_hash")
    ):
        return None
    required_true = (
        "transaction_ok",
        "background_transaction_ok",
        "reveal_focus_verified",
        "focus_verified",
        "guard_restored",
    )
    if any(marker.get(key) is not True for key in required_true):
        return None

    current = capture_snapshot(runtime=True)
    live_monitor_objects = [
        {
            "id": item.get("monitor_id"),
            "name": item.get("monitor", ""),
            "disabled": False,
        }
        for item in current.get("monitor_workspaces", [])
        if isinstance(item, dict)
    ]
    saved = translate_saved_hotplug_workspaces(
        saved, load_hotplug_workspace_state(), live_monitor_objects
    )
    live_monitors = {
        str(item.get("monitor", ""))
        for item in current.get("monitor_workspaces", [])
        if isinstance(item, dict)
    }
    saved_monitors = {
        str(item.get("monitor", ""))
        for item in saved.get("monitor_workspaces", [])
        if isinstance(item, dict) and str(item.get("monitor", ""))
    }
    if not saved_monitors.issubset(live_monitors):
        return False
    saved_windows = list(saved.get("windows", []))
    current_windows = list(current.get("windows", []))
    matches = match_windows(saved_windows, current_windows)
    fulfilled = fulfilled_windows(saved_windows, current_windows)
    if len(fulfilled) != len(saved_windows):
        return False
    placement = verify_placement_invariant(
        saved_windows, current_windows, matches, saved, current
    )
    if not placement["ok"]:
        return False

    marker.update(
        {
            "state": "complete",
            "complete": True,
            "protect_snapshot": False,
            "missing_live_monitors": [],
            "unresolved": 0,
            "placement_verified": True,
            "hotplug_reconciled_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        }
    )
    atomic_json(MARKER_FILE, marker)
    return True


def route_hotplug_workspaces(
    dry_run: bool = False,
    quiet: bool = False,
    expected_hotplug: tuple[str, str] | None = None,
) -> dict[str, Any]:
    """Collapse/expand monitor groups without ever moving clients one by one."""
    with StateLock(), HotplugWorkspaceMutationLease() as mutation_lease:
        if not mutation_lease.ready:
            return {
                "ok": False,
                "routed": 0,
                "dispatches": 0,
                "deferred": [],
                "hotplug_pending": True,
                "expected_hotplug_ready": False,
                "reason": mutation_lease.reason,
                "retry_after": HOTPLUG_SETTLE_SECONDS,
            }
        monitors = [
            item for item in hypr_json("monitors") if isinstance(item, dict)
        ]
        unknown_connectors = active_unconfigured_monitor_connectors(monitors)
        if unknown_connectors:
            return {
                "ok": False,
                "routed": 0,
                "dispatches": 0,
                "deferred": [],
                "hotplug_pending": True,
                "expected_hotplug_ready": False,
                "reason": "unconfigured-monitor",
                "unconfigured_connectors": unknown_connectors,
                "retry_after": 0,
            }
        if expected_hotplug is not None and not hotplug_topology_ready(
            expected_hotplug, monitors
        ):
            return {
                "ok": False,
                "routed": 0,
                "dispatches": 0,
                "deferred": [],
                "hotplug_pending": True,
                "expected_hotplug_ready": False,
                "reason": "topology-not-ready",
                "retry_after": HOTPLUG_SETTLE_SECONDS,
            }
        expected_hotplug_ready = expected_hotplug is not None
        if restore_active_locked():
            return {
                "ok": False,
                "routed": 0,
                "dispatches": 0,
                "deferred": [],
                "hotplug_pending": True,
                "expected_hotplug_ready": expected_hotplug_ready,
                "reason": "restore-active",
                "retry_after": 2,
            }
        workspaces = [
            item for item in hypr_json("workspaces") if isinstance(item, dict)
        ]
        active_window = hypr_json("activewindow")
        raw_hotplug_state = load_hotplug_workspace_state()
        dynamic_plan = plan_dynamic_hotplug_workspaces(
            monitors, workspaces, raw_hotplug_state
        )
        route_plan = plan_workspace_group_routes(monitors, workspaces)
        routes = route_plan["routes"]
        deferred = route_plan["deferred"]
        result: dict[str, Any] = {
            "ok": True,
            "dry_run": dry_run,
            "routed": 0,
            "routes": routes,
            "deferred": deferred + list(dynamic_plan.get("deferred", [])),
            "dynamic_mode": dynamic_plan.get("mode"),
            "dynamic_operations": list(dynamic_plan.get("operations", [])),
            "dynamic_collisions": list(dynamic_plan.get("collisions", [])),
            "dynamic_blocked": list(dynamic_plan.get("blocked", [])),
            "hotplug_pending": bool(dynamic_plan.get("pending", False)),
            "dispatches": 0,
            "focus_preserved": True,
            "verified": not routes and not dynamic_plan.get("operations"),
            "expected_hotplug_ready": expected_hotplug_ready,
        }
        if dry_run:
            return result

        baseline_focus = compositor_focus_signature(
            monitors, active_window if isinstance(active_window, dict) else {}
        )
        baseline_pointer_focus = focused_pointer_signature(
            monitors, active_window if isinstance(active_window, dict) else {}
        )

        prepare_monitors = [
            item for item in hypr_json("monitors") if isinstance(item, dict)
        ]
        prepare_unknown = active_unconfigured_monitor_connectors(prepare_monitors)
        if prepare_unknown:
            result.update(
                {
                    "ok": False,
                    "verified": False,
                    "reason": "unconfigured-monitor",
                    "unconfigured_connectors": prepare_unknown,
                    "retry_after": 0,
                }
            )
            return result
        if monitor_topology_identity(prepare_monitors) != monitor_topology_identity(monitors):
            result.update(
                {
                    "ok": False,
                    "verified": False,
                    "reason": "topology-not-ready",
                    "retry_after": HOTPLUG_SETTLE_SECONDS,
                }
            )
            return result

        # The prepare record is fsync'd before compositor mutation. If Python
        # or Hyprland dies after any change_id, the four observable identity
        # states make the next invocation deterministic. Persist an idle WAL
        # too: Lua must be able to distinguish a validated idle record from an
        # unreadable/missing cross-runtime fence.
        prepared_state = dynamic_plan["state"]
        prepared_state = persist_hotplug_workspace_state_if_needed_locked(
            prepared_state
        )

        dynamic_operations = list(dynamic_plan.get("operations", []))
        expected_pointer_focus = list(baseline_pointer_focus)
        for operation in dynamic_operations:
            source = str(int(operation.get("source", 0) or 0))
            spillover = int(operation.get("spillover", 0) or 0)
            guard = int(operation.get("activation_guard", 0) or 0)
            if operation.get("kind") == "spill-expand" and expected_pointer_focus[1] == source:
                expected_pointer_focus[1] = str(spillover)
            if bool(operation.get("activate_source")) and guard > 0:
                if expected_pointer_focus[1] == str(guard):
                    expected_pointer_focus[1] = source
        expected_pointer_focus_signature = tuple(expected_pointer_focus)
        dynamic_committed = commit_dynamic_hotplug_workspace_transaction(
            dynamic_operations,
            monitors,
            active_window if isinstance(active_window, dict) else {},
            quiet=quiet,
        )

        if dynamic_operations:
            after_dynamic_monitors = [
                item for item in hypr_json("monitors") if isinstance(item, dict)
            ]
            after_dynamic_workspaces = [
                item for item in hypr_json("workspaces") if isinstance(item, dict)
            ]
        else:
            after_dynamic_monitors = monitors
            after_dynamic_workspaces = workspaces
        after_dynamic_unknown = active_unconfigured_monitor_connectors(
            after_dynamic_monitors
        )
        if after_dynamic_unknown:
            result.update(
                {
                    "ok": False,
                    "verified": False,
                    "dispatches": dynamic_committed,
                    "hotplug_pending": True,
                    "reason": "unconfigured-monitor",
                    "unconfigured_connectors": after_dynamic_unknown,
                    "retry_after": 0,
                }
            )
            return result
        reconciled_plan = plan_dynamic_hotplug_workspaces(
            after_dynamic_monitors,
            after_dynamic_workspaces,
            prepared_state,
        )
        reconciled_state = persist_hotplug_workspace_state_if_needed_locked(
            reconciled_plan["state"]
        )

        # Legacy or unmapped owner workspaces still use a whole-workspace
        # route. Re-plan after identity changes so no stale selector is sent.
        route_plan = plan_workspace_group_routes(
            after_dynamic_monitors, after_dynamic_workspaces
        )
        if route_plan.get("unconfigured_connectors"):
            result.update(
                {
                    "ok": False,
                    "verified": False,
                    "dispatches": dynamic_committed,
                    "hotplug_pending": True,
                    "reason": "unconfigured-monitor",
                    "unconfigured_connectors": route_plan[
                        "unconfigured_connectors"
                    ],
                    "retry_after": 0,
                }
            )
            return result
        routes = route_plan["routes"]
        deferred = route_plan["deferred"]
        route_committed = commit_inactive_workspace_routes(
            routes, after_dynamic_monitors, quiet=quiet
        )

        post_workspace_list = [
            item for item in hypr_json("workspaces") if isinstance(item, dict)
        ]
        post_workspaces = {
            str(item.get("name", "")): item for item in post_workspace_list
        }
        post_monitors = [
            item for item in hypr_json("monitors") if isinstance(item, dict)
        ]
        post_active_window = hypr_json("activewindow")
        post_unknown = active_unconfigured_monitor_connectors(post_monitors)
        if post_unknown:
            result.update(
                {
                    "ok": False,
                    "verified": False,
                    "dispatches": dynamic_committed + route_committed,
                    "hotplug_pending": True,
                    "reason": "unconfigured-monitor",
                    "unconfigured_connectors": post_unknown,
                    "retry_after": 0,
                }
            )
            return result
        final_dynamic_plan = plan_dynamic_hotplug_workspaces(
            post_monitors, post_workspace_list, reconciled_state
        )
        final_state = persist_hotplug_workspace_state_if_needed_locked(
            final_dynamic_plan["state"]
        )
        remaining = [
            item
            for item in routes
            if str((post_workspaces.get(item["workspace"]) or {}).get("monitor", ""))
            != item["to_monitor"]
        ]
        if dynamic_operations:
            post_pointer_focus = focused_pointer_signature(
                post_monitors,
                post_active_window if isinstance(post_active_window, dict) else {},
            )
            focus_preserved = post_pointer_focus == expected_pointer_focus_signature
        else:
            focus_preserved = compositor_focus_signature(
                post_monitors,
                post_active_window if isinstance(post_active_window, dict) else {},
            ) == baseline_focus
        dynamic_remaining = list(final_dynamic_plan.get("operations", []))
        dynamic_collisions = list(final_dynamic_plan.get("collisions", []))
        dynamic_deferred = list(final_dynamic_plan.get("deferred", []))
        dynamic_blocked = list(final_dynamic_plan.get("blocked", []))
        hotplug_pending = bool(final_dynamic_plan.get("pending", False))
        dynamic_verified = (
            dynamic_committed == len(dynamic_operations)
            and not dynamic_remaining
        )
        verified = not remaining and focus_preserved and dynamic_verified
        result.update(
            {
                "ok": route_committed == len(routes) and verified,
                "routed": len(routes) - len(remaining),
                "routes": routes,
                "deferred": deferred + dynamic_deferred,
                "remaining": remaining,
                "dynamic_committed": dynamic_committed,
                "dynamic_remaining": dynamic_remaining,
                "dynamic_collisions": dynamic_collisions,
                "dynamic_blocked": dynamic_blocked,
                "hotplug_pending": hotplug_pending,
                "wal_generation": int(final_state.get("generation", 0)),
                "dispatches": dynamic_committed + route_committed,
                "focus_preserved": focus_preserved,
                "verified": verified,
                "retry_after": 1
                if remaining or dynamic_remaining or dynamic_deferred
                else (5 if hotplug_pending else 0),
            }
        )
        if verified and not deferred and not hotplug_pending:
            marker_status = reconcile_hotplug_restore_marker_locked()
            result["restore_marker_reconciled"] = marker_status is True
            if marker_status is False:
                result.update(
                    {
                        "ok": False,
                        "reason": "restore-marker-pending",
                        "retry_after": 2,
                    }
                )
        return result


def repair_workspaces(dry_run: bool = False, quiet: bool = False) -> dict[str, Any]:
    """Reinitialize workspace routing after resume without restarting apps."""
    with StateLock():
        saved = load_json(STATE_FILE) or load_json(BACKUP_FILE)
        saved = normalize_snapshot_workspaces(saved) if saved else None

    monitors = list(hypr_json("monitors"))
    unknown_connectors = active_unconfigured_monitor_connectors(monitors)
    if unknown_connectors:
        return {
            "ok": False,
            "dry_run": dry_run,
            "routed": 0,
            "moved": 0,
            "refocused": 0,
            "workspace_routes": [],
            "deferred_workspace_routes": [],
            "moves": [],
            "focuses": [],
            "reason": "unconfigured-monitor",
            "unconfigured_connectors": unknown_connectors,
        }
    workspaces = list(hypr_json("workspaces"))
    clients = list(hypr_json("clients"))
    active_window = hypr_json("activewindow")
    planned_topology = repair_topology_signature(
        monitors, workspaces, clients, active_window
    )
    available_monitor_ids = {
        item_id
        for item in monitors
        if isinstance(item, dict) and not item.get("disabled", False)
        for item_id in [monitor_role_id(item)]
        if item_id is not None
    }
    saved_targets = {
        str(item.get("monitor", "")): str(item.get("workspace", ""))
        for item in (saved or {}).get("monitor_workspaces", [])
        if isinstance(item, dict)
    }
    targets: dict[int, tuple[str, str]] = {}
    for item in monitors:
        item_monitor_id = monitor_role_id(item)
        if item_monitor_id is None:
            continue
        name = str(item.get("name", ""))
        target = saved_targets.get(name, "")
        if not valid_workspace_name(target, item_monitor_id):
            target = str(default_workspace_id(item_monitor_id))
        targets[item_monitor_id] = (name, target)

    moves: list[dict[str, str]] = []
    runtime_roles = live_monitor_role_map(monitors)
    for client in clients:
        if not client.get("mapped", False):
            continue
        runtime_id = strict_monitor_id(client.get("monitor"))
        item_monitor_id = (
            runtime_roles.get(runtime_id)
            if runtime_id is not None
            else None
        )
        if item_monitor_id is None:
            continue
        workspace = client.get("workspace") or {}
        if not polluted_numeric_workspace(
            workspace, item_monitor_id, available_monitor_ids
        ):
            continue
        address = str(client.get("address", ""))
        if not address.startswith("0x"):
            continue
        target = targets.get(
            item_monitor_id,
            ("", str(default_workspace_id(item_monitor_id))),
        )[1]
        moves.append(
            {
                "address": address,
                "from": str(workspace.get("name", "")),
                "to": target,
            }
        )

    focuses: list[dict[str, str]] = []
    for item in monitors:
        item_monitor_id = monitor_role_id(item)
        if item_monitor_id is None:
            continue
        active = item.get("activeWorkspace") or {}
        active_name = str(active.get("name", ""))
        if valid_workspace(active) and (
            re.fullmatch(r"-?[0-9]+", active_name) is None
            or numeric_workspace_owner(active_name) is not None
        ):
            continue
        name, target = targets.get(
            item_monitor_id,
            (str(item.get("name", "")), str(default_workspace_id(item_monitor_id))),
        )
        focuses.append({"monitor": name, "to": target})

    route_plan = plan_workspace_group_routes(monitors, workspaces)
    workspace_routes = route_plan["routes"]
    deferred_workspace_routes = route_plan["deferred"]
    result: dict[str, Any] = {
        "ok": True,
        "dry_run": dry_run,
        "routed": len(workspace_routes),
        "moved": len(moves),
        "refocused": len(focuses),
        "workspace_routes": workspace_routes,
        "deferred_workspace_routes": deferred_workspace_routes,
        "moves": moves,
        "focuses": focuses,
    }
    if dry_run:
        if not quiet:
            print(json.dumps(result, ensure_ascii=False))
        return result

    transaction_expressions: list[str] = []
    for item in workspace_routes:
        transaction_expressions.append(
            "hl.dsp.workspace.move({ "
            f"workspace = {lua_string(workspace_selector(item['workspace']))}, "
            f"monitor = {lua_string(item['to_monitor'])} }})"
        )
    for item in moves:
        selector = lua_string(f"address:{item['address']}")
        transaction_expressions.append(
            "hl.dsp.window.move({ "
            f"workspace = {lua_string(workspace_selector(item['to']))}, "
            f"follow = false, window = {selector} }})"
        )
    for item in focuses:
        if item["monitor"]:
            transaction_expressions.append(
                f"hl.dsp.focus({{ monitor = {lua_string(item['monitor'])} }})"
            )
        transaction_expressions.append(
            "hl.dsp.focus({ "
            f"workspace = {lua_string(workspace_selector(item['to']))}, "
            "on_current_monitor = true }})"
        )

    # Focusing a monitor is required to select its active workspace. Restore
    # the user's original monitor/window after repairing every output.
    original_monitor = next((item for item in monitors if item.get("focused", False)), None)
    if focuses and original_monitor:
        original_monitor_name = str(original_monitor.get("name", ""))
        original_active = original_monitor.get("activeWorkspace") or {}
        original_target = str(original_active.get("name", ""))
        original_monitor_id = monitor_role_id(original_monitor)
        if original_monitor_id is None:
            original_monitor_id = 0
        if not valid_workspace_name(original_target, original_monitor_id):
            original_target = targets.get(
                original_monitor_id,
                (original_monitor_name, str(default_workspace_id(original_monitor_id))),
            )[1]
        if original_monitor_name:
            transaction_expressions.append(
                f"hl.dsp.focus({{ monitor = {lua_string(original_monitor_name)} }})"
            )
        transaction_expressions.append(
            "hl.dsp.focus({ "
            f"workspace = {lua_string(workspace_selector(original_target))}, "
            "on_current_monitor = true }})"
        )
        active_address = str((active_window or {}).get("address", ""))
        if active_address.startswith("0x"):
            transaction_expressions.append(
                f"hl.dsp.focus({{ window = {lua_string('address:' + active_address)} }})"
            )

    lease: RestoreLease | None = None
    if transaction_expressions:
        # Planning is read-only. Acquire immediately before the compositor
        # transaction, then revalidate through the existing post-commit check.
        # A restore which started while we planned therefore wins cleanly,
        # rather than interleaving workspace moves with application restore.
        with StateLock():
            try:
                lease = RestoreLease.acquire_locked(
                    operation="repair",
                    signature=discover_signature(),
                    content_hash=str((saved or {}).get("content_hash", "")),
                    phase="repair-revalidate",
                    attempt=1,
                )
                current_monitors = list(hypr_json("monitors"))
                current_workspaces = list(hypr_json("workspaces"))
                current_clients = list(hypr_json("clients"))
                current_active_window = hypr_json("activewindow")
                if repair_topology_signature(
                    current_monitors,
                    current_workspaces,
                    current_clients,
                    current_active_window
                    if isinstance(current_active_window, dict)
                    else {},
                ) != planned_topology:
                    lease.release_locked()
                    lease = None
                    result.update(
                        {
                            "ok": False,
                            "reason": "topology-changed",
                            "retry_after": 1,
                        }
                    )
                    if not quiet:
                        print(json.dumps(result, ensure_ascii=False))
                    return result
                lease.renew_locked("repair-commit", mutation_started=True)
            except RestoreBusy as error:
                result.update(
                    {
                        "ok": False,
                        "reason": "restore-active",
                        "detail": str(error),
                        "retry_after": 2,
                    }
                )
                if not quiet:
                    print(json.dumps(result, ensure_ascii=False))
                else:
                    eprint(json.dumps(result, ensure_ascii=False))
                return result
            except Exception:
                if lease is not None:
                    try:
                        lease.release_locked()
                    except OSError:
                        pass
                raise

    try:
        result = execute_workspace_repair(
            transaction_expressions,
            workspace_routes,
            moves,
            focuses,
            result,
            compositor_focus_signature(
                monitors,
                active_window if isinstance(active_window, dict) else {},
            ),
            expected_monitors=monitors,
            quiet=quiet,
        )
        if result.get("deferred_workspace_routes") and result.get("ok", False):
            result.update(
                {
                    "ok": False,
                    "reason": "workspace-route-deferred",
                    "retry_after": 1,
                    "non_mutating_deferred": True,
                }
            )
        if result.get("ok", False):
            try:
                with StateLock():
                    marker_status = reconcile_hotplug_restore_marker_locked()
            except (RuntimeError, ValueError, json.JSONDecodeError) as error:
                marker_status = False
                result["marker_reconcile_error"] = str(error)[:512]
            result["restore_marker_reconciled"] = marker_status is True
            if marker_status is False:
                # Preserve the original missing-monitor marker and retry its
                # read-only proof; do not replace it with a repair failure.
                result.update(
                    {
                        "ok": False,
                        "reason": "restore-marker-pending",
                        "retry_after": 2,
                        "preserve_existing_marker": True,
                    }
                )
        if (
            lease is not None
            and not result["ok"]
            and not result.get("non_mutating_deferred", False)
            and not result.get("preserve_existing_marker", False)
        ):
            with StateLock():
                lease.write_terminal_locked(
                    {
                        "unresolved": len(result.get("remaining_moves", [])),
                        "repair_error": str(result.get("verification_error", "workspace repair verification failed"))[:512],
                        "restored_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                    },
                    complete=False,
                    protect_snapshot=True,
                )
        return result
    except Exception as error:
        if lease is not None:
            try:
                with StateLock():
                    lease.write_terminal_locked(
                        {
                            "unresolved": -1,
                            "repair_error": str(error)[:512],
                            "restored_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                        },
                        complete=False,
                        protect_snapshot=True,
                    )
            except RestoreLeaseLost:
                pass
        raise
    finally:
        if lease is not None:
            with StateLock():
                lease.release_locked()


def execute_workspace_repair(
    transaction_expressions: list[str],
    workspace_routes: list[dict[str, Any]],
    moves: list[dict[str, str]],
    focuses: list[dict[str, str]],
    result: dict[str, Any],
    baseline_focus: tuple[tuple[tuple[str, str, bool], ...], str],
    *,
    expected_monitors: list[dict[str, Any]],
    quiet: bool,
) -> dict[str, Any]:
    """Commit and verify an already-planned repair under RestoreLease."""
    committed = commit_guarded_workspace_transaction(
        transaction_expressions,
        workspace_routes,
        quiet=quiet,
        expected_monitors=expected_monitors,
    )
    result["dispatches"] = committed
    result["failed_dispatches"] = len(transaction_expressions) - committed
    remaining_moves: list[dict[str, str]] = []
    remaining_focuses: list[dict[str, str]] = []
    remaining_workspace_routes: list[dict[str, Any]] = []
    verification_error = ""
    focus_preserved = True
    if transaction_expressions:
        time.sleep(0.2)
        try:
            post_workspaces = {
                str(item.get("name", "")): item
                for item in hypr_json("workspaces")
                if isinstance(item, dict)
            }
            for item in workspace_routes:
                current = post_workspaces.get(item["workspace"], {})
                if str(current.get("monitor", "")) != item["to_monitor"]:
                    remaining_workspace_routes.append(item)

            post_clients = {
                str(item.get("address", "")): item
                for item in hypr_json("clients")
                if isinstance(item, dict)
            }
            for item in moves:
                current = post_clients.get(item["address"], {})
                current_workspace = str((current.get("workspace") or {}).get("name", ""))
                if current_workspace != item["to"]:
                    remaining_moves.append(item)

            post_monitor_list = [
                item for item in hypr_json("monitors") if isinstance(item, dict)
            ]
            post_active_window = hypr_json("activewindow")
            post_monitors = {
                str(item.get("name", "")): item for item in post_monitor_list
            }
            for item in focuses:
                current = post_monitors.get(item["monitor"], {})
                current_workspace = str((current.get("activeWorkspace") or {}).get("name", ""))
                if current_workspace != item["to"]:
                    remaining_focuses.append(item)
            focus_preserved = compositor_focus_signature(
                post_monitor_list,
                post_active_window if isinstance(post_active_window, dict) else {},
            ) == baseline_focus
        except (RuntimeError, ValueError, json.JSONDecodeError) as error:
            verification_error = str(error)

    result["remaining_moves"] = remaining_moves
    result["remaining_focuses"] = remaining_focuses
    result["remaining_workspace_routes"] = remaining_workspace_routes
    result["focus_preserved"] = focus_preserved
    result["verified"] = (
        not verification_error
        and focus_preserved
        and not remaining_workspace_routes
        and not remaining_moves
        and not remaining_focuses
    )
    result["ok"] = result["failed_dispatches"] == 0 and result["verified"]
    if committed == 0 and remaining_workspace_routes and not verification_error:
        post_plan = plan_workspace_group_routes(
            post_monitor_list, list(post_workspaces.values())
        )
        deferred_names = {
            str(item.get("workspace", "")) for item in post_plan["deferred"]
        }
        if all(
            str(item.get("workspace", "")) in deferred_names
            for item in remaining_workspace_routes
        ):
            # The compositor-side guard ran before every dispatcher. A route
            # becoming visible is therefore a clean deferral, not a partial
            # repair and must not poison the saved-session marker.
            result["non_mutating_deferred"] = True
            result["reason"] = "workspace-became-active"
            result["deferred_workspace_routes"] = post_plan["deferred"]
            result["retry_after"] = 1
    if verification_error:
        result["verification_error"] = verification_error
    # Never force-save from resume repair. The event-driven autosaver will
    # capture a verified stable state through the normal restore protections.
    if not quiet:
        print(json.dumps(result, ensure_ascii=False))
    elif not result["ok"]:
        eprint(json.dumps(result, ensure_ascii=False))
    return result


def snapshot_hash(snapshot: dict[str, Any]) -> str:
    value = copy.deepcopy(snapshot)
    value.pop("captured_at", None)
    value.pop("content_hash", None)
    for window in value.get("windows", []):
        # Live titles (browser pages, progress spinners) should not cause writes.
        window.pop("title", None)
        window.pop("address", None)
        window.pop("pid", None)
        window.pop("monitor", None)
        if not window.get("floating", False):
            # List order retains the tiled layout order.  Exact tiled pixel
            # geometry changes with panel/exclusive-zone size and is not replayed.
            window.pop("at", None)
            window.pop("size", None)
    encoded = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def preserve_unverified_terminal_state(snapshot: dict[str, Any], previous: dict[str, Any] | None) -> None:
    """Preserve metadata only across a uniquely mapped compatible terminal."""
    old_windows = list(previous.get("windows", [])) if previous else []
    new_windows = list(snapshot.get("windows", []))
    matches = match_windows(old_windows, new_windows) if old_windows else {}
    previous_by_id = {str(window.get("id")): window for window in old_windows}
    current_to_previous = {id(current): previous_by_id[saved_id] for saved_id, current in matches.items()}
    for window in new_windows:
        launch = window.get("launch")
        if not isinstance(launch, dict) or launch.get("kind") != "terminal":
            continue
        cwd_verified = bool(launch.pop("_cwd_verified", False))
        mapping_verified = bool(launch.pop("_mapping_verified", False))
        program_verified = bool(launch.pop("_program_verified", False))
        session_verified = bool(launch.pop("_session_verified", False))
        launch.pop("_terminal_screen", None)
        launch.pop("_terminal_service", None)
        old_window = current_to_previous.get(id(window))
        old_launch = old_window.get("launch") if old_window else None
        old_terminal = isinstance(old_launch, dict) and old_launch.get("kind") == "terminal"
        current_program = str(launch.get("program", "shell"))
        # Both codex and claude carry a conversation id; anything else must not
        # keep one. Validate with the parser that belongs to the program so a
        # claude UUID is not silently discarded by the codex validator.
        if current_program == "claude":
            current_session = canonical_claude_session_id(launch.get("session_id"))
        else:
            current_session = canonical_codex_session_id(launch.get("session_id"))

        if current_program in {"codex", "claude"}:
            if not (
                mapping_verified
                and program_verified
                and session_verified
                and current_session is not None
            ):
                # A previous conversation id must never be pasted onto a new or
                # ambiguously mapped terminal merely because title/cwd match.
                launch.pop("session_id", None)
                current_session = None
            else:
                launch["session_id"] = current_session
        else:
            launch.pop("session_id", None)

        if not mapping_verified:
            if not cwd_verified or not launch.get("cwd"):
                launch["cwd"] = str(HOME)
            continue

        old_program = str(old_launch.get("program", "shell")) if old_terminal else ""
        identity_matches = old_terminal and old_program == current_program
        if current_program in {"codex", "claude"}:
            parse = (
                canonical_claude_session_id
                if current_program == "claude"
                else canonical_codex_session_id
            )
            identity_matches = bool(
                identity_matches
                and current_session is not None
                and parse(old_launch.get("session_id")) == current_session
            )

        if not program_verified and old_terminal and old_program != "codex":
            # An inaccessible /proc entry, unknown foreground command, or
            # ambiguous same-group descendants cannot prove that a non-Codex
            # TUI ended.  The unique outer mapping makes this preservation safe.
            for key in ("program", "args", "cwd"):
                if key in old_launch:
                    launch[key] = copy.deepcopy(old_launch[key])
            if not launch.get("cwd"):
                launch["cwd"] = str(HOME)
            continue

        if not cwd_verified or not launch.get("cwd"):
            if identity_matches and old_launch.get("cwd"):
                launch["cwd"] = old_launch["cwd"]
            else:
                launch["cwd"] = str(HOME)


def restore_active_locked() -> bool:
    """Check the authoritative lease while StateLock prevents a TOCTOU race."""
    existing = load_json(RESTORE_FLAG)
    if not existing:
        # load_json() rejects malformed or unsafe files. Preserve an unreadable
        # path instead of guessing that it is safe to checkpoint over it.
        return RESTORE_FLAG.exists()
    if restore_record_alive(existing):
        return True
    abandon_restore_record_locked(existing)
    return False


def restore_active() -> bool:
    """Compatibility wrapper for diagnostics; writers use the locked form."""
    with StateLock():
        return restore_active_locked()


def restore_untrustworthy(marker: dict[str, Any] | None) -> bool:
    """Return true when the live desktop is a half-applied snapshot.

    An absent monitor is deliberately NOT in this list.  A restore that ran
    against fewer outputs still placed everything it could, and the result is
    correct *for the current topology* -- it is a different layout, not a
    broken one.  Treating it as a failure used to freeze the snapshot: every
    later autosave returned "restore-incomplete", so nothing the user did was
    ever recorded and each reboot replayed the same stale layout.  Snapshots
    are now kept per topology, so recording the current one cannot destroy the
    layout belonging to the other one.
    """
    if not marker or marker.get("complete") is True:
        return False
    if marker.get("restore_error") or marker.get("repair_error"):
        return True
    if marker.get("unresolved") != 0:
        return True
    # Fail closed: a marker that does not positively assert every verification
    # is not trusted, whatever else it happens to say.  Only a restore that
    # proved each invariant, and merely ran against fewer outputs, is allowed
    # through here.
    return any(
        marker.get(key) is not True
        for key in (
            "transaction_ok",
            "background_transaction_ok",
            "reveal_focus_verified",
            "focus_verified",
            "placement_verified",
            "guard_restored",
        )
    )


def save_snapshot(force: bool = False, quiet: bool = False, reason: str = "manual") -> dict[str, Any]:
    with StateLock():
        # Force may override an incomplete terminal outcome, but never an
        # in-progress compositor mutation owned by another token.
        if restore_active_locked():
            return {"ok": True, "saved": False, "reason": "restore-active", "retry_after": 5}
        raw_primary_previous = load_json(STATE_FILE)
        raw_backup_previous = load_json(BACKUP_FILE)
        primary_previous = normalize_snapshot_workspaces(raw_primary_previous) if raw_primary_previous else None
        previous = primary_previous or (
            normalize_snapshot_workspaces(raw_backup_previous) if raw_backup_previous else None
        )
        marker = load_json(MARKER_FILE)
        signature = discover_signature()
        previous_hash = str((previous or {}).get("content_hash", ""))
        if (
            not force
            and marker
            and marker.get("signature") == signature
            and marker.get("content_hash") == previous_hash
            and marker.get("protect_snapshot") is True
            and restore_untrustworthy(marker)
        ):
            # A monitor/focus/layout failure cannot be repaired merely by
            # observing that every process exists. Only a new verified restore
            # attempt (or an explicit force-save) may replace this snapshot.
            return {
                "ok": True,
                "saved": False,
                "reason": "restore-incomplete",
                "retry_after": 60,
                "missing": (
                    marker.get("unresolved", 0)
                    if isinstance(marker.get("unresolved", 0), int)
                    else -1
                ),
                "requires_verified_restore": True,
            }
        before_capture = snapshot_hotplug_fence()
        if before_capture["settling"]:
            return hotplug_settling_save_outcome(
                before_capture, "before-capture"
            )
        snapshot = capture_snapshot(runtime=False)
        before_commit = snapshot_hotplug_fence()
        if before_commit["settling"]:
            return hotplug_settling_save_outcome(before_commit, "before-commit")
        # Check restore completion before preserve_unverified_terminal_state()
        # removes verification flags or copies trusted old metadata into an
        # unverified live terminal.  Copied metadata is protection, not proof.
        protected_windows = list(previous.get("windows", [])) if previous else []
        marker_protects_snapshot = bool(
            marker
            and marker.get("signature") == signature
            and marker.get("content_hash") == previous_hash
            and (marker.get("protect_snapshot") is True or marker.get("complete") is False)
            and not force
        )
        positively_recovered = (
            fulfilled_windows(protected_windows, list(snapshot.get("windows", [])))
            if marker_protects_snapshot
            else {}
        )
        preserve_unverified_terminal_state(snapshot, previous)
        snapshot["content_hash"] = snapshot_hash(snapshot)
        if marker_protects_snapshot:
            if len(positively_recovered) < len(protected_windows):
                result = {
                    "ok": True,
                    "saved": False,
                    "reason": "restore-incomplete",
                    "retry_after": 60,
                    "missing": len(protected_windows) - len(positively_recovered),
                }
                if not quiet:
                    print(json.dumps(result, ensure_ascii=False))
                return result
            marker["complete"] = True
            marker["state"] = "complete"
            marker["protect_snapshot"] = False
            marker["unresolved"] = 0
            marker.pop("protect_snapshot_until", None)
            marker["content_hash"] = snapshot["content_hash"]
            atomic_json(MARKER_FILE, marker)
        unchanged = primary_previous and primary_previous.get("content_hash") == snapshot["content_hash"]
        if unchanged and not force:
            result = {"ok": True, "saved": False, "reason": "unchanged", "windows": len(snapshot["windows"])}
        else:
            snapshot["save_reason"] = reason
            if primary_previous:
                atomic_json(BACKUP_FILE, primary_previous)
            atomic_json(STATE_FILE, snapshot)
            # Keep one slot per output topology.  Undocking must record the
            # single-monitor layout without overwriting the docked one, so that
            # plugging the monitor back in still has a real snapshot to restore.
            topology = snapshot_topology_key(snapshot)
            if topology != "unknown":
                SESSION_SLOT_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
                atomic_json(topology_slot_file(topology), snapshot)
            if marker and marker.get("signature") == signature and (force or marker.get("complete") is True):
                marker["content_hash"] = snapshot["content_hash"]
                marker["complete"] = True
                marker["state"] = "complete"
                marker["protect_snapshot"] = False
                marker["unresolved"] = 0
                marker.pop("protect_snapshot_until", None)
                atomic_json(MARKER_FILE, marker)
            result = {"ok": True, "saved": True, "reason": reason, "windows": len(snapshot["windows"])}
    if not quiet:
        print(json.dumps(result, ensure_ascii=False))
    return result


def title_similarity(left: str, right: str) -> float:
    return difflib.SequenceMatcher(None, left.lower()[:256], right.lower()[:256]).ratio()


def match_score(saved: dict[str, Any], current: dict[str, Any]) -> float:
    saved_classes = {norm(saved.get("class")), norm(saved.get("initial_class"))} - {""}
    current_classes = {norm(current.get("class")), norm(current.get("initial_class"))} - {""}
    if not saved_classes.intersection(current_classes):
        return -1.0
    score = 100.0
    if norm(saved.get("initial_class")) == norm(current.get("initial_class")):
        score += 25
    if saved.get("workspace", {}).get("name") == current.get("workspace", {}).get("name"):
        score += 25
    if saved.get("initial_title") == current.get("initial_title"):
        score += 12
    score += 18 * title_similarity(str(saved.get("title", "")), str(current.get("title", "")))
    if bool(saved.get("floating")) == bool(current.get("floating")):
        score += 6
    saved_launch = saved.get("launch") or {}
    current_launch = current.get("launch") or {}
    if saved_launch.get("kind") == "terminal" and current_launch.get("kind") == "terminal":
        saved_program = str(saved_launch.get("program", "shell"))
        current_program = str(current_launch.get("program", "shell"))
        if saved_program == "codex" and current_program == "codex":
            saved_session = canonical_codex_session_id(saved_launch.get("session_id"))
            current_session = canonical_codex_session_id(current_launch.get("session_id"))
            if saved_session and current_session and saved_session != current_session:
                return -1.0
            if saved_session and current_session == saved_session:
                score += 1000
        # A binding is proof of which snapshot entry this window was spawned
        # for, so it outranks every heuristic and excludes every other entry.
        restored_for = str(current_launch.get("_restore_window_id", ""))
        if restored_for:
            if restored_for == str(saved.get("id", "")):
                score += 1000
            else:
                return -1.0
        if saved_program == "claude" and current_program == "claude":
            saved_session = canonical_claude_session_id(saved_launch.get("session_id"))
            current_session = canonical_claude_session_id(current_launch.get("session_id"))
            if saved_session and current_session and saved_session != current_session:
                return -1.0
            if saved_session and current_session == saved_session:
                score += 1000
        if saved_launch.get("cwd") == current_launch.get("cwd"):
            score += 28
        if saved_program == current_program:
            score += 15
    distance = sum(abs(int(a) - int(b)) for a, b in zip(saved.get("at", [0, 0]), current.get("at", [0, 0])))
    score += max(0.0, 10.0 - distance / 200.0)
    return score


def normalized_terminal_cwd(value: Any) -> str:
    if not value:
        return ""
    return os.path.normpath(os.path.abspath(str(value)))


def terminal_launch_fulfilled(saved_launch: Any, current_launch: Any) -> bool:
    """Require positive evidence that a terminal's inner program is restored.

    A GNOME Terminal compositor window can appear before Fish starts the saved
    TUI.  Window-class matching alone must therefore never mark an editor or
    Codex session complete.  The private verification flags exist only on a
    fresh /proc-backed capture and are deliberately absent from persisted data.
    """
    if not isinstance(saved_launch, dict) or saved_launch.get("kind") != "terminal":
        return False
    if not isinstance(current_launch, dict) or current_launch.get("kind") != "terminal":
        return False
    if (
        current_launch.get("_mapping_verified") is not True
        or current_launch.get("_program_verified") is not True
        or current_launch.get("_cwd_verified") is not True
    ):
        return False
    saved_program = str(saved_launch.get("program", "shell"))
    current_program = str(current_launch.get("program", "shell"))
    if saved_program != current_program:
        return False
    if normalized_terminal_cwd(saved_launch.get("cwd")) != normalized_terminal_cwd(current_launch.get("cwd")):
        return False
    if saved_program == "claude":
        saved_session = canonical_claude_session_id(saved_launch.get("session_id"))
        current_session = canonical_claude_session_id(current_launch.get("session_id"))
        return bool(
            saved_session is not None
            and current_launch.get("_session_verified") is True
            and current_session == saved_session
        )
    if saved_program == "codex":
        saved_session = canonical_codex_session_id(saved_launch.get("session_id"))
        current_session = canonical_codex_session_id(current_launch.get("session_id"))
        if (
            saved_session is None
            or current_launch.get("_session_verified") is not True
            or current_session != saved_session
        ):
            return False
    if saved_program == "nvim":
        saved_args = [str(value) for value in saved_launch.get("args", []) if isinstance(value, str)]
        current_args = [str(value) for value in current_launch.get("args", []) if isinstance(value, str)]
        if saved_args != current_args:
            return False
    return True


def fulfillment_score(saved: dict[str, Any], current: dict[str, Any]) -> float:
    score = match_score(saved, current)
    if score < 80:
        return -1.0
    saved_launch = saved.get("launch") or {}
    if saved_launch.get("kind") == "terminal" and not terminal_launch_fulfilled(
        saved_launch, current.get("launch")
    ):
        return -1.0
    return score


def best_group_matching(
    saved: list[dict[str, Any]],
    current: list[dict[str, Any]],
    score_function: Callable[[dict[str, Any], dict[str, Any]], float] = match_score,
) -> dict[str, dict[str, Any]]:
    if not saved or not current:
        return {}
    scores = [[score_function(left, right) for right in current] for left in saved]
    if len(saved) <= 12 and len(current) <= 12:
        memo: dict[tuple[int, int], tuple[int, float, tuple[int, ...]]] = {}

        def solve(index: int, used: int) -> tuple[int, float, tuple[int, ...]]:
            key = (index, used)
            if key in memo:
                return memo[key]
            if index == len(saved):
                return (0, 0.0, ())
            best_count, best_value, best_assignment = solve(index + 1, used)
            best_assignment = (-1,) + best_assignment
            for candidate in range(len(current)):
                if used & (1 << candidate) or scores[index][candidate] < 80:
                    continue
                tail_count, tail_value, tail_assignment = solve(index + 1, used | (1 << candidate))
                count = 1 + tail_count
                value = scores[index][candidate] + tail_value
                if (count, value) > (best_count, best_value):
                    best_count = count
                    best_value = value
                    best_assignment = (candidate,) + tail_assignment
            memo[key] = (best_count, best_value, best_assignment)
            return memo[key]

        assignment = solve(0, 0)[2]
        return {saved[i]["id"]: current[j] for i, j in enumerate(assignment) if j >= 0}

    # Maximum-cardinality augmenting paths for larger duplicate sets.  Candidate
    # order still favors the highest semantic score without sacrificing count.
    adjacency = [
        sorted((j for j in range(len(current)) if scores[i][j] >= 80), key=lambda j: scores[i][j], reverse=True)
        for i in range(len(saved))
    ]
    matched_right: dict[int, int] = {}

    def augment(left: int, seen: set[int]) -> bool:
        for right in adjacency[left]:
            if right in seen:
                continue
            seen.add(right)
            if right not in matched_right or augment(matched_right[right], seen):
                matched_right[right] = left
                return True
        return False

    for left in sorted(range(len(saved)), key=lambda i: (len(adjacency[i]), -max((scores[i][j] for j in adjacency[i]), default=0))):
        augment(left, set())
    return {saved[left]["id"]: current[right] for right, left in matched_right.items()}


def match_windows(saved: list[dict[str, Any]], current: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    # Match globally so a program whose live class changes after startup still
    # connects through its stable initialClass.  Incompatible class pairs score
    # -1, so unrelated applications can never be paired.
    return best_group_matching(saved, current)


def fulfilled_windows(saved: list[dict[str, Any]], current: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    """Match windows that are positively ready, including terminal contents."""
    return best_group_matching(saved, current, fulfillment_score)


def terminal_launch_cwd(launch: dict[str, Any]) -> Path:
    cwd = Path(str(launch.get("cwd", HOME)))
    return cwd if cwd.is_dir() else HOME


def terminal_tui_command(launch: dict[str, Any] | None) -> list[str] | None:
    """Build only the inner command; an empty list means an idle Fish shell."""
    if not isinstance(launch, dict) or launch.get("kind") != "terminal":
        return None
    cwd = terminal_launch_cwd(launch)
    program = str(launch.get("program", "shell"))
    if program == "shell":
        return []
    if program == "nvim" and shutil.which("nvim"):
        args = [
            str(value)
            for value in launch.get("args", [])
            if isinstance(value, str)
            and len(value) <= 2048
            and "\0" not in value
        ]
        return [shutil.which("nvim") or "/usr/bin/nvim", *args]
    if program == "codex":
        session_id = canonical_codex_session_id(launch.get("session_id"))
        codex = HOME / ".local/bin/codex"
        if session_id is None or not codex.is_file():
            return None
        return [str(codex), "resume", session_id, "-C", str(cwd)]
    if program == "claude":
        claude = shutil.which("claude")
        if not claude:
            return None
        session_id = canonical_claude_session_id(launch.get("session_id"))
        # Without a confidently resolved conversation, start a fresh one rather
        # than reattaching to whichever transcript happens to be newest.
        return [claude, "--resume", session_id] if session_id else [claude]
    if program in restorable_tuis() and shutil.which(program):
        return [shutil.which(program) or program]
    return None


def launch_argv(launch: dict[str, Any] | None) -> list[str] | None:
    if not isinstance(launch, dict):
        return None
    kind = launch.get("kind")
    if kind == "desktop":
        desktop_id = str(launch.get("id", ""))
        if re.fullmatch(r"[A-Za-z0-9_.+\-]+", desktop_id) and shutil.which("gtk-launch"):
            return [shutil.which("gtk-launch") or "/usr/bin/gtk-launch", desktop_id]
    if kind == "executable":
        path = Path(str(launch.get("path", "")))
        if path.is_absolute() and path.is_file() and os.access(path, os.X_OK):
            return [str(path)]
    if kind == "terminal":
        terminal = shutil.which("gnome-terminal")
        if not terminal:
            return None
        cwd = terminal_launch_cwd(launch)
        command = terminal_tui_command(launch)
        if command is None:
            return None
        fish = shutil.which("fish") or "/usr/bin/fish"
        if not command:
            terminal_command = [fish, "-l"]
        else:
            # Run the restored foreground TUI as an init command.  Once it
            # exits, the original interactive Fish prompt remains available.
            terminal_command = [fish, "-l", "-C", shlex.join(command)]
        return [terminal, "--window", f"--working-directory={cwd}", "--", *terminal_command]
    return None


def normalized_terminal_launch(launch: Any) -> dict[str, Any] | None:
    """Return the small, validated launch tuple allowed in a pending record."""
    if not isinstance(launch, dict) or launch.get("kind") != "terminal":
        return None
    command = terminal_tui_command(launch)
    if command is None:
        return None
    program = str(launch.get("program", "shell"))
    value: dict[str, Any] = {
        "kind": "terminal",
        "cwd": str(terminal_launch_cwd(launch)),
        "program": program,
        "args": [],
    }
    if program == "nvim":
        value["args"] = command[1:]
    elif program == "codex":
        session_id = canonical_codex_session_id(launch.get("session_id"))
        if session_id is None:
            return None
        value["session_id"] = session_id
    elif program == "claude":
        session_id = canonical_claude_session_id(launch.get("session_id"))
        if session_id is not None:
            value["session_id"] = session_id
    elif program != "shell" and program not in restorable_tuis():
        return None
    return value


def terminal_binding_wrapper_argv(
    launch: dict[str, Any], token: str, sentinel_title: str
) -> list[str] | None:
    """Open only Fish+ACK; the saved TUI argv stays inside the pending record."""
    if not valid_terminal_token(token) or normalized_terminal_launch(launch) is None:
        return None
    terminal = shutil.which("gnome-terminal")
    if not terminal:
        return None
    fish = shutil.which("fish") or "/usr/bin/fish"
    env = shutil.which("env") or "/usr/bin/env"
    cwd = terminal_launch_cwd(launch)
    ack = shlex.join([str(SCRIPT_PATH), "terminal-bind-ack", token])
    # The helper replaces itself with the TUI only after a durable ACK.  Fish
    # removes the raw token from its own environment after the child exits.
    fish_command = (
        f"command {ack}; "
        "set -l uios_bind_status $status; "
        "set -e UIOS_TERMINAL_BIND_TOKEN; "
        "test $uios_bind_status -eq 0"
    )
    return [
        terminal,
        "--window",
        f"--title={sentinel_title}",
        f"--working-directory={cwd}",
        "--",
        env,
        f"UIOS_TERMINAL_BIND_TOKEN={token}",
        fish,
        "-l",
        "-C",
        fish_command,
    ]


def prepare_terminal_binding(
    window: dict[str, Any],
    *,
    raw_clients: list[dict[str, Any]] | None = None,
    signature: str | None = None,
    now: float | None = None,
) -> dict[str, Any] | None:
    launch = normalized_terminal_launch(window.get("launch"))
    window_id = str(window.get("id", ""))
    if launch is None or not window_id:
        return None
    try:
        clients = list(hypr_json("clients")) if raw_clients is None else list(raw_clients)
    except (RuntimeError, ValueError, json.JSONDecodeError):
        return None
    addresses = sorted(
        {
            str(client.get("address", ""))
            for client in clients
            if isinstance(client, dict)
            and client.get("mapped", False)
            and valid_terminal_address(str(client.get("address", "")))
        }
    )
    if len(addresses) > 4096:
        return None
    token = secrets.token_hex(32)
    digest = terminal_token_digest(token)
    sentinel = f"{TERMINAL_BIND_TITLE_PREFIX}{digest.removeprefix('sha256:')}__"
    argv = terminal_binding_wrapper_argv(launch, token, sentinel)
    if argv is None:
        return None
    current_time = time.time() if now is None else now
    current_signature = signature if signature is not None else discover_signature()
    pending = {
        "token_hash": digest,
        "created_at": current_time,
        "expires_at": current_time + TERMINAL_BINDING_TTL_SECONDS,
        "saved_window_id": window_id,
        "sentinel_title": sentinel,
        "preexisting_addresses": addresses,
        "launch": launch,
    }
    with TerminalBindingLock():
        registry = load_terminal_registry_locked(current_signature)
        registry["pending"] = [
            item
            for item in registry.get("pending", [])
            if isinstance(item, dict)
            and valid_terminal_pending(item, current_time)
            and item.get("token_hash") != digest
        ]
        registry["pending"].append(pending)
        write_terminal_registry_locked(registry)
    return {"token": token, "token_hash": digest, "argv": argv, "pending": pending}


def cancel_terminal_binding(
    token: str, *, signature: str | None = None
) -> bool:
    if not valid_terminal_token(token):
        return False
    digest = terminal_token_digest(token)
    current_signature = signature if signature is not None else discover_signature()
    with TerminalBindingLock():
        registry = load_terminal_registry_locked(current_signature)
        before = list(registry.get("pending", []))
        registry["pending"] = [
            item
            for item in before
            if isinstance(item, dict) and item.get("token_hash") != digest
        ]
        if registry["pending"] == before:
            return False
        write_terminal_registry_locked(registry)
    return True


def terminal_ack_process_identity(token: str) -> dict[str, Any] | None:
    """Verify that this ACK is a direct child of the token-owning Fish shell."""
    shell_pid = os.getppid()
    shell_before = proc_stat(shell_pid)
    shell_argv = proc_cmdline(shell_pid)
    environment, environment_verified = proc_selected_environ(shell_pid)
    shell_after = proc_stat(shell_pid)
    if (
        shell_before is None
        or shell_after is None
        or int(shell_before.get("start", -1)) != int(shell_after.get("start", -2))
        or not shell_argv
        or Path(shell_argv[0]).name.lower() not in SHELL_NAMES
        or not environment_verified
        or environment.get("UIOS_TERMINAL_BIND_TOKEN") != token
    ):
        return None
    screen = environment.get("GNOME_TERMINAL_SCREEN", "")
    service = environment.get("GNOME_TERMINAL_SERVICE", "")
    if not valid_terminal_screen(screen) or not valid_terminal_service(service):
        return None
    server_pid = int(shell_after.get("ppid", 0))
    server_before = proc_stat(server_pid)
    server_argv = proc_cmdline(server_pid)
    _server_environment, server_verified = proc_selected_environ(server_pid)
    server_after = proc_stat(server_pid)
    if (
        server_pid <= 0
        or server_before is None
        or server_after is None
        or int(server_before.get("start", -1)) != int(server_after.get("start", -2))
        or not server_verified
        or not server_argv
        or norm(Path(server_argv[0]).name) not in TERMINAL_CLASSES
        or int(shell_after.get("tty", 0)) <= 0
    ):
        return None
    return {
        "server_pid": server_pid,
        "server_start": int(server_after["start"]),
        "shell_pid": shell_pid,
        "shell_start": int(shell_after["start"]),
        "tty": int(shell_after["tty"]),
        "screen": screen,
        "service": service,
    }


def terminal_binding_candidate(
    pending: dict[str, Any], identity: dict[str, Any], clients: list[dict[str, Any]]
) -> dict[str, Any] | None:
    preexisting = set(pending.get("preexisting_addresses", []))
    sentinel = str(pending.get("sentinel_title", ""))
    candidates = [
        client
        for client in clients
        if isinstance(client, dict)
        and client.get("mapped", False)
        and norm(client.get("class")) in TERMINAL_CLASSES
        and int(client.get("pid", 0) or 0) == int(identity["server_pid"])
        and str(client.get("initialTitle", "")) == sentinel
        and valid_terminal_address(str(client.get("address", "")))
        and str(client.get("address", "")) not in preexisting
        and valid_terminal_stable_id(client.get("stableId"))
    ]
    return candidates[0] if len(candidates) == 1 else None


def terminal_ack_identity_still_live(identity: dict[str, Any]) -> bool:
    shell = proc_stat(int(identity["shell_pid"]))
    server = proc_stat(int(identity["server_pid"]))
    return bool(
        shell
        and server
        and int(shell.get("start", -1)) == int(identity["shell_start"])
        and int(server.get("start", -1)) == int(identity["server_start"])
        and int(shell.get("ppid", 0)) == int(identity["server_pid"])
        and int(shell.get("tty", 0)) == int(identity["tty"])
    )


def terminal_bind_ack(
    token: str,
    *,
    execute: bool = False,
    signature: str | None = None,
    now: float | None = None,
) -> dict[str, Any]:
    """Atomically claim one exact new client; never expose TUI argv on failure."""
    if not valid_terminal_token(token):
        return {"ok": False, "reason": "invalid-token"}
    digest = terminal_token_digest(token)
    current_time = time.time() if now is None else now
    current_signature = signature if signature is not None else discover_signature()
    with TerminalBindingLock():
        registry = load_terminal_registry_locked(current_signature)
        pending_matches = [
            copy.deepcopy(item)
            for item in registry.get("pending", [])
            if isinstance(item, dict) and item.get("token_hash") == digest
        ]
        existing_matches = [
            copy.deepcopy(item)
            for item in registry.get("bindings", [])
            if isinstance(item, dict) and item.get("token_hash") == digest
        ]
        if len(pending_matches) > 1 or len(existing_matches) > 1:
            return {"ok": False, "reason": "registry-conflict"}
        pending = pending_matches[0] if pending_matches else None
        existing = existing_matches[0] if existing_matches else None
        if pending is not None and not valid_terminal_pending(pending, current_time):
            registry["pending"] = [
                item
                for item in registry.get("pending", [])
                if isinstance(item, dict) and item.get("token_hash") != digest
            ]
            write_terminal_registry_locked(registry)
            return {"ok": False, "reason": "expired"}
    if pending is not None and existing is not None:
        return {"ok": False, "reason": "registry-conflict"}
    if pending is None and existing is None:
        return {"ok": False, "reason": "unknown-token"}

    identity = terminal_ack_process_identity(token)
    if identity is None:
        return {"ok": False, "reason": "wrong-ancestry"}
    try:
        clients = list(hypr_json("clients"))
    except (RuntimeError, ValueError, json.JSONDecodeError):
        return {"ok": False, "reason": "clients-unavailable"}

    if existing is not None:
        client = next(
            (
                item
                for item in clients
                if isinstance(item, dict)
                and item.get("mapped", False)
                and norm(item.get("class")) in TERMINAL_CLASSES
                and valid_terminal_address(str(item.get("address", "")))
                and valid_terminal_stable_id(item.get("stableId"))
                and str(item.get("address", "")) == existing.get("address")
                and str(item.get("stableId", "")) == existing.get("stable_id")
                and int(item.get("pid", 0) or 0) == identity["server_pid"]
            ),
            None,
        )
        if client is None or any(
            existing.get(key) != identity.get(key)
            for key in (
                "server_pid",
                "server_start",
                "shell_pid",
                "shell_start",
                "tty",
                "screen",
                "service",
            )
        ):
            return {"ok": False, "reason": "idempotence-mismatch"}
        command = terminal_tui_command(existing.get("launch"))
        if command is None or not terminal_ack_identity_still_live(identity):
            return {"ok": False, "reason": "stale-identity"}
        result = {"ok": True, "reason": "already-bound", "command": command}
    else:
        assert pending is not None
        candidate = terminal_binding_candidate(pending, identity, clients)
        if candidate is None:
            return {"ok": False, "reason": "client-cardinality"}
        command = terminal_tui_command(pending.get("launch"))
        if command is None or not terminal_ack_identity_still_live(identity):
            return {"ok": False, "reason": "stale-identity"}
        # Keep the link to the snapshot entry this terminal was spawned for.
        # Without it two identical shell terminals are indistinguishable at
        # match time: the newly spawned window can be paired with the *other*
        # saved id, its own id never becomes fulfilled, and the restore waits
        # out the full per-terminal timeout and then cancels this binding.
        binding = {
            **identity,
            "address": str(candidate["address"]),
            "stable_id": str(candidate["stableId"]),
            "token_hash": digest,
            "source": "restore",
            "bound_at": current_time,
            "saved_window_id": str(pending.get("saved_window_id", "")),
            "launch": copy.deepcopy(pending["launch"]),
        }
        with TerminalBindingLock():
            registry = load_terminal_registry_locked(current_signature)
            current_pending = next(
                (
                    item
                    for item in registry.get("pending", [])
                    if isinstance(item, dict) and item.get("token_hash") == digest
                ),
                None,
            )
            if current_pending != pending or not valid_terminal_pending(
                current_pending, current_time
            ):
                return {"ok": False, "reason": "pending-changed"}
            conflicts = [
                item
                for item in registry.get("bindings", [])
                if not isinstance(item, dict)
                or item.get("screen") == binding["screen"]
                or item.get("address") == binding["address"]
                or item.get("stable_id") == binding["stable_id"]
                or (
                    item.get("shell_pid") == binding["shell_pid"]
                    and item.get("shell_start") == binding["shell_start"]
                )
                or item.get("token_hash") == digest
            ]
            if conflicts:
                return {"ok": False, "reason": "binding-conflict"}
            registry["pending"] = [
                item
                for item in registry.get("pending", [])
                if isinstance(item, dict) and item.get("token_hash") != digest
            ]
            registry["bindings"].append(binding)
            write_terminal_registry_locked(registry)
        result = {"ok": True, "reason": "bound", "command": command}

    if execute:
        command = list(result["command"])
        os.environ.pop("UIOS_TERMINAL_BIND_TOKEN", None)
        if command:
            os.execvp(command[0], command)
    return result


def launch_key(window: dict[str, Any]) -> str:
    launch = window.get("launch") or {}
    return json.dumps(launch, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def single_instance_class_key(window: dict[str, Any]) -> str:
    for value in (window.get("class"), window.get("initial_class")):
        key = norm(value)
        if key in SINGLE_INSTANCE_CLASSES:
            return key
    return ""


def singleton_extra_window_argv(window: dict[str, Any]) -> list[str] | None:
    """Return one allowlisted native new-window command for a saved surface."""
    key = single_instance_class_key(window)
    command = SINGLE_INSTANCE_NEW_WINDOW_COMMANDS.get(key)
    if not command:
        return None
    executable = shutil.which(command[0])
    if not executable:
        return None
    return [executable, *command[1:]]


def connect_event_socket() -> socket.socket | None:
    path = event_socket_path()
    if not path:
        return None
    candidate = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        candidate.connect(str(path))
        candidate.setblocking(False)
        return candidate
    except OSError:
        candidate.close()
        return None


def wait_for_window(events: socket.socket | None, expected_classes: Any, timeout: float = 8.0) -> None:
    if events is None:
        time.sleep(min(timeout, 1.5))
        return
    deadline = time.monotonic() + timeout
    buffer = b""
    if isinstance(expected_classes, str):
        expected_classes = [expected_classes]
    wanted = {norm(value) for value in expected_classes if norm(value)}
    while time.monotonic() < deadline:
        ready, _, _ = select.select([events], [], [], min(0.75, deadline - time.monotonic()))
        if not ready:
            continue
        try:
            data = events.recv(65536)
        except BlockingIOError:
            continue
        if not data:
            return
        buffer += data
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            text = line.decode("utf-8", "replace")
            if not text.startswith("openwindow>>"):
                continue
            pieces = text.split(">>", 1)[1].split(",", 3)
            if len(pieces) >= 3 and norm(pieces[2]) in wanted:
                return


def wait_for_fulfillment(
    saved_window: dict[str, Any],
    saved_windows: list[dict[str, Any]],
    events: socket.socket | None,
    timeout: float,
) -> bool:
    """Wait for both the outer window and any saved terminal TUI to be ready."""
    deadline = time.monotonic() + timeout
    wait_for_window(
        events,
        [str(saved_window.get("class", "")), str(saved_window.get("initial_class", ""))],
        timeout=min(1.5, timeout),
    )
    saved_id = str(saved_window.get("id", ""))
    while time.monotonic() < deadline:
        try:
            current = capture_snapshot(runtime=True)
            if saved_id in fulfilled_windows(saved_windows, list(current.get("windows", []))):
                return True
        except (RuntimeError, OSError, ValueError, json.JSONDecodeError):
            pass
        # Restore is the only polling path.  Two checks per second are enough
        # for startup readiness without turning a failed launch into a burst of
        # hyprctl and /proc scans.
        time.sleep(min(0.5, max(0.0, deadline - time.monotonic())))
    return False


def launch_window(
    window: dict[str, Any], quiet: bool, argv_override: list[str] | None = None
) -> bool:
    if argv_override is not None:
        argv = argv_override
    elif window.get("_singleton_extra_window") is True:
        argv = singleton_extra_window_argv(window)
    else:
        argv = launch_argv(window.get("launch"))
    if not argv:
        return False
    command = shlex.join(argv)
    workspace = workspace_selector(window.get("workspace", {}).get("name", "1"))
    # exec_cmd's workspace rule binds to the process Hyprland spawns. GNOME
    # Terminal's client hands the request to an already-running server and
    # exits, so the surface belongs to a pid the rule never matches: the window
    # maps on whatever workspace is visible and only then gets moved, which is
    # the shuffle seen at every login. A rule keyed on the one-time sentinel
    # title is evaluated when the surface maps, so the placement is right the
    # first time and no move is needed.
    sentinel = next(
        (
            value.removeprefix("--title=")
            for value in argv
            if value.startswith(f"--title={TERMINAL_BIND_TITLE_PREFIX}")
        ),
        "",
    )
    if sentinel and re.fullmatch(r"[A-Za-z0-9_]+", sentinel):
        dispatch(
            "hl.window_rule({ match = { title = "
            f"{lua_string('^' + re.escape(sentinel) + '$')}"
            " }, workspace = "
            f"{lua_string(workspace.removeprefix('name:') + ' silent')}"
            ", no_initial_focus = true })",
            quiet=quiet,
        )
    expression = (
        f"hl.dsp.exec_cmd({lua_string(command)}, "
        f"{{ workspace = {lua_string(workspace + ' silent')}, no_initial_focus = true }})"
    )
    return dispatch(expression, quiet=quiet)


def window_placement_operations(
    saved: dict[str, Any], current: dict[str, Any]
) -> list[tuple[str, str]]:
    """Describe one window placement without mutating compositor state."""
    address = str(current.get("address", ""))
    if re.fullmatch(r"0x[0-9A-Fa-f]+", address) is None:
        # A synthetic GNOME Terminal entry represents a tab which has no
        # compositor surface of its own. Its process-level fulfillment is
        # verified separately; placement belongs to the real outer window.
        if current.get("synthetic_terminal_tab", False):
            return []
        raise RuntimeError(f"cannot place matched window {saved.get('id', '')}: invalid address")
    selector = lua_string(f"address:{address}")
    operations: list[tuple[str, str]] = []

    saved_workspace_name = str(saved.get("workspace", {}).get("name", "1"))
    current_workspace = str(current.get("workspace", {}).get("name", ""))
    if saved_workspace_name != current_workspace:
        saved_workspace = workspace_selector(saved_workspace_name)
        expression = f"hl.dsp.window.move({{ workspace = {lua_string(saved_workspace)}, follow = false, window = {selector} }})"
        operations.append((expression, "workspace"))

    wants_float = bool(saved.get("floating", False))
    has_float = bool(current.get("floating", False))
    if wants_float != has_float:
        action = "set" if wants_float else "unset"
        operations.append(
            (
                f"hl.dsp.window.float({{ action = {lua_string(action)}, window = {selector} }})",
                "floating state",
            )
        )
    if wants_float:
        width, height = saved.get("size", [800, 600])
        x, y = saved.get("at", [0, 0])
        operations.append(
            (
                f"hl.dsp.window.resize({{ x = {int(width)}, y = {int(height)}, relative = false, window = {selector} }})",
                "floating size",
            )
        )
        operations.append(
            (
                f"hl.dsp.window.move({{ x = {int(x)}, y = {int(y)}, relative = false, window = {selector} }})",
                "floating position",
            )
        )
    if int(saved.get("fullscreen", 0)) != int(current.get("fullscreen", 0)) or int(
        saved.get("fullscreen_client", 0)
    ) != int(current.get("fullscreen_client", 0)):
        operations.append(
            (
                "hl.dsp.window.fullscreen_state({ "
                f"internal = {int(saved.get('fullscreen', 0))}, client = {int(saved.get('fullscreen_client', 0))}, "
                f"action = \"set\", window = {selector} }})",
                "fullscreen state",
            )
        )
    if bool(saved.get("pinned", False)) != bool(current.get("pinned", False)):
        action = "set" if saved.get("pinned") else "unset"
        operations.append(
            (
                f"hl.dsp.window.pin({{ action = {lua_string(action)}, window = {selector} }})",
                "pin state",
            )
        )
    return operations


def place_window(saved: dict[str, Any], current: dict[str, Any], quiet: bool) -> int:
    operations = window_placement_operations(saved, current)
    for expression, operation in operations:
        if not dispatch(expression, quiet=quiet):
            raise RuntimeError(
                f"window placement dispatch failed for {saved.get('id', '')}: {operation}"
            )
    return len(operations)


def place_window_if_inactive(
    saved: dict[str, Any], current: dict[str, Any], quiet: bool
) -> int:
    """Atomically place a background window only while both workspaces hide."""
    operations = window_placement_operations(saved, current)
    if not operations:
        return 0
    workspace_names: list[str] = []
    for candidate in (
        (saved.get("workspace") or {}).get("name", ""),
        (current.get("workspace") or {}).get("name", ""),
    ):
        name = str(candidate)
        if valid_workspace_name(name) and name not in workspace_names:
            workspace_names.append(name)
    routes = [{"workspace": name} for name in workspace_names]
    expressions = [expression for expression, _operation in operations]
    committed = commit_guarded_workspace_transaction(
        expressions, routes, quiet=quiet
    )
    return committed if committed == len(expressions) else 0


def tiled_topology_swap_expressions(
    saved_windows: list[dict[str, Any]],
    current_windows: list[dict[str, Any]],
    matches: dict[str, dict[str, Any]],
) -> list[str]:
    """Restore which semantic window occupies each existing tiled slot.

    Hyprland already owns the Dwindle tree.  Swapping matched clients between
    its final slots is safer than trying to serialize compositor internals.
    A workspace is skipped unless its complete tiled set is unambiguous.
    """

    def eligible(window: dict[str, Any]) -> bool:
        return (
            not bool(window.get("floating", False))
            and not bool(window.get("pinned", False))
            and int(window.get("fullscreen", 0) or 0) == 0
            and int(window.get("fullscreen_client", 0) or 0) == 0
        )

    def slot(window: dict[str, Any]) -> tuple[int, int, int, int]:
        at = window.get("at") or [0, 0]
        size = window.get("size") or [1, 1]
        return (int(at[1]), int(at[0]), int(size[1]), int(size[0]))

    saved_by_workspace: dict[str, list[dict[str, Any]]] = {}
    for window in saved_windows:
        matched = matches.get(str(window.get("id", "")))
        matched_address = str((matched or {}).get("address", ""))
        if eligible(window) and re.fullmatch(r"0x[0-9A-Fa-f]+", matched_address):
            name = str((window.get("workspace") or {}).get("name", ""))
            if name:
                saved_by_workspace.setdefault(name, []).append(window)

    expressions: list[str] = []
    for workspace, saved_group in sorted(saved_by_workspace.items()):
        current_group = [
            window
            for window in current_windows
            if eligible(window)
            and str((window.get("workspace") or {}).get("name", "")) == workspace
            and re.fullmatch(r"0x[0-9A-Fa-f]+", str(window.get("address", "")))
        ]
        matched_group: list[tuple[dict[str, Any], dict[str, Any]]] = []
        safe = True
        for saved in saved_group:
            current = matches.get(str(saved.get("id", "")))
            address = str((current or {}).get("address", ""))
            if (
                current is None
                or not eligible(current)
                or str((current.get("workspace") or {}).get("name", "")) != workspace
                or re.fullmatch(r"0x[0-9A-Fa-f]+", address) is None
            ):
                safe = False
                break
            matched_group.append((saved, current))
        if not safe:
            continue

        matched_addresses = [str(current.get("address")) for _, current in matched_group]
        current_addresses = [str(window.get("address", "")) for window in current_group]
        if (
            len(saved_group) != len(current_group)
            or len(set(matched_addresses)) != len(matched_addresses)
            or set(matched_addresses) != set(current_addresses)
            or any(re.fullmatch(r"0x[0-9A-Fa-f]+", address) is None for address in current_addresses)
        ):
            continue

        saved_slots = [slot(saved) for saved, _ in matched_group]
        current_slots = [slot(current) for current in current_group]
        if len(set(saved_slots)) != len(saved_slots) or len(set(current_slots)) != len(current_slots):
            continue

        desired_order = [
            str(current.get("address"))
            for saved, current in sorted(matched_group, key=lambda pair: slot(pair[0]))
        ]
        live_order = [str(window.get("address")) for window in sorted(current_group, key=slot)]
        positions = {address: index for index, address in enumerate(live_order)}
        for target_index, desired_address in enumerate(desired_order):
            occupant = live_order[target_index]
            if occupant == desired_address:
                continue
            source_index = positions[desired_address]
            expressions.append(
                "hl.dsp.window.swap({ "
                f"window = {lua_string('address:' + desired_address)}, "
                f"target = {lua_string('address:' + occupant)} }})"
            )
            live_order[target_index], live_order[source_index] = live_order[source_index], live_order[target_index]
            positions[occupant] = source_index
            positions[desired_address] = target_index
    return expressions


def workspace_monitor_expressions(
    saved_state: dict[str, Any],
    current_state: dict[str, Any],
    quiet: bool,
    workspace_names: set[str] | None = None,
) -> list[str]:
    """Build workspace-output moves for the guarded compositor transaction."""
    current_by_name = {str(item.get("name")): item for item in current_state.get("workspaces", [])}
    try:
        live_monitors = [
            item for item in hypr_json("monitors") if isinstance(item, dict)
        ]
    except (RuntimeError, ValueError):
        return []
    available_monitors = {str(item.get("name")) for item in live_monitors}
    monitor_by_id = {
        item_id: str(item.get("name", ""))
        for item in live_monitors
        for item_id in [monitor_role_id(item)]
        if item_id is not None and str(item.get("name", ""))
    }
    expressions: list[str] = []
    for workspace in saved_state.get("workspaces", []):
        name = str(workspace.get("name", ""))
        monitor = str(workspace.get("monitor", ""))
        owner = numeric_workspace_owner(name)
        if owner in monitor_by_id:
            # The numeric group is authoritative. A snapshot captured while
            # its output was absent may legitimately say workspace 11 lived
            # on eDP-1; once monitor 1 exists it belongs there again.
            monitor = monitor_by_id[owner]
        if workspace_names is not None and name not in workspace_names:
            continue
        current = current_by_name.get(name)
        if not current or not monitor or monitor not in available_monitors or current.get("monitor") == monitor:
            continue
        expressions.append(
            "hl.dsp.workspace.move({ "
            f"workspace = {lua_string(workspace_selector(name))}, monitor = {lua_string(monitor)} }})"
        )
    return expressions


def workspace_inactive_guard(routes: list[dict[str, Any]]) -> str:
    """Build same-IPC preconditions preventing an active workspace teleport."""
    checks: list[str] = []
    for index, item in enumerate(routes):
        variable = f"route_workspace_{index}"
        selector = lua_string(workspace_selector(item.get("workspace", "")))
        checks.extend(
            [
                f"local {variable} = hl.get_workspace({selector})",
                f"if not {variable} then error('route workspace disappeared') end",
                f"if {variable}.active or {variable}.visible then "
                "error('route workspace became active or visible') end",
            ]
        )
    return "; ".join(checks)


def commit_focus_transaction(
    expressions: list[str], quiet: bool, precondition: str = ""
) -> int:
    """Apply workspace/focus changes without exposing intermediate frames."""
    if not expressions:
        return 0
    animations_were_enabled = hypr_option_bool("animations:enabled")
    cursor_no_warps = hypr_option_bool("cursor:no_warps")
    if animations_were_enabled is None or cursor_no_warps is None:
        if not quiet:
            eprint("session restore transaction refused: compositor options unavailable")
        return 0
    animations_literal = "true" if animations_were_enabled else "false"
    no_warps_literal = "true" if cursor_no_warps else "false"
    body = checked_dispatch_body(expressions)
    code = (
        f"local expected_animations = {animations_literal}; "
        f"local expected_no_warps = {no_warps_literal}; "
        "local current_animations, animations_error = hl.get_config('animations.enabled'); "
        "local current_no_warps, cursor_error = hl.get_config('cursor.no_warps'); "
        "if type(current_animations) ~= 'boolean' or current_animations ~= expected_animations then "
        "error(animations_error or 'animation state unavailable or changed') end; "
        "if type(current_no_warps) ~= 'boolean' or current_no_warps ~= expected_no_warps then "
        "error(cursor_error or 'cursor state unavailable or changed') end; "
        "local ok, err = pcall(function() "
        "hl.config({ animations = { enabled = false }, cursor = { no_warps = true } }); "
        "if hl.get_config('animations.enabled') ~= false then error('animation suppression failed') end; "
        "if hl.get_config('cursor.no_warps') ~= true then error('cursor warp suppression failed') end; "
        f"{precondition}; {body} end); "
        "hl.config({ animations = { enabled = expected_animations }, cursor = { no_warps = expected_no_warps } }); "
        "if hl.get_config('animations.enabled') ~= expected_animations then error('animation restore failed') end; "
        "if hl.get_config('cursor.no_warps') ~= expected_no_warps then error('cursor restore failed') end; "
        "if not ok then error(err) end; "
        "return true"
    )
    ok = eval_lua(code, quiet=quiet)
    if not ok:
        # IPC failure is ambiguous: the compositor may have completed the
        # call after the client timed out. Recover only if state actually
        # differs, without adding a successful-path delay.
        final_animations = hypr_option_bool("animations:enabled")
        final_no_warps = hypr_option_bool("cursor:no_warps")
        if final_animations == animations_were_enabled and final_no_warps == cursor_no_warps:
            return 0
        recovery = (
            f"local expected_animations = {animations_literal}; "
            f"local expected_no_warps = {no_warps_literal}; "
            "hl.config({ animations = { enabled = expected_animations }, cursor = { no_warps = expected_no_warps } }); "
            "if hl.get_config('animations.enabled') ~= expected_animations then error('animation recovery failed') end; "
            "if hl.get_config('cursor.no_warps') ~= expected_no_warps then error('cursor recovery failed') end; return true"
        )
        eval_lua(recovery, quiet=True)
        if not quiet:
            eprint("session restore transaction failed; compositor options recovered")
        return 0
    return len(expressions)


def commit_guarded_workspace_transaction(
    expressions: list[str],
    routes: list[dict[str, Any]],
    quiet: bool,
    expected_monitors: list[dict[str, Any]] | None = None,
) -> int:
    preconditions: list[str] = []
    if expected_monitors is not None:
        topology_guard = compositor_monitor_topology_guard(expected_monitors)
        if topology_guard is None:
            return 0
        preconditions.append(topology_guard)
    preconditions.append(workspace_inactive_guard(routes))
    return commit_focus_transaction(
        expressions,
        quiet=quiet,
        precondition="; ".join(item for item in preconditions if item),
    )


def checked_dispatch_body(expressions: list[str]) -> str:
    """Build a fail-fast Lua body without creating intermediate IPC frames."""
    operations: list[str] = []
    for index, expression in enumerate(expressions):
        result_name = f"dispatch_result_{index}"
        operations.append(f"local {result_name} = hl.dispatch({expression})")
        operations.append(
            f"if not ({result_name} and {result_name}.ok) then "
            f"error(({result_name} and {result_name}.error) or 'dispatcher failed') end"
        )
    return "; ".join(operations)


def commit_restore_reveal(
    expressions: list[str], state: dict[str, Any] | None, quiet: bool
) -> tuple[int, bool]:
    """Finish the foreground transaction without changing its workspace.

    An empty operation list is still a real transaction: it restores normal
    animations, marks the compositor guard revealed, and keeps activation
    stealing disabled while deferred workspaces finish.  Returning an
    explicit success bit avoids treating both an empty success and an IPC
    failure as the same integer zero.
    """
    if not state:
        return 0, False
    animations = "true" if state["animations"] else "false"
    token = str(state.get("staging_token", ""))
    if not token:
        return 0, False
    body = checked_dispatch_body(expressions)
    code = (
        f"local expected_token = {lua_string(token)}; "
        f"local guard = _G.{RESTORE_GUARD_GLOBAL}; "
        "if type(guard) ~= 'table' or guard.token ~= expected_token then error('restore guard unavailable or replaced') end; "
        "if type(guard.rollback) ~= 'function' then error('restore guard rollback unavailable') end; "
        f"local ok, err = pcall(function() {body}; "
        f"hl.config({{ animations = {{ enabled = {animations} }}, "
        "cursor = { no_warps = true }, misc = { focus_on_activate = false } }); "
        f"if hl.get_config('animations.enabled') ~= {animations} then error('animation reveal restore failed') end; "
        "if hl.get_config('cursor.no_warps') ~= true then error('cursor reveal guard failed') end; "
        "if hl.get_config('misc.focus_on_activate') ~= false then error('activation reveal guard failed') end "
        "end); "
        "if not ok then "
        "guard.revealed = false; "
        "local rollback_complete = guard.rollback(); "
        "if not rollback_complete then error(tostring(err) .. '; foreground rollback failed') end; "
        "error(err) end; "
        "guard.revealed = true; "
        "return true"
    )
    ok = eval_lua(code, quiet=quiet)
    return (len(expressions) if ok else 0), ok


def commit_background_transaction(expressions: list[str], quiet: bool) -> int:
    """Arrange invisible workspaces without touching focus or animation state."""
    if not expressions:
        return 0
    body = checked_dispatch_body(expressions)
    return len(expressions) if eval_lua(f"{body}; return true", quiet=quiet) else 0


def commit_inactive_workspace_routes(
    routes: list[dict[str, Any]],
    expected_monitors: list[dict[str, Any]],
    *,
    quiet: bool,
) -> int:
    """Atomically recheck inactivity and route whole workspaces in one IPC."""
    if not routes:
        return 0
    topology_guard = compositor_monitor_topology_guard(expected_monitors)
    if topology_guard is None:
        return 0
    expressions = [
        "hl.dsp.workspace.move({ "
        f"workspace = {lua_string(workspace_selector(item['workspace']))}, "
        f"monitor = {lua_string(item['to_monitor'])} }})"
        for item in routes
    ]
    code = (
        f"{topology_guard}; {workspace_inactive_guard(routes)}; "
        f"{checked_dispatch_body(expressions)}; return true"
    )
    return len(expressions) if eval_lua(code, quiet=quiet) else 0


def fallback_launch_plan(
    saved_windows: list[dict[str, Any]],
    fulfilled: dict[str, dict[str, Any]],
    attempted_terminal_ids: set[str],
) -> list[dict[str, Any]]:
    """Plan bounded second-pass launches after native session restore settles.

    Ordinary applications keep their previous one-retry behavior.  A
    single-instance browser is repaired by surface deficit: each still-missing
    saved client gets one native new-window request, never another profile
    bootstrap.
    """
    plan: list[dict[str, Any]] = []
    for window in saved_windows:
        if window.get("id") in fulfilled:
            continue
        if (
            (window.get("launch") or {}).get("kind") == "terminal"
            and str(window.get("id")) in attempted_terminal_ids
        ):
            continue
        if single_instance_class_key(window):
            if singleton_extra_window_argv(window) is None:
                continue
            candidate = copy.deepcopy(window)
            candidate["_singleton_extra_window"] = True
            plan.append(candidate)
            continue
        if launch_argv(window.get("launch")):
            plan.append(window)
    return plan


def restore_spawned_singleton_surplus(
    saved_windows: list[dict[str, Any]],
    current_windows: list[dict[str, Any]],
    matches: dict[str, dict[str, Any]],
    spawned_addresses: set[str],
) -> list[str]:
    """Select only unmatched surplus browser surfaces created by this restore."""
    saved_counts: dict[str, int] = {}
    current_groups: dict[str, list[dict[str, Any]]] = {}
    for window in saved_windows:
        key = single_instance_class_key(window)
        if key:
            saved_counts[key] = saved_counts.get(key, 0) + 1
    for window in current_windows:
        key = single_instance_class_key(window)
        if key:
            current_groups.setdefault(key, []).append(window)

    matched_addresses = {
        str(window.get("address", ""))
        for window in matches.values()
        if re.fullmatch(r"0x[0-9A-Fa-f]+", str(window.get("address", "")))
    }
    surplus_addresses: list[str] = []
    for key, windows in current_groups.items():
        surplus = max(0, len(windows) - saved_counts.get(key, 0))
        if surplus <= 0:
            continue
        candidates = sorted(
            (
                str(window.get("address", ""))
                for window in windows
                if str(window.get("address", "")) in spawned_addresses
                and str(window.get("address", "")) not in matched_addresses
                and re.fullmatch(
                    r"0x[0-9A-Fa-f]+", str(window.get("address", ""))
                )
            )
        )
        surplus_addresses.extend(candidates[:surplus])
    return surplus_addresses


def close_restore_spawned_surplus(addresses: list[str], quiet: bool) -> int:
    """Close only proven restore-created surplus clients, never user windows."""
    valid = [
        address
        for address in addresses
        if re.fullmatch(r"0x[0-9A-Fa-f]+", address)
    ]
    if not valid:
        return 0
    expressions = [
        "hl.dsp.window.close({ window = "
        f"{lua_string('address:' + address)} }})"
        for address in valid
    ]
    return commit_background_transaction(expressions, quiet=quiet)


def wait_for_closed_addresses(
    addresses: list[str], events: socket.socket | None, timeout: float = 2.0
) -> bool:
    remaining = set(addresses)
    deadline = time.monotonic() + timeout
    while remaining and time.monotonic() < deadline:
        try:
            live = {
                str(client.get("address", ""))
                for client in hypr_json("clients")
                if isinstance(client, dict)
            }
            remaining.intersection_update(live)
        except (RuntimeError, ValueError, json.JSONDecodeError):
            pass
        if not remaining:
            return True
        wait = min(0.2, max(0.0, deadline - time.monotonic()))
        if events is None:
            time.sleep(wait)
            continue
        ready, _, _ = select.select([events], [], [], wait)
        if ready:
            try:
                events.recv(65536)
            except (BlockingIOError, OSError):
                pass
    return not remaining


def foreground_workspace_names(saved_state: dict[str, Any]) -> set[str]:
    """Return each monitor group's primary workspace for the first frame.

    Persisted monitor IDs let workspace 1 (and 11, 21, ... on additional
    outputs) win over the last-focused workspace. Older snapshots without
    monitor metadata retain their saved-active behavior as a safe fallback.
    """
    monitor_ids: dict[str, int] = {}
    all_monitor_ids: set[int] = set()
    legacy_monitor_metadata = False
    for workspace in saved_state.get("workspaces", []):
        if not isinstance(workspace, dict):
            continue
        monitor = str(workspace.get("monitor", ""))
        if monitor and "monitor_id" not in workspace:
            legacy_monitor_metadata = True
            continue
        if "monitor_id" not in workspace:
            continue
        monitor_number = monitor_id(workspace.get("monitor_id"))
        if monitor:
            monitor_ids[monitor] = monitor_number
        all_monitor_ids.add(monitor_number)

    if not legacy_monitor_metadata:
        result = {
            str(default_workspace_id(monitor_ids[str(item.get("monitor"))]))
            for item in saved_state.get("monitor_workspaces", [])
            if isinstance(item, dict) and str(item.get("monitor", "")) in monitor_ids
        }
        if not result and all_monitor_ids:
            result = {str(default_workspace_id(value)) for value in all_monitor_ids}
        if result:
            return result

    result = {
        str(item.get("workspace", ""))
        for item in saved_state.get("monitor_workspaces", [])
        if isinstance(item, dict) and valid_workspace_name(item.get("workspace"))
    }
    if not result:
        focus_workspace = str((saved_state.get("focus") or {}).get("workspace", ""))
        if valid_workspace_name(focus_workspace):
            result.add(focus_workspace)
    return result or {"1"}


def foreground_monitor_targets(
    saved_state: dict[str, Any], foreground: set[str]
) -> list[dict[str, Any]]:
    """Map primary workspaces back to outputs for the atomic reveal."""
    workspace_monitors = {
        str(item.get("name", "")): str(item.get("monitor", ""))
        for item in saved_state.get("workspaces", [])
        if isinstance(item, dict) and valid_workspace_name(item.get("name"))
    }
    monitor_primaries = {
        str(item.get("monitor", "")): str(
            default_workspace_id(item.get("monitor_id"))
        )
        for item in saved_state.get("workspaces", [])
        if isinstance(item, dict) and item.get("monitor") and "monitor_id" in item
    }
    targets: list[dict[str, Any]] = []
    for active in saved_state.get("monitor_workspaces", []):
        if not isinstance(active, dict):
            continue
        monitor = str(active.get("monitor", ""))
        primary = monitor_primaries.get(monitor, "")
        candidates = sorted(
            (name for name in foreground if workspace_monitors.get(name) == monitor),
            key=lambda name: (not name.isdigit(), int(name) if name.isdigit() else 0, name),
        )
        if not candidates and primary in foreground:
            candidates = [primary]
        saved_active = str(active.get("workspace", ""))
        if not candidates and saved_active in foreground:
            candidates = [saved_active]
        if monitor and candidates:
            targets.append(
                {
                    "monitor": monitor,
                    "workspace": candidates[0],
                    "focused": bool(active.get("focused", False)),
                }
            )
    return targets


def reconcile_foreground_targets(
    saved_targets: list[dict[str, Any]],
    live_monitor_workspaces: list[dict[str, Any]],
) -> tuple[list[dict[str, Any]], set[str]]:
    """Select one primary workspace per live output without focusing a missing one."""
    live = [
        item
        for item in live_monitor_workspaces
        if isinstance(item, dict) and str(item.get("monitor", ""))
    ]
    if not live:
        # Offline/dry-run fixtures and early compositor startup may not expose
        # monitors yet. Keep the saved plan; begin_guard will still fail closed
        # before any mutation if no real output exists.
        return [copy.deepcopy(item) for item in saved_targets], set()

    live_names = {str(item.get("monitor", "")) for item in live}
    missing = {
        str(item.get("monitor", ""))
        for item in saved_targets
        if str(item.get("monitor", "")) and str(item.get("monitor", "")) not in live_names
    }
    saved_by_monitor = {
        str(item.get("monitor", "")): item
        for item in saved_targets
        if isinstance(item, dict) and str(item.get("monitor", ""))
    }
    targets: list[dict[str, Any]] = []
    for index, monitor_state in enumerate(live):
        monitor = str(monitor_state.get("monitor", ""))
        saved = saved_by_monitor.get(monitor)
        if saved and valid_workspace_name(saved.get("workspace")):
            workspace = str(saved.get("workspace"))
            saved_focused = bool(saved.get("focused", False))
        else:
            workspace = str(
                default_workspace_id(monitor_state.get("monitor_id", index))
            )
            saved_focused = False
        targets.append(
            {
                "monitor": monitor,
                "workspace": workspace,
                "focused": saved_focused,
            }
        )

    saved_focus = next(
        (str(item["monitor"]) for item in targets if item.get("focused")),
        "",
    )
    live_focus = next(
        (str(item.get("monitor", "")) for item in live if item.get("focused")),
        "",
    )
    focused_monitor = saved_focus or live_focus or str(targets[0]["monitor"])
    for target in targets:
        target["focused"] = str(target["monitor"]) == focused_monitor
    return targets, missing


def live_foreground_targets(current_state: dict[str, Any]) -> list[dict[str, Any]]:
    """Pin the workspaces which are visible when login restore begins.

    Saved focus describes where the previous session ended; it must not drive
    the new compositor through those workspaces on screen.  Each live monitor
    already has a safe initial workspace, so that becomes its immutable
    foreground while every other workspace is rebuilt silently.
    """
    targets: list[dict[str, Any]] = []
    seen_monitors: set[str] = set()
    for item in current_state.get("monitor_workspaces", []):
        if not isinstance(item, dict):
            continue
        monitor = str(item.get("monitor", ""))
        workspace = str(item.get("workspace", ""))
        if (
            not monitor
            or monitor in seen_monitors
            or not valid_workspace_name(workspace)
        ):
            continue
        targets.append(
            {
                "monitor": monitor,
                "workspace": workspace,
                "focused": bool(item.get("focused", False)),
            }
        )
        seen_monitors.add(monitor)
    if targets and not any(item.get("focused", False) for item in targets):
        targets[0]["focused"] = True
    return targets


def partition_windows_by_workspace(
    windows: list[dict[str, Any]], foreground: set[str]
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """Stable, exhaustive partition for foreground and deferred restore."""
    foreground_windows: list[dict[str, Any]] = []
    deferred_windows: list[dict[str, Any]] = []
    for window in windows:
        workspace = str((window.get("workspace") or {}).get("name", ""))
        (foreground_windows if workspace in foreground else deferred_windows).append(window)
    return foreground_windows, deferred_windows


def build_launch_plan(
    missing: list[dict[str, Any]],
    foreground: set[str],
    fulfilled_singleton_groups: set[str] | None = None,
) -> list[dict[str, Any]]:
    """Choose group bootstraps or exact surface repairs for missing windows."""
    visible, deferred = partition_windows_by_workspace(missing, foreground)
    live_singleton_groups = fulfilled_singleton_groups or set()
    groups_planned: set[str] = set()
    plan: list[dict[str, Any]] = []
    for window in [*visible, *deferred]:
        class_key = norm(window.get("class"))
        legacy_singleton_group = (
            f"singleton:{class_key}:{launch_key(window)}"
            if class_key in SINGLE_INSTANCE_CLASSES
            else ""
        )
        group = str(
            window.get("launch_group")
            or legacy_singleton_group
            or window.get("id")
            or launch_key(window)
        )
        if (
            single_instance_class_key(window)
            and group in live_singleton_groups
            and singleton_extra_window_argv(window) is not None
        ):
            candidate = copy.deepcopy(window)
            candidate["_singleton_extra_window"] = True
            plan.append(candidate)
            continue
        if group in groups_planned:
            continue
        if launch_argv(window.get("launch")):
            plan.append(window)
            groups_planned.add(group)
    return plan


def active_workspace_names(state: dict[str, Any]) -> set[str]:
    return {
        str(item.get("workspace", ""))
        for item in state.get("monitor_workspaces", [])
        if isinstance(item, dict) and valid_workspace_name(item.get("workspace"))
    }


def background_mutation_allowed(
    saved_window: dict[str, Any],
    current_window: dict[str, Any] | None,
    active_workspaces: set[str],
) -> bool:
    """Never rearrange a workspace which became visible during Phase B."""
    if current_window is None:
        return False
    saved_workspace = str((saved_window.get("workspace") or {}).get("name", ""))
    current_workspace = str((current_window.get("workspace") or {}).get("name", ""))
    return (
        saved_workspace not in active_workspaces
        and current_workspace not in active_workspaces
    )


def verify_foreground_focus(
    targets: list[dict[str, Any]],
    post_monitors: list[dict[str, Any]],
    post_active_window: dict[str, Any] | None,
    expected_window_address: str = "",
) -> dict[str, Any]:
    """Pure postcondition for the user-visible workspace and keyboard focus."""
    errors: list[str] = []
    monitors = {
        str(item.get("name", "")): item
        for item in post_monitors
        if isinstance(item, dict) and str(item.get("name", ""))
    }
    for target in targets:
        monitor = str(target.get("monitor", ""))
        wanted = str(target.get("workspace", ""))
        current = monitors.get(monitor)
        if current is None:
            errors.append(f"foreground monitor {monitor or '<unknown>'} disappeared")
            continue
        actual = str((current.get("activeWorkspace") or {}).get("name", ""))
        if wanted and actual != wanted:
            errors.append(f"{monitor}: expected workspace {wanted}, got {actual or '<none>'}")

    expected_monitor = next(
        (str(item.get("monitor", "")) for item in targets if item.get("focused")),
        "",
    )
    actual_monitor = next(
        (name for name, item in monitors.items() if item.get("focused")),
        "",
    )
    if expected_monitor and actual_monitor != expected_monitor:
        errors.append(
            f"expected focused monitor {expected_monitor}, got {actual_monitor or '<none>'}"
        )

    if expected_window_address:
        actual_address = str((post_active_window or {}).get("address", ""))
        if actual_address != expected_window_address:
            errors.append("focused window did not reach its saved target")
    return {"ok": not errors, "errors": errors}


def verify_placement_invariant(
    saved_windows: list[dict[str, Any]],
    current_windows: list[dict[str, Any]],
    matches: dict[str, dict[str, Any]],
    saved_state: dict[str, Any] | None = None,
    current_state: dict[str, Any] | None = None,
    *,
    floating_tolerance: int = 3,
    pinned_workspace_monitors: dict[str, str] | None = None,
) -> dict[str, Any]:
    """Prove that every saved client reached its final semantic placement.

    Tiled pixel geometry is intentionally not compared because exclusive zones
    can resize it at login.  Its stable invariant is the complete client set
    and ordering within each workspace.
    """
    errors: list[str] = []
    matched_addresses: dict[str, str] = {}

    def workspace_name(window: dict[str, Any]) -> str:
        return str((window.get("workspace") or {}).get("name", ""))

    def pair(value: Any, default: tuple[int, int]) -> tuple[int, int]:
        try:
            return int(value[0]), int(value[1])
        except (IndexError, TypeError, ValueError):
            return default

    def tiled(window: dict[str, Any]) -> bool:
        return (
            not bool(window.get("floating", False))
            and not bool(window.get("pinned", False))
            and int(window.get("fullscreen", 0) or 0) == 0
            and int(window.get("fullscreen_client", 0) or 0) == 0
        )

    def slot(window: dict[str, Any]) -> tuple[int, int, int, int]:
        x, y = pair(window.get("at"), (0, 0))
        width, height = pair(window.get("size"), (1, 1))
        return y, x, height, width

    for saved in saved_windows:
        saved_id = str(saved.get("id", ""))
        current = matches.get(saved_id)
        if current is None:
            errors.append(f"{saved_id or '<unknown>'}: window is unmatched")
            continue
        address = str(current.get("address", ""))
        synthetic_tab = bool(current.get("synthetic_terminal_tab", False))
        if re.fullmatch(r"0x[0-9A-Fa-f]+", address) is None and not synthetic_tab:
            errors.append(f"{saved_id}: matched window has an invalid address")
        elif address and address in matched_addresses:
            errors.append(
                f"{saved_id}: duplicates live window already matched by {matched_addresses[address]}"
            )
        elif address:
            matched_addresses[address] = saved_id

        wanted_workspace = workspace_name(saved)
        actual_workspace = workspace_name(current)
        if actual_workspace != wanted_workspace:
            errors.append(
                f"{saved_id}: expected workspace {wanted_workspace}, got {actual_workspace or '<none>'}"
            )
        for key, label in (
            ("floating", "floating"),
            ("pinned", "pinned"),
        ):
            if bool(current.get(key, False)) != bool(saved.get(key, False)):
                errors.append(f"{saved_id}: {label} state differs")
        for key, label in (
            ("fullscreen", "fullscreen"),
            ("fullscreen_client", "client fullscreen"),
        ):
            if int(current.get(key, 0) or 0) != int(saved.get(key, 0) or 0):
                errors.append(f"{saved_id}: {label} state differs")
        if bool(saved.get("floating", False)):
            wanted_at = pair(saved.get("at"), (0, 0))
            actual_at = pair(current.get("at"), (0, 0))
            wanted_size = pair(saved.get("size"), (800, 600))
            actual_size = pair(current.get("size"), (800, 600))
            if any(abs(left - right) > floating_tolerance for left, right in zip(wanted_at, actual_at)):
                errors.append(f"{saved_id}: floating position differs")
            if any(abs(left - right) > floating_tolerance for left, right in zip(wanted_size, actual_size)):
                errors.append(f"{saved_id}: floating size differs")

    saved_tiled: dict[str, list[dict[str, Any]]] = {}
    for saved in saved_windows:
        current = matches.get(str(saved.get("id", "")))
        current_address = str((current or {}).get("address", ""))
        if tiled(saved) and re.fullmatch(r"0x[0-9A-Fa-f]+", current_address):
            saved_tiled.setdefault(workspace_name(saved), []).append(saved)
    for workspace, saved_group in saved_tiled.items():
        current_group = [
            window
            for window in current_windows
            if tiled(window)
            and workspace_name(window) == workspace
            and re.fullmatch(r"0x[0-9A-Fa-f]+", str(window.get("address", "")))
        ]
        if len(current_group) != len(saved_group):
            errors.append(
                f"workspace {workspace}: expected {len(saved_group)} tiled windows, got {len(current_group)}"
            )
            continue
        saved_order = [
            str(item.get("id", "")) for item in sorted(saved_group, key=slot)
        ]
        live_to_saved = {
            str(current.get("address", "")): saved_id
            for saved_id, current in matches.items()
            if current is not None
        }
        current_order = [
            live_to_saved.get(str(item.get("address", "")), "")
            for item in sorted(current_group, key=slot)
        ]
        saved_slots = [slot(item) for item in saved_group]
        current_slots = [slot(item) for item in current_group]
        if len(set(saved_slots)) != len(saved_slots) or len(set(current_slots)) != len(current_slots):
            errors.append(f"workspace {workspace}: tiled slots are ambiguous")
            continue
        if current_order != saved_order:
            errors.append(f"workspace {workspace}: tiled order differs")

    if saved_state is not None and current_state is not None:
        live_monitors = {
            str(item.get("monitor", ""))
            for item in current_state.get("monitor_workspaces", [])
            if isinstance(item, dict) and str(item.get("monitor", ""))
        }
        current_workspaces = {
            str(item.get("name", "")): item
            for item in current_state.get("workspaces", [])
            if isinstance(item, dict) and valid_workspace_name(item.get("name"))
        }
        live_monitor_by_id = {
            item_id: str(item.get("monitor", ""))
            for item in current_state.get("monitor_workspaces", [])
            if isinstance(item, dict)
            for item_id in [
                monitor_role_id(item.get("monitor_id"), item.get("monitor", ""))
            ]
            if item_id is not None and str(item.get("monitor", ""))
        }
        referenced = {workspace_name(window) for window in saved_windows}
        for workspace in saved_state.get("workspaces", []):
            if not isinstance(workspace, dict):
                continue
            name = str(workspace.get("name", ""))
            monitor = str(workspace.get("monitor", ""))
            pinned_monitor = str(
                (pinned_workspace_monitors or {}).get(name, "")
            )
            if pinned_monitor:
                monitor = pinned_monitor
            else:
                owner = numeric_workspace_owner(name)
                if owner in live_monitor_by_id:
                    monitor = live_monitor_by_id[owner]
            if name not in referenced and not workspace.get("persistent", False):
                continue
            if not monitor or monitor not in live_monitors:
                continue
            actual_monitor = str((current_workspaces.get(name) or {}).get("monitor", ""))
            if actual_monitor != monitor:
                errors.append(
                    f"workspace {name}: expected monitor {monitor}, got {actual_monitor or '<none>'}"
                )

    # Separate "the desktop is a half-applied snapshot" from "the desktop is
    # complete but two tiled windows sit in the other order". Only the former
    # justifies freezing the snapshot; the latter is self-correcting, because
    # recording the live order is what makes the next restore reproduce it.
    result: dict[str, Any] = {"ok": not errors, "errors": errors}
    if errors:
        result["ordering_only"] = all(
            error.endswith(": tiled order differs") for error in errors
        )
    return result


def restore_sort_key(window: dict[str, Any]) -> tuple[int, int, int]:
    workspace = window.get("workspace") or {}
    at = window.get("at") or [0, 0]
    try:
        workspace_id = int(workspace.get("id", 0) or 0)
    except (TypeError, ValueError):
        workspace_id = 0
    try:
        x, y = int(at[0]), int(at[1])
    except (TypeError, ValueError, IndexError):
        x, y = 0, 0
    return workspace_id, y, x


def wait_for_window_group(
    targets: list[dict[str, Any]],
    saved_windows: list[dict[str, Any]],
    events: socket.socket | None,
    deadline: float,
    staging_token: str | None = None,
) -> dict[str, dict[str, Any]]:
    """Wait once for a parallel launch group instead of serial per-app waits."""
    target_ids = {str(window.get("id", "")) for window in targets if window.get("id")}
    fulfilled: dict[str, dict[str, Any]] = {}
    while target_ids and time.monotonic() < deadline:
        try:
            current = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            fulfilled = fulfilled_windows(saved_windows, list(current.get("windows", [])))
            if target_ids.issubset(fulfilled):
                break
        except (RuntimeError, OSError, ValueError, json.JSONDecodeError):
            pass
        timeout = min(0.4, max(0.0, deadline - time.monotonic()))
        if events is None:
            time.sleep(timeout)
            continue
        ready, _, _ = select.select([events], [], [], timeout)
        if ready:
            try:
                events.recv(65536)
            except (BlockingIOError, OSError):
                pass
    return fulfilled


def launch_window_group(
    plan: list[dict[str, Any]],
    saved_windows: list[dict[str, Any]],
    fulfilled: dict[str, dict[str, Any]],
    attempted_terminal_ids: set[str],
    events: socket.socket | None,
    deadline: float,
    quiet: bool,
    staging_token: str | None = None,
    spawned_addresses: set[str] | None = None,
) -> int:
    """Keep apps parallel, but serialize terminal ACK ownership for correctness."""
    application_targets: list[dict[str, Any]] = []
    terminal_targets: list[dict[str, Any]] = []
    launched_application_groups: set[str] = set()
    launched_application_ids: set[str] = set()
    preexisting_addresses: set[str] | None = None
    if spawned_addresses is not None:
        try:
            preexisting_addresses = {
                str(client.get("address", ""))
                for client in hypr_json("clients")
                if isinstance(client, dict)
                and re.fullmatch(
                    r"0x[0-9A-Fa-f]+", str(client.get("address", ""))
                )
            }
        except (RuntimeError, ValueError, json.JSONDecodeError):
            # Fail closed: without an exact baseline no foreground exception is
            # granted to any subsequently matched window.
            preexisting_addresses = None
    launched = 0
    for window in sorted(plan, key=restore_sort_key):
        window_id = str(window.get("id", ""))
        if not window_id or window_id in fulfilled or time.monotonic() >= deadline:
            continue
        if (window.get("launch") or {}).get("kind") == "terminal":
            attempted_terminal_ids.add(window_id)
            terminal_targets.append(window)
            continue
        if launch_window(window, quiet=quiet):
            launched += 1
            application_targets.append(window)
            launched_application_ids.add(window_id)
            group = str(window.get("launch_group", ""))
            if group:
                launched_application_groups.add(group)

    for window in terminal_targets:
        if time.monotonic() >= deadline:
            break
        try:
            prepared = prepare_terminal_binding(window)
        except (OSError, ValueError, RuntimeError):
            prepared = None
        if prepared is None:
            continue
        token = str(prepared["token"])
        if not launch_window(window, quiet=quiet, argv_override=prepared["argv"]):
            cancel_terminal_binding(token)
            continue
        launched += 1
        terminal_ready = wait_for_window_group(
            [window],
            saved_windows,
            events,
            min(deadline, time.monotonic() + 8.0),
            staging_token=staging_token,
        )
        if str(window.get("id", "")) not in terminal_ready:
            # ACK may have committed already; cancellation deliberately only
            # removes a still-pending claim and never closes the new window.
            cancel_terminal_binding(token)

    if application_targets:
        wait_for_window_group(
            application_targets,
            saved_windows,
            events,
            min(deadline, time.monotonic() + 8.0),
            staging_token=staging_token,
        )
        # Native browser session restore can emit the remaining windows just
        # after its representative surface maps. Give it one short grace period
        # before the cardinality repair creates blank replacement windows.
        singleton_groups = {
            str(window.get("launch_group", ""))
            for window in application_targets
            if single_instance_class_key(window)
            and str(window.get("launch_group", ""))
        }
        singleton_targets = [
            window
            for window in saved_windows
            if str(window.get("launch_group", "")) in singleton_groups
        ]
        if len(singleton_targets) > len(application_targets):
            wait_for_window_group(
                singleton_targets,
                saved_windows,
                events,
                min(
                    deadline,
                    time.monotonic()
                    + SINGLE_INSTANCE_NATIVE_RESTORE_GRACE_SECONDS,
                ),
                staging_token=staging_token,
            )
        if spawned_addresses is not None and preexisting_addresses is not None:
            try:
                post_launch_state = capture_snapshot(
                    runtime=True, staging_token=staging_token
                )
                post_launch_matches = match_windows(
                    saved_windows, list(post_launch_state.get("windows", []))
                )
                for saved_window in saved_windows:
                    saved_id = str(saved_window.get("id", ""))
                    group = str(saved_window.get("launch_group", ""))
                    if (
                        saved_id not in launched_application_ids
                        and group not in launched_application_groups
                    ):
                        continue
                    address = str(
                        (post_launch_matches.get(saved_id) or {}).get("address", "")
                    )
                    if (
                        re.fullmatch(r"0x[0-9A-Fa-f]+", address)
                        and address not in preexisting_addresses
                    ):
                        spawned_addresses.add(address)
            except (RuntimeError, OSError, ValueError, json.JSONDecodeError):
                pass
    return launched


def restore_snapshot(dry_run: bool = False, quiet: bool = False, signature_once: bool = False) -> dict[str, Any]:
    with StateLock():
        # Prefer the snapshot captured for the outputs that are actually
        # connected now.  Booting docked must not replay the undocked layout
        # and vice versa.  When no slot matches (first run after the upgrade,
        # or a topology never seen before) the newest snapshot is used exactly
        # as before, and translate_saved_hotplug_workspaces() below maps a
        # merged single-monitor capture back onto a returned output.
        restore_live_monitors = [
            item for item in hypr_json("monitors") if isinstance(item, dict)
        ]
        saved_state = None
        preferred_topology = live_topology_key(restore_live_monitors)
        if preferred_topology != "unknown":
            candidate = load_json(topology_slot_file(preferred_topology))
            if candidate and candidate.get("schema") == SCHEMA_VERSION:
                saved_state = candidate
        if not saved_state:
            saved_state = load_json(STATE_FILE)
        if not saved_state or saved_state.get("schema") != SCHEMA_VERSION:
            saved_state = load_json(BACKUP_FILE)
        if not saved_state or saved_state.get("schema") != SCHEMA_VERSION:
            return {"ok": True, "restored": False, "reason": "no-compatible-snapshot"}
        saved_state = normalize_snapshot_workspaces(saved_state)
        expected_hash = str(saved_state["content_hash"])
        signature = discover_signature()
        marker = load_json(MARKER_FILE)
        # signature_once is retained for CLI compatibility. A failed or
        # incomplete attempt is intentionally retryable in the same Hyprland
        # session; only a verified outcome for this exact snapshot is final.
        if (
            not dry_run
            and marker
            and marker.get("signature") == signature
            and marker.get("content_hash") == expected_hash
            and marker.get("complete") is True
        ):
            return {"ok": True, "restored": False, "reason": "already-restored"}

        saved_state = translate_saved_hotplug_workspaces(
            saved_state,
            load_hotplug_workspace_state(),
            restore_live_monitors,
        )

        current_state = capture_snapshot(runtime=True)
        saved_windows = list(saved_state.get("windows", []))
        matches = match_windows(saved_windows, current_state["windows"])
        fulfilled = fulfilled_windows(saved_windows, current_state["windows"])
        missing = [window for window in saved_windows if window.get("id") not in fulfilled]
        saved_foreground_workspaces = foreground_workspace_names(saved_state)
        saved_foreground_targets = foreground_monitor_targets(
            saved_state, saved_foreground_workspaces
        )
        reconciled_saved_targets, missing_live_monitors = reconcile_foreground_targets(
            saved_foreground_targets,
            list(current_state.get("monitor_workspaces", [])),
        )
        # The live compositor, not the saved focus, owns the login foreground.
        # This guarantees that restore cannot visibly tour old workspaces.
        foreground_targets = (
            live_foreground_targets(current_state) or reconciled_saved_targets
        )
        foreground_workspaces = (
            {
                str(item.get("workspace", ""))
                for item in foreground_targets
                if valid_workspace_name(item.get("workspace"))
            }
            or saved_foreground_workspaces
        )
        foreground_windows, deferred_windows = partition_windows_by_workspace(
            saved_windows, foreground_workspaces
        )
        fulfilled_singleton_groups = {
            str(window.get("launch_group", ""))
            for window in saved_windows
            if str(window.get("id", "")) in fulfilled
            and single_instance_class_key(window)
            and str(window.get("launch_group", ""))
        }
        launch_plan = build_launch_plan(
            missing, foreground_workspaces, fulfilled_singleton_groups
        )
        foreground_launch_plan, deferred_launch_plan = partition_windows_by_workspace(
            launch_plan, foreground_workspaces
        )

        if dry_run:
            return {
                "ok": True,
                "dry_run": True,
                "saved_windows": len(saved_windows),
                "matched_windows": len(matches),
                "fulfilled_windows": len(fulfilled),
                "launches": len(launch_plan),
                "foreground_workspaces": sorted(foreground_workspaces),
                "foreground_targets": foreground_targets,
                "missing_live_monitors": sorted(missing_live_monitors),
                "foreground_launches": len(foreground_launch_plan),
                "deferred_launches": len(deferred_launch_plan),
                "unresolved": len(saved_windows) - len(fulfilled),
            }

        fallback_workspace = next(
            (
                str(item.get("workspace", ""))
                for item in foreground_targets
                if item.get("focused") and valid_workspace_name(item.get("workspace"))
            ),
            sorted(foreground_workspaces)[0],
        )
        same_target = bool(
            marker
            and marker.get("signature") == signature
            and marker.get("content_hash") == expected_hash
        )
        try:
            previous_attempt = int(marker.get("attempt", 0) or 0) if same_target else 0
        except (TypeError, ValueError):
            previous_attempt = 0
        try:
            lease = RestoreLease.acquire_locked(
                operation="restore",
                signature=signature,
                content_hash=expected_hash,
                phase="planning",
                attempt=previous_attempt + 1,
            )
        except RestoreBusy as error:
            return {
                "ok": True,
                "restored": False,
                "reason": "restore-active",
                "detail": str(error),
                "retry_after": 5,
            }
        events: socket.socket | None = None
        compositor_guard: dict[str, Any] | None = None
        desktop_revealed = False
        launched = 0
        attempted_terminal_ids: set[str] = set()
        restore_spawned_addresses: set[str] = set()
        restore_deadline = time.monotonic() + 45
        try:
            lease.renew_locked(
                "orphan-staging-cleanup", mutation_started=True
            )
            orphan_cleanup = drain_restore_staging_clients(
                None, fallback_workspace, quiet=quiet
            )
            if not orphan_cleanup.get("ok"):
                raise RuntimeError(
                    "orphan restore staging evacuation incomplete: "
                    f"{orphan_cleanup.get('remaining', -1)} client(s) remain"
                )
            lease.renew_locked(
                "compositor-guard",
                mutation_started=True,
                watchdog_deadline_at=time.time() + 70.0,
            )
            compositor_guard = begin_restore_compositor_guard(fallback_workspace)
            staging_token = str(compositor_guard.get("staging_token", ""))
            events = connect_event_socket()
            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])

            # Phase A: launch all visible-workspace applications together.
            # Serial eight-second waits made startup latency grow with every
            # terminal; a single coalesced readiness wait has a fixed bound.
            lease.renew_locked("launching-foreground", mutation_started=True)
            launched += launch_window_group(
                foreground_launch_plan,
                saved_windows,
                fulfilled,
                attempted_terminal_ids,
                events,
                restore_deadline,
                quiet,
                staging_token=staging_token,
                spawned_addresses=restore_spawned_addresses,
            )
            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])
            foreground_fallback = fallback_launch_plan(
                foreground_windows, fulfilled, attempted_terminal_ids
            )
            launched += launch_window_group(
                foreground_fallback,
                saved_windows,
                fulfilled,
                attempted_terminal_ids,
                events,
                min(restore_deadline, time.monotonic() + 5.0),
                quiet,
                staging_token=staging_token,
                spawned_addresses=restore_spawned_addresses,
            )

            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            matches = match_windows(saved_windows, current_state["windows"])
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])
            placements = 0
            for saved_window in foreground_windows:
                current_window = matches.get(str(saved_window.get("id")))
                if current_window:
                    placements += place_window(saved_window, current_window, quiet=quiet)

            # Recapture after placement.  The foreground workspace and focus
            # are pinned to the live login baseline; only its already-visible
            # tiled topology may be committed here.  Other workspaces never
            # become active as part of restore.
            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            matches = match_windows(saved_windows, current_state["windows"])
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])
            foreground_topology_expressions = tiled_topology_swap_expressions(
                foreground_windows, current_state["windows"], matches
            )
            reveal_expressions = list(foreground_topology_expressions)

            # Finish the guard even when no topology operation is necessary.
            # This transaction never dispatches monitor/workspace/window focus.
            lease.renew_locked("revealing-foreground", mutation_started=True)
            lease.ensure_ui_active_locked()
            reveal_committed, transaction_ok = commit_restore_reveal(
                reveal_expressions, compositor_guard, quiet=quiet
            )
            placements += reveal_committed
            desktop_revealed = transaction_ok
            if not transaction_ok:
                raise RuntimeError("foreground reveal transaction failed")

            expected_window_address = str(
                (compositor_guard or {}).get("focused_window", "")
            )

            def capture_focus_postcondition() -> dict[str, Any]:
                try:
                    monitors = [
                        item
                        for item in hypr_json("monitors")
                        if isinstance(item, dict)
                    ]
                    active_window = hypr_json("activewindow")
                except (RuntimeError, ValueError, json.JSONDecodeError) as error:
                    return {"ok": False, "errors": [str(error)]}
                return verify_foreground_focus(
                    foreground_targets,
                    monitors,
                    active_window if isinstance(active_window, dict) else {},
                    expected_window_address,
                )

            reveal_focus_result = capture_focus_postcondition()
            reveal_focus_verified = bool(reveal_focus_result["ok"])
            focus_verification_errors = list(reveal_focus_result["errors"])

            # Phase B: the user keeps the stable foreground while all other
            # workspaces launch and arrange silently. No operation below may
            # focus a workspace or window.
            lease.renew_locked("launching-background", mutation_started=True)
            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])
            launched += launch_window_group(
                deferred_launch_plan,
                saved_windows,
                fulfilled,
                attempted_terminal_ids,
                events,
                restore_deadline,
                quiet,
                staging_token=staging_token,
                spawned_addresses=restore_spawned_addresses,
            )
            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])
            deferred_fallback = fallback_launch_plan(
                deferred_windows, fulfilled, attempted_terminal_ids
            )
            launched += launch_window_group(
                deferred_fallback,
                saved_windows,
                fulfilled,
                attempted_terminal_ids,
                events,
                min(restore_deadline, time.monotonic() + 5.0),
                quiet,
                staging_token=staging_token,
                spawned_addresses=restore_spawned_addresses,
            )

            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            matches = match_windows(saved_windows, current_state["windows"])
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])
            deferred_workspace_names = {
                str(item.get("name", ""))
                for item in saved_state.get("workspaces", [])
                if isinstance(item, dict)
                and valid_workspace_name(item.get("name"))
                and str(item.get("name")) not in foreground_workspaces
            }
            deferred_workspace_names.update(
                str((item.get("workspace") or {}).get("name", ""))
                for item in deferred_windows
                if valid_workspace_name((item.get("workspace") or {}).get("name"))
            )
            protected_background_workspaces = active_workspace_names(current_state)
            for saved_window in deferred_windows:
                current_window = matches.get(str(saved_window.get("id")))
                current_address = str((current_window or {}).get("address", ""))
                spawned_by_restore = current_address in restore_spawned_addresses
                # A user may switch workspaces while deferred applications are
                # launching. Never move, resize, or swap the workspace they
                # are now looking at; final verification records a retryable
                # incomplete restore instead of pulling focus back from them.
                if not spawned_by_restore and not background_mutation_allowed(
                    saved_window, current_window, protected_background_workspaces
                ):
                    continue
                assert current_window is not None
                # Pinning makes an inactive window appear on the foreground.
                # Defer either pin transition instead of changing visible
                # content behind the user's back.
                if bool(saved_window.get("pinned", False)) or bool(
                    current_window.get("pinned", False)
                ):
                    continue
                if spawned_by_restore:
                    # Remote-controlled browsers may map a new window on the
                    # foreground despite a silent exec rule. Only addresses
                    # proven absent before our launch receive this exception.
                    placements += place_window(
                        saved_window, current_window, quiet=quiet
                    )
                else:
                    placements += place_window_if_inactive(
                        saved_window, current_window, quiet=quiet
                    )

            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            matches = match_windows(saved_windows, current_state["windows"])
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])
            protected_background_workspaces.update(active_workspace_names(current_state))
            safe_deferred_workspace_names = (
                deferred_workspace_names - protected_background_workspaces
            )
            safe_deferred_windows = [
                item
                for item in deferred_windows
                if str((item.get("workspace") or {}).get("name", ""))
                in safe_deferred_workspace_names
            ]
            background_expressions = workspace_monitor_expressions(
                saved_state,
                current_state,
                quiet=quiet,
                workspace_names=safe_deferred_workspace_names,
            )
            background_topology_expressions = tiled_topology_swap_expressions(
                safe_deferred_windows, current_state["windows"], matches
            )
            background_expressions.extend(background_topology_expressions)
            live_workspace_names = {
                str(item.get("name", ""))
                for item in current_state.get("workspaces", [])
                if isinstance(item, dict)
                and valid_workspace_name(item.get("name"))
            }
            background_guard_routes = [
                {"workspace": name}
                for name in sorted(
                    safe_deferred_workspace_names & live_workspace_names
                )
            ]
            background_committed = commit_guarded_workspace_transaction(
                background_expressions,
                background_guard_routes,
                quiet=quiet,
            )
            placements += background_committed
            background_transaction_ok = (
                not background_expressions
                or background_committed == len(background_expressions)
            )
            if not background_transaction_ok:
                focus_verification_errors.append(
                    "background workspace transaction failed"
                )
            topology_expressions = (
                foreground_topology_expressions + background_topology_expressions
            )
            current_state = capture_snapshot(
                runtime=True, staging_token=staging_token
            )
            matches = match_windows(saved_windows, current_state["windows"])
            surplus_addresses = restore_spawned_singleton_surplus(
                saved_windows,
                list(current_state.get("windows", [])),
                matches,
                restore_spawned_addresses,
            )
            pruned_surplus = close_restore_spawned_surplus(
                surplus_addresses, quiet=quiet
            )
            if pruned_surplus:
                wait_for_closed_addresses(
                    surplus_addresses[:pruned_surplus], events, timeout=2.0
                )
                current_state = capture_snapshot(
                    runtime=True, staging_token=staging_token
                )
                matches = match_windows(saved_windows, current_state["windows"])
            fulfilled = fulfilled_windows(saved_windows, current_state["windows"])

            final_focus_result = capture_focus_postcondition()
            final_focus_verified = bool(final_focus_result["ok"])
            focus_verification_errors.extend(final_focus_result["errors"])
            focus_verified = reveal_focus_verified and final_focus_verified
            placement_result = verify_placement_invariant(
                saved_windows,
                list(current_state.get("windows", [])),
                matches,
                saved_state,
                current_state,
                pinned_workspace_monitors={
                    str(item.get("workspace", "")): str(item.get("monitor", ""))
                    for item in foreground_targets
                    if valid_workspace_name(item.get("workspace"))
                    and str(item.get("monitor", ""))
                },
            )
            placement_ordering_only = bool(placement_result.get("ordering_only"))
            # A pure ordering difference leaves every window present, on its
            # saved workspace and monitor, with focus where it belongs.
            # Treating that as a failed restore froze the snapshot, so nothing
            # the user did afterwards was ever recorded.
            placement_verified = bool(
                placement_result["ok"] or placement_ordering_only
            )

            guard_restored = end_restore_compositor_guard(
                compositor_guard,
                fallback_workspace,
                reveal_fallback=False,
                quiet=quiet,
            )
            if guard_restored:
                compositor_guard = None
            else:
                focus_verification_errors.append(
                    "compositor lifecycle options were not restored"
                )
            unresolved = len(saved_windows) - len(fulfilled)
            # A monitor that is not connected is a different topology, not a
            # failed restore.  Everything that could be placed was placed and
            # verified, so the outcome is complete for the outputs that exist;
            # the absent ones stay recorded in missing_live_monitors.
            restore_complete = (
                unresolved == 0
                and transaction_ok
                and background_transaction_ok
                and focus_verified
                and placement_verified
                and guard_restored
            )
            marker_value: dict[str, Any] = {
                "schema": SCHEMA_VERSION,
                "signature": signature,
                "content_hash": expected_hash,
                "complete": restore_complete,
                "unresolved": unresolved,
                "transaction_ok": transaction_ok,
                "background_transaction_ok": background_transaction_ok,
                "foreground_revealed": desktop_revealed,
                "foreground_workspaces": sorted(foreground_workspaces),
                "foreground_windows": len(foreground_windows),
                "deferred_windows": len(deferred_windows),
                "pruned_surplus": pruned_surplus,
                "topology_swaps": len(topology_expressions),
                "missing_live_monitors": sorted(missing_live_monitors),
                "topology": live_topology_key(restore_live_monitors),
                "reveal_focus_verified": reveal_focus_verified,
                "focus_verified": focus_verified,
                "placement_verified": placement_verified,
                "guard_restored": guard_restored,
                "restored_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            }
            if focus_verification_errors:
                marker_value["focus_verification_error"] = "; ".join(
                    focus_verification_errors
                )[:1024]
            if placement_result["errors"]:
                marker_value["placement_verification_error"] = "; ".join(
                    placement_result["errors"]
                )[:2048]
                marker_value["placement_ordering_only"] = placement_ordering_only
            lease.write_terminal_locked(
                marker_value,
                complete=restore_complete,
                protect_snapshot=not restore_complete,
            )
            return {
                "ok": restore_complete,
                "restored": True,
                "saved_windows": len(saved_windows),
                "matched_windows": len(matches),
                "fulfilled_windows": len(fulfilled),
                "launched": launched,
                "placements": placements,
                "pruned_surplus": pruned_surplus,
                "unresolved": unresolved,
                "transaction_ok": transaction_ok,
                "background_transaction_ok": background_transaction_ok,
                "foreground_revealed": desktop_revealed,
                "topology_swaps": len(topology_expressions),
                "missing_live_monitors": sorted(missing_live_monitors),
                "reveal_focus_verified": reveal_focus_verified,
                "focus_verified": focus_verified,
                "placement_verified": placement_verified,
                "placement_errors": list(placement_result["errors"]),
                "guard_restored": guard_restored,
            }
        except Exception as error:
            try:
                lease.write_terminal_locked(
                    {
                        "schema": SCHEMA_VERSION,
                        "unresolved": -1,
                        "restore_error": str(error)[:512],
                        "restored_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                    },
                    complete=False,
                    protect_snapshot=True,
                )
            except RestoreLeaseLost:
                pass
            raise
        finally:
            try:
                if events is not None:
                    events.close()
                fallback_guard_restored = end_restore_compositor_guard(
                    compositor_guard,
                    fallback_workspace,
                    reveal_fallback=not desktop_revealed,
                    quiet=quiet,
                )
                if not fallback_guard_restored and not quiet:
                    eprint("session restore failed to restore compositor lifecycle guard")
            finally:
                try:
                    lease.release_locked()
                except (OSError, RestoreLeaseLost) as error:
                    if not quiet:
                        eprint(f"session restore lease cleanup failed: {error}")


def handle_stop(_signum: int, _frame: Any) -> None:
    global _stop_requested, _stop_wakeup
    _stop_requested = True
    # select() normally sleeps until the next event or five-minute safety
    # checkpoint.  Wake it explicitly so shutdown stays immediate without an
    # artificial periodic timeout.
    if _stop_wakeup is not None:
        try:
            _stop_wakeup.send(b"\0")
        except (BlockingIOError, OSError):
            pass


def _daemon_connection_loop(quiet: bool = False) -> int:
    global _stop_requested, _stop_wakeup
    wake_read, wake_write = socket.socketpair()
    wake_read.setblocking(False)
    wake_write.setblocking(False)
    _stop_wakeup = wake_write
    signal.signal(signal.SIGTERM, handle_stop)
    signal.signal(signal.SIGINT, handle_stop)
    events = None
    deadline = time.monotonic() + 30
    while events is None and time.monotonic() < deadline and not _stop_requested:
        events = connect_event_socket()
        if events is None:
            select.select([wake_read], [], [], 1.0)
    if events is None:
        _stop_wakeup = None
        wake_read.close()
        wake_write.close()
        if _stop_requested:
            return 0
        eprint("Hyprland event socket is unavailable")
        return 1

    hotplug_pending = False
    hotplug_due: float | None = None
    hotplug_retries = 0
    hotplug_ui_gate_active = False
    hotplug_speculative = False
    hotplug_probe_signature: tuple[str, str] | None = None
    last_physical_signature: tuple[str, str] | None = None
    last_physical_time = float("-inf")
    initial_save: dict[str, Any] = {}
    # A daemon-only restart can discover a recoverable WAL immediately. Gate
    # before the first planner/commit call; owner-separated shell gates make
    # this safe even while the login restorer owns its own lifecycle.
    hotplug_ui_gate_active = set_hotplug_ui_gate(hotplug_ui_gate_active, True)
    try:
        initial_route = route_hotplug_workspaces(quiet=True)
    except Exception as error:
        eprint(f"initial hotplug workspace routing failed: {error}")
        hotplug_pending = True
        hotplug_due = time.monotonic() + 1.0
        initial_save = {
            "reason": "hotplug-settling",
            "retry_after": 5,
        }
    else:
        publish_hotplug_route_result(initial_route)
        initial_followup = hotplug_route_followup(initial_route, hotplug_retries)
        hotplug_pending = bool(initial_followup["pending"])
        hotplug_retries = int(initial_followup["retries"])
        if hotplug_pending:
            hotplug_due = time.monotonic() + float(initial_followup["delay"])
        if hotplug_pending:
            initial_save = {
                "reason": "hotplug-settling",
                "retry_after": 5,
            }
        else:
            hotplug_ui_gate_active = set_hotplug_ui_gate(
                hotplug_ui_gate_active, False
            )
            try:
                initial_save = save_snapshot(quiet=True, reason="daemon-start")
            except Exception as error:
                eprint(f"initial session checkpoint failed: {error}")

    last_save = time.monotonic()
    retry_after = int(initial_save.get("retry_after", 0)) if isinstance(initial_save, dict) else 0
    next_safety = last_save + (min(30, max(5, retry_after)) if retry_after else SAFETY_INTERVAL)
    dirty_since: float | None = None
    due: float | None = None
    title_only_dirty = False
    reconcile_backoff = 30.0
    last_refusal: str | None = None
    next_reconcile_allowed = next_safety if retry_after else 0.0
    buffer = b""
    socket_alive = True

    try:
        while not _stop_requested:
            now = time.monotonic()
            current_interval = TITLE_SAVE_INTERVAL if title_only_dirty else MIN_SAVE_INTERVAL
            # Park ordinary checkpoints while a hotplug route is fenced. An
            # expired `due` in the select target otherwise creates a 100% CPU
            # zero-timeout loop; it is intentionally retained and runs as
            # soon as routing completes.
            targets = daemon_wait_targets(
                next_safety,
                due,
                hotplug_due,
                hotplug_pending,
                last_save,
                current_interval,
                next_reconcile_allowed,
            )
            # Block until the exact next deadline.  The self-pipe above wakes
            # this select immediately for SIGTERM/SIGINT, so idle operation
            # has no five-second polling wakeup.
            timeout = max(0.0, min(targets) - now)
            ready, _, _ = select.select([events, wake_read], [], [], timeout)
            if wake_read in ready:
                try:
                    while wake_read.recv(4096):
                        pass
                except (BlockingIOError, OSError):
                    pass
            if events in ready:
                try:
                    data = events.recv(65536)
                except BlockingIOError:
                    continue
                except OSError:
                    socket_alive = False
                    break
                if not data:
                    socket_alive = False
                    break
                buffer += data
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    event_parts = line.split(b">>", 1)
                    event_name = event_parts[0].decode("ascii", "ignore")
                    event_data = (
                        event_parts[1].decode("utf-8", "replace")
                        if len(event_parts) > 1
                        else ""
                    )
                    if event_name in RELEVANT_EVENTS:
                        event_time = time.monotonic()
                        hotplug_action = hotplug_route_event_action(
                            event_name, hotplug_pending
                        )
                        if hotplug_action == "schedule":
                            was_pending = hotplug_pending
                            physical_signature = hotplug_event_signature(
                                event_name, event_data
                            )
                            physical_duplicate = duplicate_hotplug_event(
                                physical_signature,
                                last_physical_signature,
                                event_time,
                                last_physical_time,
                                hotplug_pending,
                            )
                            hotplug_pending = True
                            if physical_signature is not None and not physical_duplicate:
                                # Route after this recv buffer is parsed, in the
                                # same event-loop turn as the cable event.
                                hotplug_due = schedule_hotplug_deadline(
                                    hotplug_due, event_time, immediate=True
                                )
                                hotplug_speculative = True
                                hotplug_probe_signature = physical_signature
                                hotplug_retries = 0
                                last_physical_signature = physical_signature
                                last_physical_time = event_time
                                hotplug_ui_gate_active = set_hotplug_ui_gate(
                                    hotplug_ui_gate_active, True
                                )
                            elif physical_signature is None:
                                hotplug_due = schedule_hotplug_deadline(
                                    hotplug_due, event_time, immediate=False
                                )
                                if not was_pending:
                                    hotplug_retries = 0
                        if event_name == "openwindow":
                            reconcile_backoff = 10.0
                            next_reconcile_allowed = event_time
                        if dirty_since is None:
                            dirty_since = event_time
                            title_only_dirty = event_name in {"windowtitlev2", "activewindowv2"}
                        elif event_name not in {"windowtitlev2", "activewindowv2"}:
                            title_only_dirty = False
                        due = min(event_time + DEBOUNCE_SECONDS, dirty_since + MAX_DEBOUNCE_SECONDS)

            if _stop_requested:
                break
            now = time.monotonic()
            if hotplug_due is not None and now >= hotplug_due:
                hotplug_due = None
                speculative_attempt = hotplug_speculative
                hotplug_speculative = False
                speculative_signature = hotplug_probe_signature
                # Non-monitor events can unblock a prepared mapping.  Acquire
                # at the mutation boundary without nesting a gate already held
                # since the physical hotplug event.
                if not hotplug_ui_gate_active:
                    hotplug_ui_gate_active = set_hotplug_ui_gate(
                        hotplug_ui_gate_active, True
                    )
                try:
                    hotplug_result = route_hotplug_workspaces(
                        quiet=True,
                        expected_hotplug=speculative_signature,
                    )
                except Exception as error:
                    eprint(f"hotplug workspace routing failed: {error}")
                    hotplug_result = {
                        "ok": False,
                        "deferred": [],
                        "retry_after": 1,
                    }
                publish_hotplug_route_result(hotplug_result)
                probe_resolved = bool(
                    hotplug_probe_signature is not None
                    and hotplug_result.get("expected_hotplug_ready", False)
                )
                hotplug_probe_signature = retain_hotplug_probe(
                    hotplug_probe_signature, hotplug_result
                )
                followup = hotplug_route_followup(
                    hotplug_result,
                    0 if probe_resolved else hotplug_retries,
                    speculative=speculative_attempt,
                )
                hotplug_pending = bool(followup["pending"])
                hotplug_retries = int(followup["retries"])
                if hotplug_pending:
                    hotplug_due = time.monotonic() + float(followup["delay"])
                if not hotplug_pending:
                    hotplug_ui_gate_active = set_hotplug_ui_gate(
                        hotplug_ui_gate_active, False
                    )
                now = time.monotonic()
            checkpoint_attempted = False
            minimum_interval = TITLE_SAVE_INTERVAL if title_only_dirty else MIN_SAVE_INTERVAL
            if (
                due is not None
                and now >= due
                and now - last_save >= minimum_interval
                and now >= next_reconcile_allowed
                and not hotplug_pending
            ):
                checkpoint_attempted = True
                try:
                    outcome = save_snapshot(quiet=True, reason="hyprland-event")
                except Exception as error:
                    eprint(f"session checkpoint failed: {error}")
                    next_reconcile_allowed = time.monotonic() + 10
                    due = next_reconcile_allowed
                    dirty_since = None
                    title_only_dirty = False
                else:
                    if outcome.get("reason") in {
                        "restore-settling",
                        "restore-incomplete",
                        "hotplug-settling",
                    }:
                        # Announce the first refusal of each kind. A silent
                        # backoff here meant a session could stop being saved
                        # for days with nothing in the journal to show for it.
                        if outcome.get("reason") != last_refusal:
                            last_refusal = str(outcome.get("reason"))
                            eprint(
                                f"session checkpoint refused: {last_refusal}"
                                f" (missing={outcome.get('missing', 0)});"
                                " backing off"
                            )
                        next_reconcile_allowed = time.monotonic() + reconcile_backoff
                        next_safety = next_reconcile_allowed
                        reconcile_backoff = min(300.0, reconcile_backoff * 2)
                        dirty_since = None
                        due = None
                        title_only_dirty = False
                    else:
                        if last_refusal is not None:
                            eprint(f"session checkpoint resumed after {last_refusal}")
                            last_refusal = None
                        last_save = time.monotonic()
                        next_safety = last_save + SAFETY_INTERVAL
                        reconcile_backoff = 30.0
                        next_reconcile_allowed = 0.0
                        dirty_since = None
                        due = None
                        title_only_dirty = False
                now = time.monotonic()
            if not checkpoint_attempted and now >= next_safety and hotplug_pending:
                # No polling repair: keep the last good snapshot until a
                # workspace/focus event makes the deferred route invisible.
                next_safety = now + SAFETY_INTERVAL
            elif not checkpoint_attempted and now >= next_safety:
                try:
                    outcome = save_snapshot(quiet=True, reason="safety-checkpoint")
                except Exception as error:
                    eprint(f"safety checkpoint failed: {error}")
                    next_reconcile_allowed = time.monotonic() + 10
                    next_safety = next_reconcile_allowed
                    dirty_since = None
                    due = None
                    title_only_dirty = False
                else:
                    if outcome.get("reason") in {
                        "restore-settling",
                        "restore-incomplete",
                        "hotplug-settling",
                    }:
                        # Announce the first refusal of each kind. A silent
                        # backoff here meant a session could stop being saved
                        # for days with nothing in the journal to show for it.
                        if outcome.get("reason") != last_refusal:
                            last_refusal = str(outcome.get("reason"))
                            eprint(
                                f"session checkpoint refused: {last_refusal}"
                                f" (missing={outcome.get('missing', 0)});"
                                " backing off"
                            )
                        next_reconcile_allowed = time.monotonic() + reconcile_backoff
                        next_safety = next_reconcile_allowed
                        reconcile_backoff = min(300.0, reconcile_backoff * 2)
                        dirty_since = None
                        due = None
                        title_only_dirty = False
                    else:
                        if last_refusal is not None:
                            eprint(f"session checkpoint resumed after {last_refusal}")
                            last_refusal = None
                        last_save = time.monotonic()
                        next_safety = last_save + SAFETY_INTERVAL
                        reconcile_backoff = 30.0
                        next_reconcile_allowed = 0.0
                        dirty_since = None
                        due = None
                        title_only_dirty = False
    finally:
        hotplug_ui_gate_active = set_hotplug_ui_gate(
            hotplug_ui_gate_active, False
        )
        events.close()
        _stop_wakeup = None
        wake_read.close()
        wake_write.close()

    # SIGTERM arrives while the compositor is still queryable.  Socket EOF means
    # Hyprland is already tearing windows down, so retain the last good snapshot.
    if _stop_requested and socket_alive and not hotplug_pending:
        try:
            save_snapshot(quiet=True, reason="service-stop")
        except Exception:
            pass
    return 0 if _stop_requested or socket_alive else 1


def daemon(quiet: bool = False) -> int:
    """Keep the autosaver attached across Hyprland event-socket restarts."""
    global _stop_requested
    _stop_requested = False
    while not _stop_requested:
        result = _daemon_connection_loop(quiet=quiet)
        if result == 0 or _stop_requested:
            return 0 if _stop_requested else result

        # A compositor restart (and, defensively, a reset event socket) must
        # not make systemd tear down and recreate this service.  Keep the
        # delay short so the next socket is observed promptly, but avoid a
        # tight loop if a stale socket accepts and immediately closes.
        time.sleep(0.25)
    return 0


def login(quiet: bool = False) -> int:
    # restore_snapshot is the sole lifecycle owner. Login must never publish
    # or remove a second flag around it, because a stale outer finally could
    # otherwise delete a newer restore token.
    deadline = time.monotonic() + 12
    while event_socket_path() is None and time.monotonic() < deadline:
        time.sleep(0.25)
    time.sleep(1.25)
    try:
        result = restore_snapshot(quiet=quiet, signature_once=True)
        if not quiet:
            print(json.dumps(result, ensure_ascii=False))
    except Exception as error:
        # The owned restore path has already committed an incomplete marker
        # before releasing its token, so login only reports the failure.
        eprint(f"session restore failed: {error}")
    env_names = [name for name in ("HYPRLAND_INSTANCE_SIGNATURE", "WAYLAND_DISPLAY", "XDG_CURRENT_DESKTOP", "XDG_SESSION_DESKTOP") if os.environ.get(name)]
    if env_names:
        subprocess.run(["systemctl", "--user", "import-environment", *env_names], check=False, timeout=5)
    active = subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", "hypr-session-autosave.service"],
        check=False,
        timeout=5,
    )
    if active.returncode != 0:
        subprocess.run(["systemctl", "--user", "start", "hypr-session-autosave.service"], check=False, timeout=8)
    return 0


def status() -> dict[str, Any]:
    raw_snapshot = load_json(STATE_FILE)
    snapshot = (
        normalize_snapshot_workspaces(raw_snapshot) if raw_snapshot else None
    )
    marker = load_json(MARKER_FILE)
    service = subprocess.run(
        ["systemctl", "--user", "is-active", "hypr-session-autosave.service"],
        text=True,
        capture_output=True,
        check=False,
        timeout=5,
    )
    return {
        "snapshot": str(STATE_FILE),
        "exists": bool(snapshot),
        "captured_at": snapshot.get("captured_at") if snapshot else None,
        "windows": len(snapshot.get("windows", [])) if snapshot else 0,
        "content_hash": snapshot.get("content_hash") if snapshot else None,
        "service": service.stdout.strip() or "unknown",
        "restored_for_current_hyprland": bool(
            marker
            and snapshot
            and marker.get("signature") == discover_signature()
            and marker.get("content_hash") == snapshot.get("content_hash")
        ),
        "restore_complete": marker.get("complete") if marker else None,
        "unresolved_after_restore": marker.get("unresolved") if marker else None,
    }


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    save_parser = subparsers.add_parser("save", help="save the current mapped application windows")
    save_parser.add_argument("--force", action="store_true")
    save_parser.add_argument("--quiet", action="store_true")
    restore_parser = subparsers.add_parser("restore", help="restore the last saved application session")
    restore_parser.add_argument("--dry-run", action="store_true")
    restore_parser.add_argument("--quiet", action="store_true")
    repair_parser = subparsers.add_parser(
        "repair-workspaces",
        help="repair polluted workspace IDs after resume without restarting applications",
    )
    repair_parser.add_argument("--dry-run", action="store_true")
    repair_parser.add_argument("--quiet", action="store_true")
    daemon_parser = subparsers.add_parser("daemon", help="listen for Hyprland events and checkpoint lazily")
    daemon_parser.add_argument("--quiet", action="store_true")
    login_parser = subparsers.add_parser("login", help="one-shot login restore, then start the saver")
    login_parser.add_argument("--quiet", action="store_true")
    terminal_ack_parser = subparsers.add_parser(
        "terminal-bind-ack", help=argparse.SUPPRESS
    )
    terminal_ack_parser.add_argument("token")
    subparsers.add_parser("status", help="show snapshot and service status")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        if args.command == "save":
            save_snapshot(force=args.force, quiet=args.quiet)
            return 0
        if args.command == "restore":
            result = restore_snapshot(dry_run=args.dry_run, quiet=args.quiet)
            if not args.quiet:
                print(json.dumps(result, ensure_ascii=False))
            return 0 if result.get("ok") else 1
        if args.command == "repair-workspaces":
            result = repair_workspaces(dry_run=args.dry_run, quiet=args.quiet)
            return 0 if result.get("ok") else 1
        if args.command == "daemon":
            return daemon(quiet=args.quiet)
        if args.command == "login":
            return login(quiet=args.quiet)
        if args.command == "terminal-bind-ack":
            result = terminal_bind_ack(args.token, execute=True)
            # This ACK is the only accepted proof of shell->window identity, and
            # it runs inside a Fish process whose stderr nobody reads. When it
            # fails the terminal silently degrades to a bare shell and the
            # restore stalls the full per-terminal timeout, with nothing
            # anywhere to say why. Put the outcome in the journal.
            journal_note(
                "terminal-bind-ack "
                + ("ok" if result.get("ok") else f"rejected: {result.get('reason', 'unknown')}")
            )
            if not result.get("ok"):
                eprint(f"terminal binding rejected: {result.get('reason', 'unknown')}")
                return 1
            return 0
        if args.command == "status":
            print(json.dumps(status(), ensure_ascii=False, indent=2))
            return 0
    except (RuntimeError, OSError, ValueError, json.JSONDecodeError) as error:
        eprint(f"hypr-session-state: {error}")
        return 1
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

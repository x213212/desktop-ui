def host_connector_setting(key: str) -> str:
    """Read one validated connector name without evaluating a shell file."""
    value = os.environ.get(key, "").strip()
    if not value:
        try:
            text = HOST_SETTINGS_FILE.read_text(encoding="utf-8")
        except OSError:
            text = ""
        for line in text.splitlines():
            name, separator, candidate = line.partition("=")
            if separator and name.strip() == key:
                value = candidate.strip().strip("\"'")
                break
    return value if re.fullmatch(r"[A-Za-z0-9_.:-]+", value) else ""


ROLE_CONNECTORS: dict[int, str] = {}
for _role in range(MAX_MONITOR_GROUPS):
    _connector = host_connector_setting(f"UIOS_MONITOR_ROLE_{_role}")
    if _connector and _connector not in ROLE_CONNECTORS.values():
        ROLE_CONNECTORS[_role] = _connector

HOST_CONNECTOR = ROLE_CONNECTORS.get(0, "")

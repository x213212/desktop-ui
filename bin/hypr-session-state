# Hyprland special workspaces use negative IDs (-99..-2). Some IPC/Lua paths
# have exposed those as values just below INT32_MAX (for example 2147483644).
# Reject that reserved-looking range globally. When a live monitor ID is
# available, valid_workspace_name() additionally enforces its 10-workspace
# routing group so scale/hotplug reloads cannot persist a cross-output leak.
SERIALIZED_SPECIAL_WORKSPACE_MIN = (1 << 31) - 100

[Unit]
Description=Secure hyprlock before sleep and repair workspaces after resume
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/secure-lock-before-sleep
Restart=always
RestartSec=2

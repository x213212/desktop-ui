[Unit]
Description=EasyEffects Lenovo Dolby processing (background, no GUI)
Documentation=https://github.com/wwmm/easyeffects
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=exec
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
Environment=GTK_MODULES=
ExecStartPre=-/usr/bin/flatpak kill com.github.wwmm.easyeffects
ExecStart=/usr/bin/flatpak run com.github.wwmm.easyeffects --service-mode --hide-window
ExecStop=-/usr/bin/flatpak kill com.github.wwmm.easyeffects
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

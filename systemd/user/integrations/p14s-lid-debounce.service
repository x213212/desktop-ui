[Unit]
Description=P14s event-driven debounced lid suspend
After=graphical-session.target secure-lock-before-sleep.service
Requires=secure-lock-before-sleep.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=handle-lid-switch --who=P14s-lid-debounce --why=Debounce-firmware-lid-signal --mode=block /usr/bin/python3 %h/.local/bin/p14s-lid-debounce
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
